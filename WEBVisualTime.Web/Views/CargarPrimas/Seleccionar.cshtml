@model WEBVisualTime.Web.Models.PrimaImportacionViewModel
@{ViewData["Title"]="Seleccionar roles y regionales";var rolesSeleccionados=Model.Plan?.Roles ?? new[] { 2, 21, 22, 23, 32, 67, 24 };}
<h1>Cargar Primas Por Producto</h1><p>@Model.Documento!.Archivo · @Model.Documento.Filas.Count filas válidas</p>
@if(TempData["PrimasError"] is string error){<div class="alert alert-danger" style="white-space:pre-wrap">@error</div>}
<form asp-action="Preparar" method="post" id="seleccion-primas">
<input type="hidden" name="id" value="@Model.Id" />
<section id="paso-roles"><h2 class="h4">2. Seleccionar roles</h2><p>Cada tarifa se replicará para cada rol seleccionado.</p>
@foreach(var r in Model.Catalogos!.Roles){<div class="form-check"><input class="form-check-input" type="checkbox" name="roles" id="rol-@r.Codigo" value="@r.Codigo" checked="@(rolesSeleccionados.Contains(r.Codigo))" /><label class="form-check-label" for="rol-@r.Codigo">@r.Codigo — @r.Nombre</label></div>}
<button class="btn btn-primary mt-3" type="button" id="siguiente-regionales">Continuar a regionales</button></section>
<section id="paso-regionales" hidden><h2 class="h4">3. Seleccionar regionales</h2>
@foreach(var r in Model.Catalogos.Regionales){<div class="form-check"><input class="form-check-input" type="checkbox" name="regionales" id="regional-@r.Codigo" value="@r.Codigo" checked="@(Model.Plan?.Regionales.Contains(r.Codigo)==true)" /><label class="form-check-label" for="regional-@r.Codigo">@r.Codigo — @r.Nombre</label></div>}
<label class="form-label mt-3" for="fechaEfecto">Fecha de efecto</label>
<input type="date" id="fechaEfecto" name="fechaEfecto" class="form-control" min="1900-01-01" max="2200-12-31" value="@((Model.Plan?.FechaEfecto ?? new DateTime(2024, 1, 1)).ToString("yyyy-MM-dd"))" required />
<p class="text-muted">Se aplica a todas las tarifas nuevas, reemplazando la fecha del Excel. También será la fecha de anulación de las tarifas anteriores de las mismas combinaciones, aunque sus rangos sean diferentes. Por ejemplo, 02/01/2026 significa 2 de enero de 2026.</p>
<label class="form-label mt-3" for="usuario">Código del usuario Oracle que declara esta carga (NUSERCODE)</label><input type="number" min="1" max="2147483647" name="usuario" id="usuario" class="form-control" value="@(Model.Plan?.Usuario ?? 1)" required />
<p class="text-muted">Se valida contra USERS. Este código declarado no sustituye el inicio de sesión.</p>
<p id="volumen" class="fw-bold" data-filas="@Model.Documento.Filas.Count"></p>
<button type="button" class="btn btn-outline-secondary" id="volver-roles">Volver a roles</button> <button class="btn btn-primary">Revisar datos limpios</button>
</section></form><script src="~/js/primas-seleccion.js" asp-append-version="true"></script>
