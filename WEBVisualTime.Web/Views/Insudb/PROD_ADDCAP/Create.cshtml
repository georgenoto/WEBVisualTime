@model WEBVisualTime.Servicios.Insudb.DTOs.PROD_ADDCAP.CreatePROD_ADDCAPDto

@{
    ViewData["Title"] = "Crear PROD_ADDCAP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NROLE" class="form-label"></label>
                <input asp-for="NROLE" class="form-control" type="number" />
                <span asp-validation-for="NROLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCAPITAL" class="form-label"></label>
                <input asp-for="NCAPITAL" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCAPITAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOVERADD" class="form-label"></label>
                <input asp-for="NCOVERADD" class="form-control" type="number" />
                <span asp-validation-for="NCOVERADD" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NROLEADD" class="form-label"></label>
                <input asp-for="NROLEADD" class="form-control" type="number" />
                <span asp-validation-for="NROLEADD" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYP_CUMUL" class="form-label"></label>
                <input asp-for="NTYP_CUMUL" class="form-control" type="number" />
                <span asp-validation-for="NTYP_CUMUL" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
