<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("MEDICALTEAMS_FEES", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
