@model WEBVisualTime.Servicios.Insudb.DTOs.FINANC_WIN.FINANC_WINDto

@{
    ViewData["Title"] = "Detalles de FINANC_WIN";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NCONTRAT</dt>
            <dd class="col-sm-9">@Model.NCONTRAT</dd>
            <dt class="col-sm-3">USERS</dt>
            <dd class="col-sm-9">@Model.USERSSACCESSWO</dd>
            <dt class="col-sm-3">SV_CONCONTR</dt>
            <dd class="col-sm-9">@Model.SV_CONCONTR</dd>
            <dt class="col-sm-3">SV_WINCONTR</dt>
            <dd class="col-sm-9">@Model.SV_WINCONTR</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NCONTRAT" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
