@model WEBVisualTime.Servicios.Insudb.DTOs.REPORTSHEET.REPORTSHEETDto

@{
    ViewData["Title"] = "Detalles de REPORTSHEET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SCODE_REPORT</dt>
            <dd class="col-sm-9">@Model.SCODE_REPORT</dd>
            <dt class="col-sm-3">NBOX</dt>
            <dd class="col-sm-9">@Model.NBOX</dd>
            <dt class="col-sm-3">NCOLUMN</dt>
            <dd class="col-sm-9">@Model.NCOLUMN</dd>
            <dt class="col-sm-3">NROW</dt>
            <dd class="col-sm-9">@Model.NROW</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">NTYP_SECTION</dt>
            <dd class="col-sm-9">@Model.NTYP_SECTION</dd>
            <dt class="col-sm-3">SCONTENT</dt>
            <dd class="col-sm-9">@Model.SCONTENT</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("REPORTSHEET", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
