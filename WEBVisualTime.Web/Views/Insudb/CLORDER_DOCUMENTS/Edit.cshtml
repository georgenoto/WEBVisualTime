@model WEBVisualTime.Servicios.Insudb.DTOs.CLORDER_DOCUMENTS.UpdateCLORDER_DOCUMENTSDto

@{
    ViewData["Title"] = "Editar CLORDER_DOCUMENTS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NCLAIM" />
            <input type="hidden" asp-for="NCASE_NUM" />
            <input type="hidden" asp-for="NDEMAN_TYPE" />
            <input type="hidden" asp-for="SCLIENT" />
            <input type="hidden" asp-for="NID" />
            <input type="hidden" asp-for="NDOC_CODE" />
            <input type="hidden" asp-for="NCONSEC" />
            <input type="hidden" asp-for="NORDER_NUM" />
            <input type="hidden" asp-for="NCONSEC_ORDERDOC" />
            <div class="mb-3">
                <label asp-for="NAPPLY" class="form-label"></label>
                <input asp-for="NAPPLY" class="form-control" type="number" />
                <span asp-validation-for="NAPPLY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
