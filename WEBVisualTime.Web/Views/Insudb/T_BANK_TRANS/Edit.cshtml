@model WEBVisualTime.Servicios.Insudb.DTOs.T_BANK_TRANS.UpdateT_BANK_TRANSDto

@{
    ViewData["Title"] = "Editar T_BANK_TRANS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBORDEREAUX" />
            <input type="hidden" asp-for="NSEQUENCE" />
            <div class="mb-3">
                <label asp-for="NACC_BANK" class="form-label"></label>
                <input asp-for="NACC_BANK" class="form-control" type="number" />
                <span asp-validation-for="NACC_BANK" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NACC_TYPE" class="form-label"></label>
                <input asp-for="NACC_TYPE" class="form-control" type="number" />
                <span asp-validation-for="NACC_TYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SACCO_NUM" class="form-label"></label>
                <input asp-for="SACCO_NUM" class="form-control" />
                <span asp-validation-for="SACCO_NUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBANK_CODE" class="form-label"></label>
                <input asp-for="NBANK_CODE" class="form-control" type="number" />
                <span asp-validation-for="NBANK_CODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBK_AGENCY" class="form-label"></label>
                <input asp-for="NBK_AGENCY" class="form-control" type="number" />
                <span asp-validation-for="NBK_AGENCY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <input asp-for="SCLIENT" class="form-control" />
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT" class="form-label"></label>
                <input asp-for="NMOVEMENT" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DEFFECDATE" class="form-label"></label>
                <input asp-for="DEFFECDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DEFFECDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NEXCHANGE" class="form-label"></label>
                <input asp-for="NEXCHANGE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NEXCHANGE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SACTION" class="form-label"></label>
                <input asp-for="SACTION" class="form-control" />
                <span asp-validation-for="SACTION" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
