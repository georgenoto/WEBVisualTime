@model WEBVisualTime.Servicios.Insudb.DTOs.T_BANK_TRANS.T_BANK_TRANSDto

@{
    ViewData["Title"] = "Eliminar T_BANK_TRANS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBORDEREAUX)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBORDEREAUX)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSEQUENCE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSEQUENCE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NACC_BANK)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NACC_BANK)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NACC_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NACC_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SACCO_NUM)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SACCO_NUM)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBANK_CODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBANK_CODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBK_AGENCY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBK_AGENCY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NMOVEMENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NMOVEMENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEFFECDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEFFECDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NEXCHANGE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NEXCHANGE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SACTION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SACTION)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NBORDEREAUX" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
