@model WEBVisualTime.Servicios.Insudb.DTOs.CONTR_CESCOV.UpdateCONTR_CESCOVDto

@{
    ViewData["Title"] = "Editar CONTR_CESCOV";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH_REI" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <input type="hidden" asp-for="NNUMBER" />
            <input type="hidden" asp-for="NTYPE" />
            <input type="hidden" asp-for="NINSUR_AREA" />
            <input type="hidden" asp-for="NCOVERGEN" />
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPECAP" class="form-label"></label>
                <select asp-for="NTYPECAP" class="form-select" asp-items="@(ViewData["NTYPECAP"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYPECAP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SROUCESS" class="form-label"></label>
                <input asp-for="SROUCESS" class="form-control" />
                <span asp-validation-for="SROUCESS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRATE" class="form-label"></label>
                <input asp-for="NRATE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NRATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCESSPRFIX" class="form-label"></label>
                <input asp-for="NCESSPRFIX" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCESSPRFIX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SINOTHERCOV" class="form-label"></label>
                <input asp-for="SINOTHERCOV" class="form-control" />
                <span asp-validation-for="SINOTHERCOV" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="NCOMPANY" />
            <div class="mb-3">
                <label asp-for="NCOVERGEN_OTHER" class="form-label"></label>
                <input asp-for="NCOVERGEN_OTHER" class="form-control" type="number" />
                <span asp-validation-for="NCOVERGEN_OTHER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSHARE_CIA" class="form-label"></label>
                <input asp-for="NSHARE_CIA" class="form-control" type="number" step="any" />
                <span asp-validation-for="NSHARE_CIA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAGEMAX" class="form-label"></label>
                <input asp-for="NAGEMAX" class="form-control" type="number" />
                <span asp-validation-for="NAGEMAX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRATE_EXPREM" class="form-label"></label>
                <input asp-for="NRATE_EXPREM" class="form-control" type="number" step="any" />
                <span asp-validation-for="NRATE_EXPREM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SMORTACOF" class="form-label"></label>
                <input asp-for="SMORTACOF" class="form-control" />
                <span asp-validation-for="SMORTACOF" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SMORTACOM" class="form-label"></label>
                <input asp-for="SMORTACOM" class="form-control" />
                <span asp-validation-for="SMORTACOM" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
