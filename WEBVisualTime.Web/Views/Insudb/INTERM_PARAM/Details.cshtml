@model WEBVisualTime.Servicios.Insudb.DTOs.INTERM_PARAM.INTERM_PARAMDto

@{
    ViewData["Title"] = "Detalles de INTERM_PARAM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NINSU_ASSIST</dt>
            <dd class="col-sm-9">@Model.NINSU_ASSIST</dd>
            <dt class="col-sm-3">NSOAP_AGENT</dt>
            <dd class="col-sm-9">@Model.NSOAP_AGENT</dd>
            <dt class="col-sm-3">NSOAP_SUPERVIS</dt>
            <dd class="col-sm-9">@Model.NSOAP_SUPERVIS</dd>
            <dt class="col-sm-3">NBONUS_CURR</dt>
            <dd class="col-sm-9">@Model.NBONUS_CURR</dd>
            <dt class="col-sm-3">NMAX_BONUS</dt>
            <dd class="col-sm-9">@Model.NMAX_BONUS</dd>
            <dt class="col-sm-3">NMAX_ACCOMP</dt>
            <dd class="col-sm-9">@Model.NMAX_ACCOMP</dd>
            <dt class="col-sm-3">NMINAMOUNT</dt>
            <dd class="col-sm-9">@Model.NMINAMOUNT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">NDAY_DISCLOAN</dt>
            <dd class="col-sm-9">@Model.NDAY_DISCLOAN</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NINSU_ASSIST" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
