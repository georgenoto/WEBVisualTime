@model WEBVisualTime.Servicios.Insudb.DTOs.INTERM_PARAM.INTERM_PARAMDto

@{
    ViewData["Title"] = "Eliminar INTERM_PARAM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINSU_ASSIST)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINSU_ASSIST)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSOAP_AGENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSOAP_AGENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSOAP_SUPERVIS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSOAP_SUPERVIS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBONUS_CURR)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBONUS_CURR)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NMAX_BONUS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NMAX_BONUS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NMAX_ACCOMP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NMAX_ACCOMP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NMINAMOUNT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NMINAMOUNT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDAY_DISCLOAN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDAY_DISCLOAN)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NINSU_ASSIST" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
