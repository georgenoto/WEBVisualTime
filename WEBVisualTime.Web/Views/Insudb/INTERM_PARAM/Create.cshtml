@model WEBVisualTime.Servicios.Insudb.DTOs.INTERM_PARAM.CreateINTERM_PARAMDto

@{
    ViewData["Title"] = "Crear INTERM_PARAM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NINSU_ASSIST" class="form-label"></label>
                <input asp-for="NINSU_ASSIST" class="form-control" type="number" step="any" />
                <span asp-validation-for="NINSU_ASSIST" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSOAP_AGENT" class="form-label"></label>
                <input asp-for="NSOAP_AGENT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NSOAP_AGENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSOAP_SUPERVIS" class="form-label"></label>
                <input asp-for="NSOAP_SUPERVIS" class="form-control" type="number" step="any" />
                <span asp-validation-for="NSOAP_SUPERVIS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBONUS_CURR" class="form-label"></label>
                <input asp-for="NBONUS_CURR" class="form-control" type="number" />
                <span asp-validation-for="NBONUS_CURR" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMAX_BONUS" class="form-label"></label>
                <input asp-for="NMAX_BONUS" class="form-control" type="number" step="any" />
                <span asp-validation-for="NMAX_BONUS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMAX_ACCOMP" class="form-label"></label>
                <input asp-for="NMAX_ACCOMP" class="form-control" type="number" step="any" />
                <span asp-validation-for="NMAX_ACCOMP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMINAMOUNT" class="form-label"></label>
                <input asp-for="NMINAMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NMINAMOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NDAY_DISCLOAN" class="form-label"></label>
                <input asp-for="NDAY_DISCLOAN" class="form-control" type="number" />
                <span asp-validation-for="NDAY_DISCLOAN" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
