@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_SYS_EXE.TAB_SYS_EXEDto

@{
    ViewData["Title"] = "Detalles de TAB_SYS_EXE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NEXE_CODE</dt>
            <dd class="col-sm-9">@Model.NEXE_CODE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">SEXE_NAME</dt>
            <dd class="col-sm-9">@Model.SEXE_NAME</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SFOLDERNAME</dt>
            <dd class="col-sm-9">@Model.SFOLDERNAME</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NEXE_CODE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
