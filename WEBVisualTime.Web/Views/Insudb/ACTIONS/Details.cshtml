@model WEBVisualTime.Servicios.Insudb.DTOs.ACTIONS.ACTIONSDto

@{
    ViewData["Title"] = "Detalles de ACTIONS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NACTION</dt>
            <dd class="col-sm-9">@Model.NACTION</dd>
            <dt class="col-sm-3">SCONTROLKEY</dt>
            <dd class="col-sm-9">@Model.SCONTROLKEY</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">SHEL_ACTIO</dt>
            <dd class="col-sm-9">@Model.SHEL_ACTIO</dd>
            <dt class="col-sm-3">SSHORT_ACTI</dt>
            <dd class="col-sm-9">@Model.SSHORT_ACTI</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
            <dt class="col-sm-3">STYPE_ACTIO</dt>
            <dd class="col-sm-9">@Model.STYPE_ACTIO</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SPATHIMAGE</dt>
            <dd class="col-sm-9">@Model.SPATHIMAGE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NACTION" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
