@model WEBVisualTime.Servicios.Insudb.DTOs.ODWA_HELP_ITEMS.ODWA_HELP_ITEMSDto

@{
    ViewData["Title"] = "Detalles de ODWA_HELP_ITEMS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.ID</dd>
            <dt class="col-sm-3">DESCRIPTION</dt>
            <dd class="col-sm-9">@Model.DESCRIPTION</dd>
            <dt class="col-sm-3">DOCUMENT</dt>
            <dd class="col-sm-9">@Model.DOCUMENT</dd>
            <dt class="col-sm-3">KEYWORDS</dt>
            <dd class="col-sm-9">@Model.KEYWORDS</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
