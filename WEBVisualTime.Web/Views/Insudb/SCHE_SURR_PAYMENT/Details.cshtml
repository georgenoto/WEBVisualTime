@model WEBVisualTime.Servicios.Insudb.DTOs.SCHE_SURR_PAYMENT.SCHE_SURR_PAYMENTDto

@{
    ViewData["Title"] = "Detalles de SCHE_SURR_PAYMENT";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SSCHE_CODE</dt>
            <dd class="col-sm-9">@Model.SSCHE_CODE</dd>
            <dt class="col-sm-3">NTYPE_PAYMENT</dt>
            <dd class="col-sm-9">@Model.NTYPE_PAYMENT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SLIFE</dt>
            <dd class="col-sm-9">@Model.SLIFE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SSCHE_CODE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
