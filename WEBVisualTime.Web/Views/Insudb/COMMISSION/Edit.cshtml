@model WEBVisualTime.Servicios.Insudb.DTOs.COMMISSION.UpdateCOMMISSIONDto

@{
    ViewData["Title"] = "Editar COMMISSION";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SCERTYPE" />
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NPOLICY" />
            <input type="hidden" asp-for="NINTERTYP" />
            <input type="hidden" asp-for="NINTERMED" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="NAMOUNT" class="form-label"></label>
                <input asp-for="NAMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAMOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCOMMITYP" class="form-label"></label>
                <select asp-for="SCOMMITYP" class="form-select" asp-items="@(ViewData["SCOMMITYP"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCOMMITYP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPERCENT" class="form-label"></label>
                <input asp-for="NPERCENT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPERCENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSHARE" class="form-label"></label>
                <input asp-for="NSHARE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NSHARE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPERDISCOUNT" class="form-label"></label>
                <input asp-for="NPERDISCOUNT" class="form-control" type="number" />
                <span asp-validation-for="NPERDISCOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPLUSCOLLEC" class="form-label"></label>
                <input asp-for="SPLUSCOLLEC" class="form-control" />
                <span asp-validation-for="SPLUSCOLLEC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPLUSOFFICE" class="form-label"></label>
                <input asp-for="SPLUSOFFICE" class="form-control" />
                <span asp-validation-for="SPLUSOFFICE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPLUSQUALITY" class="form-label"></label>
                <input asp-for="SPLUSQUALITY" class="form-control" />
                <span asp-validation-for="SPLUSQUALITY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAGREEMENT" class="form-label"></label>
                <input asp-for="NAGREEMENT" class="form-control" type="number" />
                <span asp-validation-for="NAGREEMENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPERCENT_CE" class="form-label"></label>
                <input asp-for="NPERCENT_CE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPERCENT_CE" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="NCERTIF" />
            <div class="mb-3">
                <label asp-for="NINSTALLCOM" class="form-label"></label>
                <input asp-for="NINSTALLCOM" class="form-control" type="number" />
                <span asp-validation-for="NINSTALLCOM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCATEGORY" class="form-label"></label>
                <input asp-for="NCATEGORY" class="form-control" type="number" />
                <span asp-validation-for="NCATEGORY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NID_CAMPAIGN" class="form-label"></label>
                <select asp-for="NID_CAMPAIGN" class="form-select" asp-items="@(ViewData["NID_CAMPAIGN"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NID_CAMPAIGN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DDATEEND_CAMP" class="form-label"></label>
                <input asp-for="DDATEEND_CAMP" class="form-control" type="datetime-local" />
                <span asp-validation-for="DDATEEND_CAMP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT" class="form-label"></label>
                <input asp-for="NMOVEMENT" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT_NULL" class="form-label"></label>
                <input asp-for="NMOVEMENT_NULL" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT_NULL" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
