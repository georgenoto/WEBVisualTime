@model WEBVisualTime.Servicios.Insudb.DTOs.BK_ACCOUNT.BK_ACCOUNTDto

@{
    ViewData["Title"] = "Eliminar BK_ACCOUNT";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBANKEXT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBANKEXT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SACCOUNT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SACCOUNT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYP_ACC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYP_ACC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDEPOSIT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDEPOSIT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCURRENCY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCURRENCY)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("BK_ACCOUNT", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
