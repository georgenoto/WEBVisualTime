@model WEBVisualTime.Servicios.Insudb.DTOs.WIN_MESSAG.WIN_MESSAGDto

@{
    ViewData["Title"] = "Detalles de WIN_MESSAG";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">WINDOWS</dt>
            <dd class="col-sm-9">@Model.WINDOWSSCODISP</dd>
            <dt class="col-sm-3">MESSAGE</dt>
            <dd class="col-sm-9">@Model.MESSAGESMESSAGED</dd>
            <dt class="col-sm-3">SACTION_ERR</dt>
            <dd class="col-sm-9">@Model.SACTION_ERR</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">TABLE153</dt>
            <dd class="col-sm-9">@Model.TABLE153SDESCRIPT</dd>
            <dt class="col-sm-3">NLEVEL</dt>
            <dd class="col-sm-9">@Model.NLEVEL</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SCODISPL" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
