}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NTRATYPEC</dt>
            <dd class="col-sm-9">@Model.NTRATYPEC</dd>
            <dt class="col-sm-3">SBRANCHT</dt>
