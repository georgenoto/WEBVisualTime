@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_WINCLA.UpdateTAB_WINCLADto

@{
    ViewData["Title"] = "Editar TAB_WINCLA";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NTRATYPEC" />
            <input type="hidden" asp-for="SBRANCHT" />
            <input type="hidden" asp-for="SBUSSITYP" />
            <input type="hidden" asp-for="NSEQUENCE" />
            <div class="mb-3">
                <label asp-for="SCODISPL" class="form-label"></label>
                <select asp-for="SCODISPL" class="form-select" asp-items="@(ViewData["SCODISPL"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCODISPL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDEFAULTI" class="form-label"></label>
                <input asp-for="SDEFAULTI" class="form-control" />
                <span asp-validation-for="SDEFAULTI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SREQUIRE" class="form-label"></label>
                <input asp-for="SREQUIRE" class="form-control" />
                <span asp-validation-for="SREQUIRE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
