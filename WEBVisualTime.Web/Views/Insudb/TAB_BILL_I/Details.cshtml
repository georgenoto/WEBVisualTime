            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("TAB_BILL_I", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
