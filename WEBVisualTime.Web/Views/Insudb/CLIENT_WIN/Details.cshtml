@model WEBVisualTime.Servicios.Insudb.DTOs.CLIENT_WIN.CLIENT_WINDto

@{
    ViewData["Title"] = "Detalles de CLIENT_WIN";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">CLIENT</dt>
            <dd class="col-sm-9">@Model.CLIENTSACCOUNT_IN</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SV_CONCLIEN</dt>
            <dd class="col-sm-9">@Model.SV_CONCLIEN</dd>
            <dt class="col-sm-3">SV_WINCLIEN</dt>
            <dd class="col-sm-9">@Model.SV_WINCLIEN</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("CLIENT_WIN", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
