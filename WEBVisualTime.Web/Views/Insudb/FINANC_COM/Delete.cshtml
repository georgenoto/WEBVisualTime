@model WEBVisualTime.Servicios.Insudb.DTOs.FINANC_COM.FINANC_COMDto

@{
    ViewData["Title"] = "Eliminar FINANC_COM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAMOUNT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAMOUNT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NRECEIPT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NRECEIPT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCONTRAT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCONTRAT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINTERMED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINTERMED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPERCENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPERCENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSHARE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSHARE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("FINANC_COM", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
