@model WEBVisualTime.Servicios.Insudb.DTOs.FINANC_COM.FINANC_COMDto

@{
    ViewData["Title"] = "Detalles de FINANC_COM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NAMOUNT</dt>
            <dd class="col-sm-9">@Model.NAMOUNT</dd>
            <dt class="col-sm-3">NRECEIPT</dt>
            <dd class="col-sm-9">@Model.NRECEIPT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NCONTRAT</dt>
            <dd class="col-sm-9">@Model.NCONTRAT</dd>
            <dt class="col-sm-3">INTERMEDIA</dt>
            <dd class="col-sm-9">@Model.INTERMEDIASCOL_AGREE</dd>
            <dt class="col-sm-3">NPERCENT</dt>
            <dd class="col-sm-9">@Model.NPERCENT</dd>
            <dt class="col-sm-3">NSHARE</dt>
            <dd class="col-sm-9">@Model.NSHARE</dd>
            <dt class="col-sm-3">USERS</dt>
            <dd class="col-sm-9">@Model.USERSSACCESSWO</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("FINANC_COM", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
