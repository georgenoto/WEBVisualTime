@model WEBVisualTime.Servicios.Insudb.DTOs.TCURRENCY.UpdateTCURRENCYDto

@{
    ViewData["Title"] = "Editar TCURRENCY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SKEY" class="form-label"></label>
                <input asp-for="SKEY" class="form-control" />
                <span asp-validation-for="SKEY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCURRENCY" class="form-label"></label>
                <input asp-for="NCURRENCY" class="form-control" type="number" />
                <span asp-validation-for="NCURRENCY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRECEIPT" class="form-label"></label>
                <input asp-for="NRECEIPT" class="form-control" type="number" />
                <span asp-validation-for="NRECEIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSITUATION" class="form-label"></label>
                <input asp-for="NSITUATION" class="form-control" type="number" />
                <span asp-validation-for="NSITUATION" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NEXCHANGE" class="form-label"></label>
                <input asp-for="NEXCHANGE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NEXCHANGE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPREMIUM" class="form-label"></label>
                <input asp-for="NPREMIUM" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPREMIUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPREMIUM_N" class="form-label"></label>
                <input asp-for="NPREMIUM_N" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPREMIUM_N" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOMMISSION" class="form-label"></label>
                <input asp-for="NCOMMISSION" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCOMMISSION" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTAX" class="form-label"></label>
                <input asp-for="NTAX" class="form-control" type="number" step="any" />
                <span asp-validation-for="NTAX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCAPITAL" class="form-label"></label>
                <input asp-for="NCAPITAL" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCAPITAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPREMIUM_A" class="form-label"></label>
                <input asp-for="NPREMIUM_A" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPREMIUM_A" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPREMIUM_E" class="form-label"></label>
                <input asp-for="NPREMIUM_E" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPREMIUM_E" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPREMIUMTEC" class="form-label"></label>
                <input asp-for="NPREMIUMTEC" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPREMIUMTEC" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
