@model WEBVisualTime.Servicios.Insudb.DTOs.TCURRENCY.TCURRENCYDto

@{
    ViewData["Title"] = "Detalles de TCURRENCY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SKEY</dt>
            <dd class="col-sm-9">@Model.SKEY</dd>
            <dt class="col-sm-3">NCURRENCY</dt>
            <dd class="col-sm-9">@Model.NCURRENCY</dd>
            <dt class="col-sm-3">NRECEIPT</dt>
            <dd class="col-sm-9">@Model.NRECEIPT</dd>
            <dt class="col-sm-3">NSITUATION</dt>
            <dd class="col-sm-9">@Model.NSITUATION</dd>
            <dt class="col-sm-3">NEXCHANGE</dt>
            <dd class="col-sm-9">@Model.NEXCHANGE</dd>
            <dt class="col-sm-3">NPREMIUM</dt>
            <dd class="col-sm-9">@Model.NPREMIUM</dd>
            <dt class="col-sm-3">NPREMIUM_N</dt>
            <dd class="col-sm-9">@Model.NPREMIUM_N</dd>
            <dt class="col-sm-3">NCOMMISSION</dt>
            <dd class="col-sm-9">@Model.NCOMMISSION</dd>
            <dt class="col-sm-3">NTAX</dt>
            <dd class="col-sm-9">@Model.NTAX</dd>
            <dt class="col-sm-3">NCAPITAL</dt>
            <dd class="col-sm-9">@Model.NCAPITAL</dd>
            <dt class="col-sm-3">NPREMIUM_A</dt>
            <dd class="col-sm-9">@Model.NPREMIUM_A</dd>
            <dt class="col-sm-3">NPREMIUM_E</dt>
            <dd class="col-sm-9">@Model.NPREMIUM_E</dd>
            <dt class="col-sm-3">NPREMIUMTEC</dt>
            <dd class="col-sm-9">@Model.NPREMIUMTEC</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SKEY" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
