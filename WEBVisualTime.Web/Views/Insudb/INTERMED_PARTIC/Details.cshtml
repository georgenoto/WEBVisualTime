@model WEBVisualTime.Servicios.Insudb.DTOs.INTERMED_PARTIC.INTERMED_PARTICDto

@{
    ViewData["Title"] = "Detalles de INTERMED_PARTIC";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">INTERMEDIA</dt>
            <dd class="col-sm-9">@Model.INTERMEDIASCOL_AGREE</dd>
            <dt class="col-sm-3">NSUPERIN_NUM</dt>
            <dd class="col-sm-9">@Model.NSUPERIN_NUM</dd>
            <dt class="col-sm-3">DSUPERIN_NUM</dt>
            <dd class="col-sm-9">@Model.DSUPERIN_NUM</dd>
            <dt class="col-sm-3">NWARRAN_POL</dt>
            <dd class="col-sm-9">@Model.NWARRAN_POL</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NCIRCULAR_DOC</dt>
            <dd class="col-sm-9">@Model.NCIRCULAR_DOC</dd>
            <dt class="col-sm-3">DEXPSUPERIN_NUM</dt>
            <dd class="col-sm-9">@Model.DEXPSUPERIN_NUM</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NINTERMED" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
