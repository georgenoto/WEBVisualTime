@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_PREF_DOMAINS.CDI_PREF_DOMAINSDto

@{
    ViewData["Title"] = "Detalles de CDI_PREF_DOMAINS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">PD_DOMAIN</dt>
            <dd class="col-sm-9">@Model.PD_DOMAIN</dd>
            <dt class="col-sm-3">PD_DESC</dt>
            <dd class="col-sm-9">@Model.PD_DESC</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.PD_DOMAIN" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
