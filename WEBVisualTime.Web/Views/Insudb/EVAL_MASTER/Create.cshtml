@model WEBVisualTime.Servicios.Insudb.DTOs.EVAL_MASTER.CreateEVAL_MASTERDto

@{
    ViewData["Title"] = "Crear EVAL_MASTER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <select asp-for="SCLIENT" class="form-select" asp-items="@(ViewData["SCLIENT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBRANCH" class="form-label"></label>
                <select asp-for="NBRANCH" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NBRANCH">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NBRANCH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPRODUCT" class="form-label"></label>
                <select asp-for="NPRODUCT" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NPRODUCT">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NPRODUCT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPOLICY" class="form-label"></label>
                <select asp-for="NPOLICY" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NPOLICY">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NPOLICY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DSTARTDATE" class="form-label"></label>
                <input asp-for="DSTARTDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DSTARTDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCERTIF" class="form-label"></label>
                <select asp-for="NCERTIF" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NCERTIF">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NCERTIF" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DEXPIRDAT" class="form-label"></label>
                <input asp-for="DEXPIRDAT" class="form-control" type="datetime-local" />
                <span asp-validation-for="DEXPIRDAT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSTATUS_EVAL" class="form-label"></label>
                <select asp-for="NSTATUS_EVAL" class="form-select" asp-items="@(ViewData["NSTATUS_EVAL"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NSTATUS_EVAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCAPITAL" class="form-label"></label>
                <input asp-for="NCAPITAL" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCAPITAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NNOTEREST" class="form-label"></label>
                <input asp-for="NNOTEREST" class="form-control" type="number" />
                <span asp-validation-for="NNOTEREST" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCURRENCY" class="form-label"></label>
                <input asp-for="NCURRENCY" class="form-control" type="number" />
                <span asp-validation-for="NCURRENCY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCUMUL" class="form-label"></label>
                <input asp-for="NCUMUL" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCUMUL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCERTYPE" class="form-label"></label>
                <select asp-for="SCERTYPE" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.SCERTYPE">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCERTYPE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
