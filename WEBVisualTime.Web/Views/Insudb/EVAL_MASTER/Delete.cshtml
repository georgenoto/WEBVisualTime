@model WEBVisualTime.Servicios.Insudb.DTOs.EVAL_MASTER.EVAL_MASTERDto

@{
    ViewData["Title"] = "Eliminar EVAL_MASTER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NEVAL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NEVAL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBRANCH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBRANCH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPRODUCT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPRODUCT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPOLICY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPOLICY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DSTARTDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DSTARTDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCERTIF)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCERTIF)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEXPIRDAT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEXPIRDAT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSTATUS_EVAL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSTATUS_EVAL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCAPITAL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCAPITAL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NNOTEREST)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NNOTEREST)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCURRENCY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCURRENCY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCUMUL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCUMUL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCERTYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCERTYPE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NEVAL" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
