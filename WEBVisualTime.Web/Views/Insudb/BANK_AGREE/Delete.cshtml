@model WEBVisualTime.Servicios.Insudb.DTOs.BANK_AGREE.BANK_AGREEDto

@{
    ViewData["Title"] = "Eliminar BANK_AGREE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STYPE_BANKAGREE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STYPE_BANKAGREE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBANK)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBANK)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NACCOUNT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NACCOUNT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NNUMDIGIT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NNUMDIGIT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SFORMAT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SFORMAT)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.STYPE_BANKAGREE" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
