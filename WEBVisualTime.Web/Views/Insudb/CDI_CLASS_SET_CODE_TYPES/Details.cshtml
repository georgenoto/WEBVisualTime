@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_CLASS_SET_CODE_TYPES.CDI_CLASS_SET_CODE_TYPESDto

@{
    ViewData["Title"] = "Detalles de CDI_CLASS_SET_CODE_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">LANGUAGE_NAME</dt>
            <dd class="col-sm-9">@Model.LANGUAGE_NAME</dd>
            <dt class="col-sm-3">TYPE_NAME</dt>
            <dd class="col-sm-9">@Model.TYPE_NAME</dd>
            <dt class="col-sm-3">GENERATE_FLAG</dt>
            <dd class="col-sm-9">@Model.GENERATE_FLAG</dd>
            <dt class="col-sm-3">TEMPLATE_FILE</dt>
            <dd class="col-sm-9">@Model.TEMPLATE_FILE</dd>
            <dt class="col-sm-3">FILE_FILTER</dt>
            <dd class="col-sm-9">@Model.FILE_FILTER</dd>
            <dt class="col-sm-3">SEQ</dt>
            <dd class="col-sm-9">@Model.SEQ</dd>
            <dt class="col-sm-3">DEFAULT_FILE_NAME</dt>
            <dd class="col-sm-9">@Model.DEFAULT_FILE_NAME</dd>
            <dt class="col-sm-3">OPEN_BEGIN_MARKER</dt>
            <dd class="col-sm-9">@Model.OPEN_BEGIN_MARKER</dd>
            <dt class="col-sm-3">CLOSE_BEGIN_MARKER</dt>
            <dd class="col-sm-9">@Model.CLOSE_BEGIN_MARKER</dd>
            <dt class="col-sm-3">OPEN_END_MARKER</dt>
            <dd class="col-sm-9">@Model.OPEN_END_MARKER</dd>
            <dt class="col-sm-3">CLOSE_END_MARKER</dt>
            <dd class="col-sm-9">@Model.CLOSE_END_MARKER</dd>
            <dt class="col-sm-3">FILE_TYPE</dt>
            <dd class="col-sm-9">@Model.FILE_TYPE</dd>
            <dt class="col-sm-3">NLS_LANG</dt>
            <dd class="col-sm-9">@Model.NLS_LANG</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.LANGUAGE_NAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
