@model WEBVisualTime.Servicios.Insudb.DTOs.CLIALLOCLA.CLIALLOCLADto

@{
    ViewData["Title"] = "Detalles de CLIALLOCLA";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
            <dt class="col-sm-3">TABLE12</dt>
            <dd class="col-sm-9">@Model.TABLE12SDESCRIPT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">SREQUIRE</dt>
            <dd class="col-sm-9">@Model.SREQUIRE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">NMAXNUM_ROL</dt>
            <dd class="col-sm-9">@Model.NMAXNUM_ROL</dd>
            <dt class="col-sm-3">SIND_CRECLI</dt>
            <dd class="col-sm-9">@Model.SIND_CRECLI</dd>
            <dt class="col-sm-3">SDEFAULT_CLA_IND</dt>
            <dd class="col-sm-9">@Model.SDEFAULT_CLA_IND</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("CLIALLOCLA", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
