@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_PROV_MEDSPEC.TAB_PROV_MEDSPECDto

@{
    ViewData["Title"] = "Eliminar TAB_PROV_MEDSPEC";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPROVIDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPROVIDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SMEDSPECIALIALTY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SMEDSPECIALIALTY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NMAIN_MEDSPECIALIALTY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NMAIN_MEDSPECIALIALTY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SREG_MEDICALPROF)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SREG_MEDICALPROF)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NPROVIDER" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
