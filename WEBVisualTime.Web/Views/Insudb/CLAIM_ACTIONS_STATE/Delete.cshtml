}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSCHE_CODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSCHE_CODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCODISPL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCODISPL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSTATUS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSTATUS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SIND_CHANGE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SIND_CHANGE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SIND_QUERY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SIND_QUERY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
