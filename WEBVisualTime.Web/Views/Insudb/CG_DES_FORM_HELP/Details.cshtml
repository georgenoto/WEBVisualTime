@model WEBVisualTime.Servicios.Insudb.DTOs.CG_DES_FORM_HELP.CG_DES_FORM_HELPDto

@{
    ViewData["Title"] = "Detalles de CG_DES_FORM_HELP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">HLP_APPLN</dt>
            <dd class="col-sm-9">@Model.HLP_APPLN</dd>
            <dt class="col-sm-3">HLP_INDEX</dt>
            <dd class="col-sm-9">@Model.HLP_INDEX</dd>
            <dt class="col-sm-3">HLP_MODTAB_NAME</dt>
            <dd class="col-sm-9">@Model.HLP_MODTAB_NAME</dd>
            <dt class="col-sm-3">HLP_GENERATED</dt>
            <dd class="col-sm-9">@Model.HLP_GENERATED</dd>
            <dt class="col-sm-3">HLP_SEQ</dt>
            <dd class="col-sm-9">@Model.HLP_SEQ</dd>
            <dt class="col-sm-3">HLP_TEXT</dt>
            <dd class="col-sm-9">@Model.HLP_TEXT</dd>
            <dt class="col-sm-3">HLP_TYPE</dt>
            <dd class="col-sm-9">@Model.HLP_TYPE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.HLP_APPLN" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
