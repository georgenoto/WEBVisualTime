@model WEBVisualTime.Servicios.Insudb.DTOs.CG_DES_FORM_HELP.UpdateCG_DES_FORM_HELPDto

@{
    ViewData["Title"] = "Editar CG_DES_FORM_HELP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="HLP_APPLN" class="form-label"></label>
                <input asp-for="HLP_APPLN" class="form-control" />
                <span asp-validation-for="HLP_APPLN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HLP_INDEX" class="form-label"></label>
                <input asp-for="HLP_INDEX" class="form-control" />
                <span asp-validation-for="HLP_INDEX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HLP_MODTAB_NAME" class="form-label"></label>
                <input asp-for="HLP_MODTAB_NAME" class="form-control" />
                <span asp-validation-for="HLP_MODTAB_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HLP_GENERATED" class="form-label"></label>
                <input asp-for="HLP_GENERATED" class="form-control" />
                <span asp-validation-for="HLP_GENERATED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HLP_SEQ" class="form-label"></label>
                <input asp-for="HLP_SEQ" class="form-control" type="number" />
                <span asp-validation-for="HLP_SEQ" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HLP_TEXT" class="form-label"></label>
                <input asp-for="HLP_TEXT" class="form-control" />
                <span asp-validation-for="HLP_TEXT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HLP_TYPE" class="form-label"></label>
                <input asp-for="HLP_TYPE" class="form-control" />
                <span asp-validation-for="HLP_TYPE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
