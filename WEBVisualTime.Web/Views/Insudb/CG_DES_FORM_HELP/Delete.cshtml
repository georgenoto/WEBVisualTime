@model WEBVisualTime.Servicios.Insudb.DTOs.CG_DES_FORM_HELP.CG_DES_FORM_HELPDto

@{
    ViewData["Title"] = "Eliminar CG_DES_FORM_HELP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HLP_APPLN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HLP_APPLN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HLP_INDEX)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HLP_INDEX)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HLP_MODTAB_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HLP_MODTAB_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HLP_GENERATED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HLP_GENERATED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HLP_SEQ)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HLP_SEQ)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HLP_TEXT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HLP_TEXT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HLP_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HLP_TYPE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.HLP_APPLN" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
