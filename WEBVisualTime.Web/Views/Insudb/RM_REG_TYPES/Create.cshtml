@model WEBVisualTime.Servicios.Insudb.DTOs.RM_REG_TYPES.CreateRM_REG_TYPESDto

@{
    ViewData["Title"] = "Crear RM_REG_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="TABLE_NAME" class="form-label"></label>
                <input asp-for="TABLE_NAME" class="form-control" />
                <span asp-validation-for="TABLE_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SHORT_NAME" class="form-label"></label>
                <input asp-for="SHORT_NAME" class="form-control" />
                <span asp-validation-for="SHORT_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PLURAL_NAME" class="form-label"></label>
                <input asp-for="PLURAL_NAME" class="form-control" />
                <span asp-validation-for="PLURAL_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLS_NAME" class="form-label"></label>
                <input asp-for="NLS_NAME" class="form-control" />
                <span asp-validation-for="NLS_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLS_PLURAL_NAME" class="form-label"></label>
                <input asp-for="NLS_PLURAL_NAME" class="form-control" />
                <span asp-validation-for="NLS_PLURAL_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="USER_EXTENSION" class="form-label"></label>
                <input asp-for="USER_EXTENSION" class="form-control" />
                <span asp-validation-for="USER_EXTENSION" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HELP_TAG" class="form-label"></label>
                <input asp-for="HELP_TAG" class="form-control" />
                <span asp-validation-for="HELP_TAG" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
