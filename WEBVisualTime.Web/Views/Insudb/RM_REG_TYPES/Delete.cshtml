@model WEBVisualTime.Servicios.Insudb.DTOs.RM_REG_TYPES.RM_REG_TYPESDto

@{
    ViewData["Title"] = "Eliminar RM_REG_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TABLE_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.TABLE_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PRODUCT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PRODUCT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SHORT_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SHORT_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PLURAL_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PLURAL_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NLS_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NLS_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NLS_PLURAL_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NLS_PLURAL_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.USER_EXTENSION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.USER_EXTENSION)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HELP_TAG)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HELP_TAG)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("RM_REG_TYPES", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
