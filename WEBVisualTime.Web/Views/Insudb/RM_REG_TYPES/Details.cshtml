@model WEBVisualTime.Servicios.Insudb.DTOs.RM_REG_TYPES.RM_REG_TYPESDto

@{
    ViewData["Title"] = "Detalles de RM_REG_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">TABLE_NAME</dt>
            <dd class="col-sm-9">@Model.TABLE_NAME</dd>
            <dt class="col-sm-3">PRODUCT</dt>
            <dd class="col-sm-9">@Model.PRODUCT</dd>
            <dt class="col-sm-3">NAME</dt>
            <dd class="col-sm-9">@Model.NAME</dd>
            <dt class="col-sm-3">SHORT_NAME</dt>
            <dd class="col-sm-9">@Model.SHORT_NAME</dd>
            <dt class="col-sm-3">PLURAL_NAME</dt>
            <dd class="col-sm-9">@Model.PLURAL_NAME</dd>
            <dt class="col-sm-3">NLS_NAME</dt>
            <dd class="col-sm-9">@Model.NLS_NAME</dd>
            <dt class="col-sm-3">NLS_PLURAL_NAME</dt>
            <dd class="col-sm-9">@Model.NLS_PLURAL_NAME</dd>
            <dt class="col-sm-3">USER_EXTENSION</dt>
            <dd class="col-sm-9">@Model.USER_EXTENSION</dd>
            <dt class="col-sm-3">HELP_TAG</dt>
            <dd class="col-sm-9">@Model.HELP_TAG</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("RM_REG_TYPES", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
