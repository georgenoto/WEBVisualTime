@model WEBVisualTime.Servicios.Insudb.DTOs.GROUPVARIABLES.UpdateGROUPVARIABLESDto

@{
    ViewData["Title"] = "Editar GROUPVARIABLES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NLETT_GROUP" />
            <input type="hidden" asp-for="SVARIABLE" />
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STABLENAME" class="form-label"></label>
                <input asp-for="STABLENAME" class="form-control" />
                <span asp-validation-for="STABLENAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCOLUMNAME" class="form-label"></label>
                <input asp-for="SCOLUMNAME" class="form-control" />
                <span asp-validation-for="SCOLUMNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPVARIABLE" class="form-label"></label>
                <input asp-for="NTYPVARIABLE" class="form-control" type="number" />
                <span asp-validation-for="NTYPVARIABLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STABVALUE" class="form-label"></label>
                <input asp-for="STABVALUE" class="form-control" />
                <span asp-validation-for="STABVALUE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SALIASTABLE" class="form-label"></label>
                <input asp-for="SALIASTABLE" class="form-control" />
                <span asp-validation-for="SALIASTABLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SALIASCOLUMN" class="form-label"></label>
                <input asp-for="SALIASCOLUMN" class="form-control" />
                <span asp-validation-for="SALIASCOLUMN" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
