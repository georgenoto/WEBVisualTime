@model WEBVisualTime.Servicios.Insudb.DTOs.CL_COMMERTYPEPAY.CL_COMMERTYPEPAYDto

@{
    ViewData["Title"] = "Detalles de CL_COMMERTYPEPAY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NTYPE_COMMPAY</dt>
            <dd class="col-sm-9">@Model.NTYPE_COMMPAY</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">SIND_CONTROL</dt>
