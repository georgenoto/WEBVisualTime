@model WEBVisualTime.Servicios.Insudb.DTOs.COLSHEET.COLSHEETDto

@{
    ViewData["Title"] = "Eliminar COLSHEET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIDREC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIDREC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCOLUMNNAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCOLUMNNAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NORDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NORDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSELECTED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSELECTED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SREQUIRE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SREQUIRE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SVALUE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SVALUE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NID" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
