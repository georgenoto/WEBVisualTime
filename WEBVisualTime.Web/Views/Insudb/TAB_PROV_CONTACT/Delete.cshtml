@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_PROV_CONTACT.TAB_PROV_CONTACTDto

@{
    ViewData["Title"] = "Eliminar TAB_PROV_CONTACT";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPROVIDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPROVIDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSEQ)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSEQ)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEFFECDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEFFECDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DNULLDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DNULLDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPOSITION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPOSITION)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SNAME_CONTACT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SNAME_CONTACT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SE_MAIL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SE_MAIL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SPHONE_CONTACT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SPHONE_CONTACT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("TAB_PROV_CONTACT", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
