@model WEBVisualTime.Servicios.Insudb.DTOs.NOTES.NOTESDto

@{
    ViewData["Title"] = "Detalles de NOTES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NNOTENUM</dt>
            <dd class="col-sm-9">@Model.NNOTENUM</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NCONSEC</dt>
            <dd class="col-sm-9">@Model.NCONSEC</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">TDS_TEXT</dt>
            <dd class="col-sm-9">@Model.TDS_TEXT</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">TABLE62</dt>
            <dd class="col-sm-9">@Model.TABLE62SDESCRIPT</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NNOTENUM" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
