@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_AM_ILL.TAB_AM_ILLDto

@{
    ViewData["Title"] = "Detalles de TAB_AM_ILL";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SILLNESS</dt>
            <dd class="col-sm-9">@Model.SILLNESS</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">TABLE8602</dt>
            <dd class="col-sm-9">@Model.TABLE8602SDESCRIPT</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SIND_SEVERITY</dt>
            <dd class="col-sm-9">@Model.SIND_SEVERITY</dd>
            <dt class="col-sm-3">SIND_FRECUENCY</dt>
            <dd class="col-sm-9">@Model.SIND_FRECUENCY</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SILLNESS" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
