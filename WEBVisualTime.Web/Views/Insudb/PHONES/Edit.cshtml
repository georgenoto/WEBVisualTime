@model WEBVisualTime.Servicios.Insudb.DTOs.PHONES.UpdatePHONESDto

@{
    ViewData["Title"] = "Editar PHONES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NRECOWNER" />
            <input type="hidden" asp-for="SKEYADDRESS" />
            <input type="hidden" asp-for="NKEYPHONES" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="NBESTTIMETOCALL" class="form-label"></label>
                <select asp-for="NBESTTIMETOCALL" class="form-select" asp-items="@(ViewData["NBESTTIMETOCALL"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NBESTTIMETOCALL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAREA_CODE" class="form-label"></label>
                <input asp-for="NAREA_CODE" class="form-control" type="number" />
                <span asp-validation-for="NAREA_CODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPHONE" class="form-label"></label>
                <input asp-for="SPHONE" class="form-control" />
                <span asp-validation-for="SPHONE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NORDER" class="form-label"></label>
                <input asp-for="NORDER" class="form-control" type="number" />
                <span asp-validation-for="NORDER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NEXTENS1" class="form-label"></label>
                <input asp-for="NEXTENS1" class="form-control" type="number" />
                <span asp-validation-for="NEXTENS1" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NEXTENS2" class="form-label"></label>
                <input asp-for="NEXTENS2" class="form-control" type="number" />
                <span asp-validation-for="NEXTENS2" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPHONE_TYPE" class="form-label"></label>
                <select asp-for="NPHONE_TYPE" class="form-select" asp-items="@(ViewData["NPHONE_TYPE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NPHONE_TYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOUNTRY_CODE" class="form-label"></label>
                <input asp-for="NCOUNTRY_CODE" class="form-control" type="number" />
                <span asp-validation-for="NCOUNTRY_CODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SASSOCADDR" class="form-label"></label>
                <input asp-for="SASSOCADDR" class="form-control" />
                <span asp-validation-for="SASSOCADDR" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPHONECLAS" class="form-label"></label>
                <input asp-for="NPHONECLAS" class="form-control" type="number" />
                <span asp-validation-for="NPHONECLAS" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
