@model WEBVisualTime.Servicios.Insudb.DTOs.DIR_DEBIT_CLI.UpdateDIR_DEBIT_CLIDto

@{
    ViewData["Title"] = "Editar DIR_DEBIT_CLI";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SCLIENT" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="SACCOUNT" class="form-label"></label>
                <input asp-for="SACCOUNT" class="form-control" />
                <span asp-validation-for="SACCOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STYP_DIRDEB" class="form-label"></label>
                <input asp-for="STYP_DIRDEB" class="form-control" />
                <span asp-validation-for="STYP_DIRDEB" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBANKEXT" class="form-label"></label>
                <select asp-for="NBANKEXT" class="form-select" asp-items="@(ViewData["NBANKEXT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NBANKEXT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SBANKAUTH" class="form-label"></label>
                <input asp-for="SBANKAUTH" class="form-control" />
                <span asp-validation-for="SBANKAUTH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBILL_DAY" class="form-label"></label>
                <input asp-for="NBILL_DAY" class="form-control" type="number" />
                <span asp-validation-for="NBILL_DAY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSTATUS_BANKAUTH" class="form-label"></label>
                <input asp-for="NSTATUS_BANKAUTH" class="form-control" type="number" />
                <span asp-validation-for="NSTATUS_BANKAUTH" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
