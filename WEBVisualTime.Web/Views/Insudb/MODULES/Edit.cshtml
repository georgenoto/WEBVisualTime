@model WEBVisualTime.Servicios.Insudb.DTOs.MODULES.UpdateMODULESDto

@{
    ViewData["Title"] = "Editar MODULES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SCERTYPE" />
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NPOLICY" />
            <input type="hidden" asp-for="NCERTIF" />
            <input type="hidden" asp-for="NGROUP_INSU" />
            <input type="hidden" asp-for="NMODULEC" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCHANGEI" class="form-label"></label>
                <input asp-for="SCHANGEI" class="form-control" />
                <span asp-validation-for="SCHANGEI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCURRENCY" class="form-label"></label>
                <input asp-for="NCURRENCY" class="form-control" type="number" />
                <span asp-validation-for="NCURRENCY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPREMIRAT" class="form-label"></label>
                <input asp-for="NPREMIRAT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPREMIRAT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STYP_RAT" class="form-label"></label>
                <input asp-for="STYP_RAT" class="form-control" />
                <span asp-validation-for="STYP_RAT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SINHERIT" class="form-label"></label>
                <input asp-for="SINHERIT" class="form-control" />
                <span asp-validation-for="SINHERIT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NGEOGRAPHAREA" class="form-label"></label>
                <select asp-for="NGEOGRAPHAREA" class="form-select" asp-items="@(ViewData["NGEOGRAPHAREA"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NGEOGRAPHAREA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NATTENSYSTEM" class="form-label"></label>
                <select asp-for="NATTENSYSTEM" class="form-select" asp-items="@(ViewData["NATTENSYSTEM"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NATTENSYSTEM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT" class="form-label"></label>
                <input asp-for="NMOVEMENT" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT_NULL" class="form-label"></label>
                <input asp-for="NMOVEMENT_NULL" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT_NULL" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
