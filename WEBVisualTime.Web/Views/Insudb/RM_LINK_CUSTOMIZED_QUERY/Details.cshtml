@model WEBVisualTime.Servicios.Insudb.DTOs.RM_LINK_CUSTOMIZED_QUERY.RM_LINK_CUSTOMIZED_QUERYDto

@{
    ViewData["Title"] = "Detalles de RM_LINK_CUSTOMIZED_QUERY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">QUERY_NAME</dt>
            <dd class="col-sm-9">@Model.QUERY_NAME</dd>
            <dt class="col-sm-3">QUERY_TEXT</dt>
            <dd class="col-sm-9">@Model.QUERY_TEXT</dd>
            <dt class="col-sm-3">ALIAS</dt>
            <dd class="col-sm-9">@Model.ALIAS</dd>
            <dt class="col-sm-3">NUMBER_OF_PROPERTIES</dt>
            <dd class="col-sm-9">@Model.NUMBER_OF_PROPERTIES</dd>
            <dt class="col-sm-3">FOLDER_CONTEXT</dt>
            <dd class="col-sm-9">@Model.FOLDER_CONTEXT</dd>
            <dt class="col-sm-3">OBJECT_CONTEXT</dt>
            <dd class="col-sm-9">@Model.OBJECT_CONTEXT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.QUERY_NAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
