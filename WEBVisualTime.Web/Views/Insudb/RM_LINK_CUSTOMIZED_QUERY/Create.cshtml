@model WEBVisualTime.Servicios.Insudb.DTOs.RM_LINK_CUSTOMIZED_QUERY.CreateRM_LINK_CUSTOMIZED_QUERYDto

@{
    ViewData["Title"] = "Crear RM_LINK_CUSTOMIZED_QUERY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="QUERY_NAME" class="form-label"></label>
                <input asp-for="QUERY_NAME" class="form-control" />
                <span asp-validation-for="QUERY_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="QUERY_TEXT" class="form-label"></label>
                <input asp-for="QUERY_TEXT" class="form-control" />
                <span asp-validation-for="QUERY_TEXT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ALIAS" class="form-label"></label>
                <input asp-for="ALIAS" class="form-control" />
                <span asp-validation-for="ALIAS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUMBER_OF_PROPERTIES" class="form-label"></label>
                <input asp-for="NUMBER_OF_PROPERTIES" class="form-control" type="number" />
                <span asp-validation-for="NUMBER_OF_PROPERTIES" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FOLDER_CONTEXT" class="form-label"></label>
                <input asp-for="FOLDER_CONTEXT" class="form-control" />
                <span asp-validation-for="FOLDER_CONTEXT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="OBJECT_CONTEXT" class="form-label"></label>
                <input asp-for="OBJECT_CONTEXT" class="form-control" />
                <span asp-validation-for="OBJECT_CONTEXT" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
