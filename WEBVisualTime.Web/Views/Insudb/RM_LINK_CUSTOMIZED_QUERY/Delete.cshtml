@model WEBVisualTime.Servicios.Insudb.DTOs.RM_LINK_CUSTOMIZED_QUERY.RM_LINK_CUSTOMIZED_QUERYDto

@{
    ViewData["Title"] = "Eliminar RM_LINK_CUSTOMIZED_QUERY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.QUERY_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.QUERY_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.QUERY_TEXT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.QUERY_TEXT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ALIAS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ALIAS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUMBER_OF_PROPERTIES)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUMBER_OF_PROPERTIES)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FOLDER_CONTEXT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FOLDER_CONTEXT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.OBJECT_CONTEXT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.OBJECT_CONTEXT)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.QUERY_NAME" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
