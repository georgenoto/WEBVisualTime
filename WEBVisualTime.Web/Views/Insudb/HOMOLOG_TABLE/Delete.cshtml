@model WEBVisualTime.Servicios.Insudb.DTOs.HOMOLOG_TABLE.HOMOLOG_TABLEDto

@{
    ViewData["Title"] = "Eliminar HOMOLOG_TABLE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSYSTEM)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSYSTEM)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTABLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTABLE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCOLUMNNAME_VT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCOLUMNNAME_VT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCODVALUE_VT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCODVALUE_VT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SVALUE_VT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SVALUE_VT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STABLENAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STABLENAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCOLUMNNAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCOLUMNNAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCODVALUE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCODVALUE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SPREDOM)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SPREDOM)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NSYSTEM" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
