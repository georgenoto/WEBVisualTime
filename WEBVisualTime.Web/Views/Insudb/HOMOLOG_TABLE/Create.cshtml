@model WEBVisualTime.Servicios.Insudb.DTOs.HOMOLOG_TABLE.CreateHOMOLOG_TABLEDto

@{
    ViewData["Title"] = "Crear HOMOLOG_TABLE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NSYSTEM" class="form-label"></label>
                <input asp-for="NSYSTEM" class="form-control" type="number" />
                <span asp-validation-for="NSYSTEM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTABLE" class="form-label"></label>
                <input asp-for="NTABLE" class="form-control" type="number" />
                <span asp-validation-for="NTABLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NID" class="form-label"></label>
                <input asp-for="NID" class="form-control" type="number" />
                <span asp-validation-for="NID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCOLUMNNAME_VT" class="form-label"></label>
                <input asp-for="SCOLUMNNAME_VT" class="form-control" />
                <span asp-validation-for="SCOLUMNNAME_VT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCODVALUE_VT" class="form-label"></label>
                <input asp-for="SCODVALUE_VT" class="form-control" />
                <span asp-validation-for="SCODVALUE_VT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SVALUE_VT" class="form-label"></label>
                <input asp-for="SVALUE_VT" class="form-control" />
                <span asp-validation-for="SVALUE_VT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STABLENAME" class="form-label"></label>
                <input asp-for="STABLENAME" class="form-control" />
                <span asp-validation-for="STABLENAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCOLUMNNAME" class="form-label"></label>
                <input asp-for="SCOLUMNNAME" class="form-control" />
                <span asp-validation-for="SCOLUMNNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCODVALUE" class="form-label"></label>
                <input asp-for="SCODVALUE" class="form-control" />
                <span asp-validation-for="SCODVALUE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPREDOM" class="form-label"></label>
                <input asp-for="SPREDOM" class="form-control" />
                <span asp-validation-for="SPREDOM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
