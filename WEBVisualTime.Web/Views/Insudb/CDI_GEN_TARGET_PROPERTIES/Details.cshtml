@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_GEN_TARGET_PROPERTIES.CDI_GEN_TARGET_PROPERTIESDto

@{
    ViewData["Title"] = "Detalles de CDI_GEN_TARGET_PROPERTIES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">TARGET_NAME</dt>
            <dd class="col-sm-9">@Model.TARGET_NAME</dd>
            <dt class="col-sm-3">TYPE</dt>
            <dd class="col-sm-9">@Model.TYPE</dd>
            <dt class="col-sm-3">NAME</dt>
            <dd class="col-sm-9">@Model.NAME</dd>
            <dt class="col-sm-3">VALUE</dt>
            <dd class="col-sm-9">@Model.VALUE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.TARGET_NAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
