@model WEBVisualTime.Servicios.Insudb.DTOs.DEPEND_SHEET.DEPEND_SHEETDto

@{
    ViewData["Title"] = "Detalles de DEPEND_SHEET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NSHEET_FATHER</dt>
            <dd class="col-sm-9">@Model.NSHEET_FATHER</dd>
            <dt class="col-sm-3">NSHEET_CHILD</dt>
            <dd class="col-sm-9">@Model.NSHEET_CHILD</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NSHEET_FATHER" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
