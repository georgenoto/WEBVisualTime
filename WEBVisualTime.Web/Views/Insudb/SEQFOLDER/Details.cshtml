@model WEBVisualTime.Servicios.Insudb.DTOs.SEQFOLDER.SEQFOLDERDto

@{
    ViewData["Title"] = "Detalles de SEQFOLDER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NQUERYTYPE</dt>
            <dd class="col-sm-9">@Model.NQUERYTYPE</dd>
            <dt class="col-sm-3">NPARENT</dt>
            <dd class="col-sm-9">@Model.NPARENT</dd>
            <dt class="col-sm-3">FOLDERS</dt>
            <dd class="col-sm-9">@Model.FOLDERSSFOLDERNAME</dd>
            <dt class="col-sm-3">NSEQUENCE</dt>
            <dd class="col-sm-9">@Model.NSEQUENCE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NQUERYTYPE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
