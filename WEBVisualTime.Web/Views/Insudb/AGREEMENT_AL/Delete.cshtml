@model WEBVisualTime.Servicios.Insudb.DTOs.AGREEMENT_AL.AGREEMENT_ALDto

@{
    ViewData["Title"] = "Eliminar AGREEMENT_AL";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAGREEMENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAGREEMENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDESCRIPT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDESCRIPT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DSTARTDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DSTARTDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DNULLDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DNULLDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SLEVELINT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SLEVELINT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAGREE_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAGREE_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINTERMED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINTERMED)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NAGREEMENT" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
