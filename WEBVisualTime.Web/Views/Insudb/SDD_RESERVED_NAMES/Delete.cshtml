@model WEBVisualTime.Servicios.Insudb.DTOs.SDD_RESERVED_NAMES.SDD_RESERVED_NAMESDto

@{
    ViewData["Title"] = "Eliminar SDD_RESERVED_NAMES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_RES_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_RES_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_COMMENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_COMMENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_GLOBAL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_GLOBAL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_TEMPORARY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_TEMPORARY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_ENABLED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_ENABLED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_USR_ACCESS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_USR_ACCESS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_CDAPI)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_CDAPI)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_OBJECT_IRID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_OBJECT_IRID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RN_OBJECT_IVID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RN_OBJECT_IVID)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.RN_RES_NAME" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
