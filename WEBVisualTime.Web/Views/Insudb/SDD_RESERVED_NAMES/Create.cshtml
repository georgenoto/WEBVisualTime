@model WEBVisualTime.Servicios.Insudb.DTOs.SDD_RESERVED_NAMES.CreateSDD_RESERVED_NAMESDto

@{
    ViewData["Title"] = "Crear SDD_RESERVED_NAMES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="RN_RES_NAME" class="form-label"></label>
                <input asp-for="RN_RES_NAME" class="form-control" />
                <span asp-validation-for="RN_RES_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_TYPE" class="form-label"></label>
                <input asp-for="RN_TYPE" class="form-control" />
                <span asp-validation-for="RN_TYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_COMMENT" class="form-label"></label>
                <input asp-for="RN_COMMENT" class="form-control" />
                <span asp-validation-for="RN_COMMENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_GLOBAL" class="form-label"></label>
                <input asp-for="RN_GLOBAL" class="form-control" />
                <span asp-validation-for="RN_GLOBAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_TEMPORARY" class="form-label"></label>
                <input asp-for="RN_TEMPORARY" class="form-control" />
                <span asp-validation-for="RN_TEMPORARY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_ENABLED" class="form-label"></label>
                <input asp-for="RN_ENABLED" class="form-control" />
                <span asp-validation-for="RN_ENABLED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_USR_ACCESS" class="form-label"></label>
                <input asp-for="RN_USR_ACCESS" class="form-control" />
                <span asp-validation-for="RN_USR_ACCESS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_CDAPI" class="form-label"></label>
                <input asp-for="RN_CDAPI" class="form-control" />
                <span asp-validation-for="RN_CDAPI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_OBJECT_IRID" class="form-label"></label>
                <input asp-for="RN_OBJECT_IRID" class="form-control" type="number" />
                <span asp-validation-for="RN_OBJECT_IRID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RN_OBJECT_IVID" class="form-label"></label>
                <input asp-for="RN_OBJECT_IVID" class="form-control" type="number" />
                <span asp-validation-for="RN_OBJECT_IVID" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
