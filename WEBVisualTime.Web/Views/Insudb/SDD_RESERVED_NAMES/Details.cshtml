}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">RN_RES_NAME</dt>
            <dd class="col-sm-9">@Model.RN_RES_NAME</dd>
            <dt class="col-sm-3">RN_TYPE</dt>
            <dd class="col-sm-9">@Model.RN_TYPE</dd>
            <dt class="col-sm-3">RN_COMMENT</dt>
            <dd class="col-sm-9">@Model.RN_COMMENT</dd>
            <dt class="col-sm-3">RN_GLOBAL</dt>
            <dd class="col-sm-9">@Model.RN_GLOBAL</dd>
            <dt class="col-sm-3">RN_TEMPORARY</dt>
            <dd class="col-sm-9">@Model.RN_TEMPORARY</dd>
            <dt class="col-sm-3">RN_ENABLED</dt>
            <dd class="col-sm-9">@Model.RN_ENABLED</dd>
            <dt class="col-sm-3">RN_USR_ACCESS</dt>
            <dd class="col-sm-9">@Model.RN_USR_ACCESS</dd>
            <dt class="col-sm-3">RN_CDAPI</dt>
            <dd class="col-sm-9">@Model.RN_CDAPI</dd>
            <dt class="col-sm-3">RN_OBJECT_IRID</dt>
            <dd class="col-sm-9">@Model.RN_OBJECT_IRID</dd>
            <dt class="col-sm-3">RN_OBJECT_IVID</dt>
            <dd class="col-sm-9">@Model.RN_OBJECT_IVID</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.RN_RES_NAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
