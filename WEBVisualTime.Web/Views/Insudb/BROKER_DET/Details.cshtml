@model WEBVisualTime.Servicios.Insudb.DTOs.BROKER_DET.BROKER_DETDto

@{
    ViewData["Title"] = "Detalles de BROKER_DET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NCOMPANY_BR</dt>
            <dd class="col-sm-9">@Model.NCOMPANY_BR</dd>
            <dt class="col-sm-3">NCOMPANY</dt>
            <dd class="col-sm-9">@Model.NCOMPANY</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">NID</dt>
            <dd class="col-sm-9">@Model.NID</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("BROKER_DET", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
