@model WEBVisualTime.Servicios.Insudb.DTOs.ODWA_HELP_NODES.CreateODWA_HELP_NODESDto

@{
    ViewData["Title"] = "Crear ODWA_HELP_NODES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="PARENT_NODE" class="form-label"></label>
                <input asp-for="PARENT_NODE" class="form-control" type="number" />
                <span asp-validation-for="PARENT_NODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SEQ_IN_PARENT" class="form-label"></label>
                <input asp-for="SEQ_IN_PARENT" class="form-control" type="number" />
                <span asp-validation-for="SEQ_IN_PARENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TREE_LEVEL" class="form-label"></label>
                <input asp-for="TREE_LEVEL" class="form-control" type="number" />
                <span asp-validation-for="TREE_LEVEL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DISPLAY_LABEL" class="form-label"></label>
                <input asp-for="DISPLAY_LABEL" class="form-control" />
                <span asp-validation-for="DISPLAY_LABEL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HIM_ID" class="form-label"></label>
                <input asp-for="HIM_ID" class="form-control" type="number" />
                <span asp-validation-for="HIM_ID" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
