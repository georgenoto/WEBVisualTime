@model WEBVisualTime.Servicios.Insudb.DTOs.BILLS_NUM.UpdateBILLS_NUMDto

@{
    ViewData["Title"] = "Editar BILLS_NUM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NINSUR_AREA" />
            <input type="hidden" asp-for="SBILLTYPE" />
            <input type="hidden" asp-for="NINITNUMB" />
            <div class="mb-3">
                <label asp-for="NENDNUMB" class="form-label"></label>
                <input asp-for="NENDNUMB" class="form-control" type="number" />
                <span asp-validation-for="NENDNUMB" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLASTBILL" class="form-label"></label>
                <input asp-for="NLASTBILL" class="form-control" type="number" />
                <span asp-validation-for="NLASTBILL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DLASTCLOSED" class="form-label"></label>
                <input asp-for="DLASTCLOSED" class="form-control" type="datetime-local" />
                <span asp-validation-for="DLASTCLOSED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
