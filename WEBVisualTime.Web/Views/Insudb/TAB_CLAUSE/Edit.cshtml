@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_CLAUSE.UpdateTAB_CLAUSEDto

@{
    ViewData["Title"] = "Editar TAB_CLAUSE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NMODULEC" />
            <input type="hidden" asp-for="NCOVER" />
            <input type="hidden" asp-for="NCLAUSE" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDEFAULTI" class="form-label"></label>
                <input asp-for="SDEFAULTI" class="form-control" />
                <span asp-validation-for="SDEFAULTI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NNOTENUM" class="form-label"></label>
                <input asp-for="NNOTENUM" class="form-control" type="number" />
                <span asp-validation-for="NNOTENUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSHORT_DES" class="form-label"></label>
                <input asp-for="SSHORT_DES" class="form-control" />
                <span asp-validation-for="SSHORT_DES" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SMODIFIED" class="form-label"></label>
                <input asp-for="SMODIFIED" class="form-control" />
                <span asp-validation-for="SMODIFIED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPE" class="form-label"></label>
                <select asp-for="NTYPE" class="form-select" asp-items="@(ViewData["NTYPE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STYPE_CLAUSE" class="form-label"></label>
                <input asp-for="STYPE_CLAUSE" class="form-control" />
                <span asp-validation-for="STYPE_CLAUSE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDOC_ATTACH" class="form-label"></label>
                <input asp-for="SDOC_ATTACH" class="form-control" />
                <span asp-validation-for="SDOC_ATTACH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NORDEN" class="form-label"></label>
                <input asp-for="NORDEN" class="form-control" type="number" />
                <span asp-validation-for="NORDEN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STITCLAUSE" class="form-label"></label>
                <input asp-for="STITCLAUSE" class="form-control" />
                <span asp-validation-for="STITCLAUSE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
