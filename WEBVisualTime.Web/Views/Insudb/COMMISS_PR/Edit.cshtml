@model WEBVisualTime.Servicios.Insudb.DTOs.COMMISS_PR.UpdateCOMMISS_PRDto

@{
    ViewData["Title"] = "Editar COMMISS_PR";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NRECEIPT" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="SCERTYPE" />
            <input type="hidden" asp-for="NDIGIT" />
            <input type="hidden" asp-for="NPAYNUMBE" />
            <input type="hidden" asp-for="NINTERMED" />
            <div class="mb-3">
                <label asp-for="NPROVINCE" class="form-label"></label>
                <select asp-for="NPROVINCE" class="form-select" asp-items="@(ViewData["NPROVINCE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NPROVINCE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAMOUNT" class="form-label"></label>
                <input asp-for="NAMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAMOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPERCENT" class="form-label"></label>
                <input asp-for="NPERCENT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPERCENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NROLE" class="form-label"></label>
                <select asp-for="NROLE" class="form-select" asp-items="@(ViewData["NROLE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NROLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSHARE" class="form-label"></label>
                <input asp-for="NSHARE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NSHARE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOM_AFEC" class="form-label"></label>
                <input asp-for="NCOM_AFEC" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCOM_AFEC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOM_EXEN" class="form-label"></label>
                <input asp-for="NCOM_EXEN" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCOM_EXEN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NDISC_AMOUNT" class="form-label"></label>
                <input asp-for="NDISC_AMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NDISC_AMOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCATEGORY" class="form-label"></label>
                <input asp-for="NCATEGORY" class="form-control" type="number" />
                <span asp-validation-for="NCATEGORY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NID_CAMPAIGN" class="form-label"></label>
                <select asp-for="NID_CAMPAIGN" class="form-select" asp-items="@(ViewData["NID_CAMPAIGN"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NID_CAMPAIGN" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
