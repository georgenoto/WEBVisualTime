@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_GENERATION_TARGETS.CreateCDI_GENERATION_TARGETSDto

@{
    ViewData["Title"] = "Crear CDI_GENERATION_TARGETS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NAME" class="form-label"></label>
                <input asp-for="NAME" class="form-control" />
                <span asp-validation-for="NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SEQ" class="form-label"></label>
                <input asp-for="SEQ" class="form-control" type="number" />
                <span asp-validation-for="SEQ" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LANGUAGE" class="form-label"></label>
                <input asp-for="LANGUAGE" class="form-control" />
                <span asp-validation-for="LANGUAGE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="REGISTRY_NAME" class="form-label"></label>
                <input asp-for="REGISTRY_NAME" class="form-control" />
                <span asp-validation-for="REGISTRY_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MEMBER_BEGIN_MARKER" class="form-label"></label>
                <input asp-for="MEMBER_BEGIN_MARKER" class="form-control" />
                <span asp-validation-for="MEMBER_BEGIN_MARKER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CLOSE_MEMBER_MARKER" class="form-label"></label>
                <input asp-for="CLOSE_MEMBER_MARKER" class="form-control" />
                <span asp-validation-for="CLOSE_MEMBER_MARKER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MEMBER_END_MARKER" class="form-label"></label>
                <input asp-for="MEMBER_END_MARKER" class="form-control" />
                <span asp-validation-for="MEMBER_END_MARKER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLS_LANG" class="form-label"></label>
                <input asp-for="NLS_LANG" class="form-control" />
                <span asp-validation-for="NLS_LANG" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
