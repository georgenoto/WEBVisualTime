@model WEBVisualTime.Servicios.Insudb.DTOs.DEVLOCALRECORDSDELETED.CreateDEVLOCALRECORDSDELETEDDto

@{
    ViewData["Title"] = "Crear DEVLOCALRECORDSDELETED";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DELDATE" class="form-label"></label>
                <input asp-for="DELDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DELDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PKEY" class="form-label"></label>
                <input asp-for="PKEY" class="form-control" />
                <span asp-validation-for="PKEY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="LOCALTABLEID" class="form-label"></label>
                <input asp-for="LOCALTABLEID" class="form-control" type="number" />
                <span asp-validation-for="LOCALTABLEID" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
