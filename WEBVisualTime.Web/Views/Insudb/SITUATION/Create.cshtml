@model WEBVisualTime.Servicios.Insudb.DTOs.SITUATION.CreateSITUATIONDto

@{
    ViewData["Title"] = "Crear SITUATION";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <select asp-for="SCLIENT" class="form-select" asp-items="@(ViewData["SCLIENT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPARTICIP_POLEMP" class="form-label"></label>
                <input asp-for="NPARTICIP_POLEMP" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPARTICIP_POLEMP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPARTICIP_POLCO" class="form-label"></label>
                <input asp-for="NPARTICIP_POLCO" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPARTICIP_POLCO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPCLIENTDOC" class="form-label"></label>
                <input asp-for="NTYPCLIENTDOC" class="form-control" type="number" />
                <span asp-validation-for="NTYPCLIENTDOC" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
