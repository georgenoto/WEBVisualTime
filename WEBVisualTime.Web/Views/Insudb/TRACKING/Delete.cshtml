@model WEBVisualTime.Servicios.Insudb.DTOs.TRACKING.TRACKINGDto

@{
    ViewData["Title"] = "Eliminar TRACKING";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FACTTIME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FACTTIME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HOSTSOURCE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.HOSTSOURCE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FORMPATH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FORMPATH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.URLREFERRER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.URLREFERRER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.USERAGENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.USERAGENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FORMID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FORMID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PURCHASEORDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PURCHASEORDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.REMARK)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.REMARK)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CALLEDFROMID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CALLEDFROMID)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.ID" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
