@model IEnumerable<WEBVisualTime.Servicios.Insudb.DTOs.TRACKING.TRACKINGDto>

@{
    ViewData["Title"] = "TRACKING";
    ViewData["ColumnHeaders"] = new[] { "ID", "FACTTIME", "HOSTSOURCE", "FORMPATH", "URLREFERRER", "USERAGENT", "FORMID", "PURCHASEORDER", "REMARK", "CALLEDFROMID" };
    ViewData["ColumnProperties"] = new[] { "ID", "FACTTIME", "HOSTSOURCE", "FORMPATH", "URLREFERRER", "USERAGENT", "FORMID", "PURCHASEORDER", "REMARK", "CALLEDFROMID" };
    ViewData["KeyName"] = "ID";
    ViewData["PageSize"] = 20;
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<p><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear Nuevo</a></p>

@await Html.PartialAsync("_DataTable", Model)

@section Scripts {
    <script>initDataTables();</script>
}
