@model WEBVisualTime.Servicios.Insudb.DTOs.TRACKING.CreateTRACKINGDto

@{
    ViewData["Title"] = "Crear TRACKING";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="FACTTIME" class="form-label"></label>
                <input asp-for="FACTTIME" class="form-control" />
                <span asp-validation-for="FACTTIME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="HOSTSOURCE" class="form-label"></label>
                <input asp-for="HOSTSOURCE" class="form-control" />
                <span asp-validation-for="HOSTSOURCE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FORMPATH" class="form-label"></label>
                <input asp-for="FORMPATH" class="form-control" />
                <span asp-validation-for="FORMPATH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="URLREFERRER" class="form-label"></label>
                <input asp-for="URLREFERRER" class="form-control" />
                <span asp-validation-for="URLREFERRER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="USERAGENT" class="form-label"></label>
                <input asp-for="USERAGENT" class="form-control" />
                <span asp-validation-for="USERAGENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FORMID" class="form-label"></label>
                <input asp-for="FORMID" class="form-control" />
                <span asp-validation-for="FORMID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PURCHASEORDER" class="form-label"></label>
                <input asp-for="PURCHASEORDER" class="form-control" type="number" />
                <span asp-validation-for="PURCHASEORDER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="REMARK" class="form-label"></label>
                <input asp-for="REMARK" class="form-control" />
                <span asp-validation-for="REMARK" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CALLEDFROMID" class="form-label"></label>
                <input asp-for="CALLEDFROMID" class="form-control" />
                <span asp-validation-for="CALLEDFROMID" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
