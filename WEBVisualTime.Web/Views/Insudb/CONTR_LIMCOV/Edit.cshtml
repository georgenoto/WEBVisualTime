@model WEBVisualTime.Servicios.Insudb.DTOs.CONTR_LIMCOV.UpdateCONTR_LIMCOVDto

@{
    ViewData["Title"] = "Editar CONTR_LIMCOV";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH_REI" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <input type="hidden" asp-for="NNUMBER" />
            <input type="hidden" asp-for="NTYPE" />
            <input type="hidden" asp-for="NINSUR_AREA" />
            <input type="hidden" asp-for="NCOVERGEN" />
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAMOUNT" class="form-label"></label>
                <input asp-for="NAMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAMOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLINES" class="form-label"></label>
                <input asp-for="NLINES" class="form-control" type="number" step="any" />
                <span asp-validation-for="NLINES" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NQUOTA_SHA" class="form-label"></label>
                <input asp-for="NQUOTA_SHA" class="form-control" type="number" step="any" />
                <span asp-validation-for="NQUOTA_SHA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SROUTINE" class="form-label"></label>
                <input asp-for="SROUTINE" class="form-control" />
                <span asp-validation-for="SROUTINE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOVERAPP" class="form-label"></label>
                <input asp-for="NCOVERAPP" class="form-control" type="number" />
                <span asp-validation-for="NCOVERAPP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPERCENT" class="form-label"></label>
                <input asp-for="NPERCENT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPERCENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMAXAMOUNT" class="form-label"></label>
                <input asp-for="NMAXAMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NMAXAMOUNT" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
