            <dd class="col-sm-9">@Html.DisplayFor(model => model.STEXT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SREQUIERED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SREQUIERED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPERSON_TYP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPERSON_TYP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDOC_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDOC_TYPE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NBRANCH" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
