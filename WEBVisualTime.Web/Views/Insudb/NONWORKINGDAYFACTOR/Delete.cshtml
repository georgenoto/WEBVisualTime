@model WEBVisualTime.Servicios.Insudb.DTOs.NONWORKINGDAYFACTOR.NONWORKINGDAYFACTORDto

@{
    ViewData["Title"] = "Eliminar NONWORKINGDAYFACTOR";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIDFACTOR)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIDFACTOR)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIDUSER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIDUSER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NFACTOR)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NFACTOR)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCREATIONDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCREATIONDATE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NIDFACTOR" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
