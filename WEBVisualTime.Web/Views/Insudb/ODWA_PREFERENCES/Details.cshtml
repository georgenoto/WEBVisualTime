@model WEBVisualTime.Servicios.Insudb.DTOs.ODWA_PREFERENCES.ODWA_PREFERENCESDto

@{
    ViewData["Title"] = "Detalles de ODWA_PREFERENCES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">PREFERENCE_NAME</dt>
            <dd class="col-sm-9">@Model.PREFERENCE_NAME</dd>
            <dt class="col-sm-3">PREFERENCE_VALUE</dt>
            <dd class="col-sm-9">@Model.PREFERENCE_VALUE</dd>
            <dt class="col-sm-3">PREFERENCE_DESCRIPTION</dt>
            <dd class="col-sm-9">@Model.PREFERENCE_DESCRIPTION</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.PREFERENCE_NAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
