@model WEBVisualTime.Servicios.Insudb.DTOs.CLAIM_MASTER.CLAIM_MASTERDto

@{
    ViewData["Title"] = "Detalles de CLAIM_MASTER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NBORDEREAUX_CL</dt>
            <dd class="col-sm-9">@Model.NBORDEREAUX_CL</dd>
            <dt class="col-sm-3">CLIENT</dt>
            <dd class="col-sm-9">@Model.CLIENTSACCOUNT_IN</dd>
            <dt class="col-sm-3">NCOVER</dt>
            <dd class="col-sm-9">@Model.NCOVER</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SKEY</dt>
            <dd class="col-sm-9">@Model.SKEY</dd>
            <dt class="col-sm-3">SFILENAME</dt>
            <dd class="col-sm-9">@Model.SFILENAME</dd>
            <dt class="col-sm-3">NPROVIDER</dt>
            <dd class="col-sm-9">@Model.NPROVIDER</dd>
            <dt class="col-sm-3">NOFFICE</dt>
            <dd class="col-sm-9">@Model.NOFFICE</dd>
            <dt class="col-sm-3">NSTATUS</dt>
            <dd class="col-sm-9">@Model.NSTATUS</dd>
            <dt class="col-sm-3">SSTATUS_PROC</dt>
            <dd class="col-sm-9">@Model.SSTATUS_PROC</dd>
            <dt class="col-sm-3">NPAY_PROVIDER</dt>
            <dd class="col-sm-9">@Model.NPAY_PROVIDER</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NBORDEREAUX_CL" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
