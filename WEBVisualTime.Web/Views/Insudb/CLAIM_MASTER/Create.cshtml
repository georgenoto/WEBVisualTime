@model WEBVisualTime.Servicios.Insudb.DTOs.CLAIM_MASTER.CreateCLAIM_MASTERDto

@{
    ViewData["Title"] = "Crear CLAIM_MASTER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <select asp-for="SCLIENT" class="form-select" asp-items="@(ViewData["SCLIENT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOVER" class="form-label"></label>
                <input asp-for="NCOVER" class="form-control" type="number" />
                <span asp-validation-for="NCOVER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SKEY" class="form-label"></label>
                <input asp-for="SKEY" class="form-control" />
                <span asp-validation-for="SKEY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SFILENAME" class="form-label"></label>
                <input asp-for="SFILENAME" class="form-control" />
                <span asp-validation-for="SFILENAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPROVIDER" class="form-label"></label>
                <input asp-for="NPROVIDER" class="form-control" type="number" />
                <span asp-validation-for="NPROVIDER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NOFFICE" class="form-label"></label>
                <input asp-for="NOFFICE" class="form-control" type="number" />
                <span asp-validation-for="NOFFICE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSTATUS" class="form-label"></label>
                <input asp-for="NSTATUS" class="form-control" type="number" />
                <span asp-validation-for="NSTATUS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATUS_PROC" class="form-label"></label>
                <input asp-for="SSTATUS_PROC" class="form-control" />
                <span asp-validation-for="SSTATUS_PROC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPAY_PROVIDER" class="form-label"></label>
                <input asp-for="NPAY_PROVIDER" class="form-control" type="number" />
                <span asp-validation-for="NPAY_PROVIDER" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
