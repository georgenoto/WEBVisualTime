@model WEBVisualTime.Servicios.Insudb.DTOs.CLAIM_MASTER.CLAIM_MASTERDto

@{
    ViewData["Title"] = "Eliminar CLAIM_MASTER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBORDEREAUX_CL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBORDEREAUX_CL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOVER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOVER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SFILENAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SFILENAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPROVIDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPROVIDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NOFFICE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NOFFICE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSTATUS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSTATUS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATUS_PROC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATUS_PROC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPAY_PROVIDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPAY_PROVIDER)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NBORDEREAUX_CL" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
