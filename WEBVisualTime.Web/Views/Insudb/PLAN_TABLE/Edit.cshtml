                <span asp-validation-for="OBJECT_NODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="OBJECT_OWNER" class="form-label"></label>
                <input asp-for="OBJECT_OWNER" class="form-control" />
                <span asp-validation-for="OBJECT_OWNER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="OBJECT_NAME" class="form-label"></label>
                <input asp-for="OBJECT_NAME" class="form-control" />
