@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_MODCLI.TAB_MODCLIDto

@{
    ViewData["Title"] = "Detalles de TAB_MODCLI";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SITEM</dt>
            <dd class="col-sm-9">@Model.SITEM</dd>
            <dt class="col-sm-3">STABNAME</dt>
            <dd class="col-sm-9">@Model.STABNAME</dd>
            <dt class="col-sm-3">SINDPK</dt>
            <dd class="col-sm-9">@Model.SINDPK</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SITEM" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
