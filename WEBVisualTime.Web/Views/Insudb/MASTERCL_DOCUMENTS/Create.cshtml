@model WEBVisualTime.Servicios.Insudb.DTOs.MASTERCL_DOCUMENTS.CreateMASTERCL_DOCUMENTSDto

@{
    ViewData["Title"] = "Crear MASTERCL_DOCUMENTS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NCASE_NUM" class="form-label"></label>
                <input asp-for="NCASE_NUM" class="form-control" type="number" />
                <span asp-validation-for="NCASE_NUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NDEMAN_TYPE" class="form-label"></label>
                <input asp-for="NDEMAN_TYPE" class="form-control" type="number" />
                <span asp-validation-for="NDEMAN_TYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <input asp-for="SCLIENT" class="form-control" />
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NID" class="form-label"></label>
                <input asp-for="NID" class="form-control" type="number" />
                <span asp-validation-for="NID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NDOC_CODE" class="form-label"></label>
                <input asp-for="NDOC_CODE" class="form-control" type="number" />
                <span asp-validation-for="NDOC_CODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCONSEC" class="form-label"></label>
                <input asp-for="NCONSEC" class="form-control" type="number" />
                <span asp-validation-for="NCONSEC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAPPLY" class="form-label"></label>
                <input asp-for="NAPPLY" class="form-control" type="number" />
                <span asp-validation-for="NAPPLY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
