@model WEBVisualTime.Servicios.Insudb.DTOs.SCHE_PCON.SCHE_PCONDto

@{
    ViewData["Title"] = "Detalles de SCHE_PCON";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SECUR_SCHE</dt>
            <dd class="col-sm-9">@Model.SECUR_SCHESLONGDESC</dd>
            <dt class="col-sm-3">TABLE293</dt>
            <dd class="col-sm-9">@Model.TABLE293SDESCRIPT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SSCHE_CODE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
