@model WEBVisualTime.Servicios.Insudb.DTOs.CLIALLOPRO.CLIALLOPRODto

@{
    ViewData["Title"] = "Detalles de CLIALLOPRO";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
            <dt class="col-sm-3">SPOLITYPE</dt>
            <dd class="col-sm-9">@Model.SPOLITYPE</dd>
            <dt class="col-sm-3">SCOMPON</dt>
            <dd class="col-sm-9">@Model.SCOMPON</dd>
            <dt class="col-sm-3">NROLE</dt>
            <dd class="col-sm-9">@Model.NROLE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">SDEFAULTI</dt>
            <dd class="col-sm-9">@Model.SDEFAULTI</dd>
            <dt class="col-sm-3">SREQUIRE</dt>
            <dd class="col-sm-9">@Model.SREQUIRE</dd>
            <dt class="col-sm-3">NMAX_ROLE</dt>
            <dd class="col-sm-9">@Model.NMAX_ROLE</dd>
