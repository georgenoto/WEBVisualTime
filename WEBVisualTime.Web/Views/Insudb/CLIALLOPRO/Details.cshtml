            <dt class="col-sm-3">DDATE_NROLE</dt>
            <dd class="col-sm-9">@Model.DDATE_NROLE</dd>
            <dt class="col-sm-3">NINTERMED</dt>
            <dd class="col-sm-9">@Model.NINTERMED</dd>
            <dt class="col-sm-3">NCONTRAT_PAY</dt>
            <dd class="col-sm-9">@Model.NCONTRAT_PAY</dd>
            <dt class="col-sm-3">SCLIENT</dt>
            <dd class="col-sm-9">@Model.SCLIENT</dd>
            <dt class="col-sm-3">SINSURABLE</dt>
            <dd class="col-sm-9">@Model.SINSURABLE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NBRANCH" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
