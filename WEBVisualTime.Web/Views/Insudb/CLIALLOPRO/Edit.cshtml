@model WEBVisualTime.Servicios.Insudb.DTOs.CLIALLOPRO.UpdateCLIALLOPRODto

@{
    ViewData["Title"] = "Editar CLIALLOPRO";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="SPOLITYPE" />
            <input type="hidden" asp-for="SCOMPON" />
            <input type="hidden" asp-for="NROLE" />
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDEFAULTI" class="form-label"></label>
                <input asp-for="SDEFAULTI" class="form-control" />
                <span asp-validation-for="SDEFAULTI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SREQUIRE" class="form-label"></label>
                <input asp-for="SREQUIRE" class="form-control" />
                <span asp-validation-for="SREQUIRE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMAX_ROLE" class="form-label"></label>
                <input asp-for="NMAX_ROLE" class="form-control" type="number" />
                <span asp-validation-for="NMAX_ROLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SOPTIONALQUO" class="form-label"></label>
                <input asp-for="SOPTIONALQUO" class="form-control" />
                <span asp-validation-for="SOPTIONALQUO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DDATE_NROLE" class="form-label"></label>
                <input asp-for="DDATE_NROLE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DDATE_NROLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINTERMED" class="form-label"></label>
                <input asp-for="NINTERMED" class="form-control" type="number" />
                <span asp-validation-for="NINTERMED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCONTRAT_PAY" class="form-label"></label>
                <input asp-for="NCONTRAT_PAY" class="form-control" type="number" />
                <span asp-validation-for="NCONTRAT_PAY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <input asp-for="SCLIENT" class="form-control" />
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SINSURABLE" class="form-label"></label>
                <input asp-for="SINSURABLE" class="form-control" />
                <span asp-validation-for="SINSURABLE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
