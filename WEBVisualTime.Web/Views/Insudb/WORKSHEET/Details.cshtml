@model WEBVisualTime.Servicios.Insudb.DTOs.WORKSHEET.WORKSHEETDto

@{
    ViewData["Title"] = "Detalles de WORKSHEET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NID</dt>
            <dd class="col-sm-9">@Model.NID</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
            <dt class="col-sm-3">NPOLICY</dt>
            <dd class="col-sm-9">@Model.NPOLICY</dd>
            <dt class="col-sm-3">SVALUESLIST</dt>
            <dd class="col-sm-9">@Model.SVALUESLIST</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NID" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
