@model WEBVisualTime.Servicios.Insudb.DTOs.APPUSER.APPUSERDto

@{
    ViewData["Title"] = "Detalles de APPUSER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NIDUSER</dt>
            <dd class="col-sm-9">@Model.NIDUSER</dd>
            <dt class="col-sm-3">SUSERNAME</dt>
            <dd class="col-sm-9">@Model.SUSERNAME</dd>
            <dt class="col-sm-3">SNAME</dt>
            <dd class="col-sm-9">@Model.SNAME</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NIDUSER" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
