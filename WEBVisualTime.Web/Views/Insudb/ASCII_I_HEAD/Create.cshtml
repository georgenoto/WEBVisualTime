@model WEBVisualTime.Servicios.Insudb.DTOs.ASCII_I_HEAD.CreateASCII_I_HEADDto

@{
    ViewData["Title"] = "Crear ASCII_I_HEAD";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NBANK_CODE" class="form-label"></label>
                <select asp-for="NBANK_CODE" class="form-select" asp-items="@(ViewData["NBANK_CODE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NBANK_CODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCONCEPT" class="form-label"></label>
                <select asp-for="NCONCEPT" class="form-select" asp-items="@(ViewData["NCONCEPT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NCONCEPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DSTAT_DATE" class="form-label"></label>
                <input asp-for="DSTAT_DATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DSTAT_DATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SACC_NUMBER" class="form-label"></label>
                <input asp-for="SACC_NUMBER" class="form-control" />
                <span asp-validation-for="SACC_NUMBER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAGENCY" class="form-label"></label>
                <select asp-for="NAGENCY" class="form-select" asp-items="@(ViewData["NAGENCY"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NAGENCY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATMOV" class="form-label"></label>
                <input asp-for="SSTATMOV" class="form-control" />
                <span asp-validation-for="SSTATMOV" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPAY_FORM" class="form-label"></label>
                <select asp-for="SPAY_FORM" class="form-select" asp-items="@(ViewData["SPAY_FORM"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SPAY_FORM" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
