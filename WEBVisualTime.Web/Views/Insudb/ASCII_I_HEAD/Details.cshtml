<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SASCII_NAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
