@model WEBVisualTime.Servicios.Insudb.DTOs.GROUPS.UpdateGROUPSDto

@{
    ViewData["Title"] = "Editar GROUPS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SCERTYPE" />
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPOLICY" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NGROUP" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <select asp-for="SCLIENT" class="form-select" asp-items="@(ViewData["SCLIENT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPARTICIP" class="form-label"></label>
                <input asp-for="NPARTICIP" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPARTICIP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPARTICIP_CO" class="form-label"></label>
                <input asp-for="NPARTICIP_CO" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPARTICIP_CO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT" class="form-label"></label>
                <input asp-for="NMOVEMENT" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT_NULL" class="form-label"></label>
                <input asp-for="NMOVEMENT_NULL" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT_NULL" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
