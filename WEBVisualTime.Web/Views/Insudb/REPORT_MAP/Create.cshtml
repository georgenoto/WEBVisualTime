@model WEBVisualTime.Servicios.Insudb.DTOs.REPORT_MAP.CreateREPORT_MAPDto

@{
    ViewData["Title"] = "Crear REPORT_MAP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NORDER" class="form-label"></label>
                <input asp-for="NORDER" class="form-control" type="number" />
                <span asp-validation-for="NORDER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCODIG" class="form-label"></label>
                <input asp-for="NCODIG" class="form-control" type="number" />
                <span asp-validation-for="NCODIG" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NORIGIN" class="form-label"></label>
                <input asp-for="NORIGIN" class="form-control" type="number" />
                <span asp-validation-for="NORIGIN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPE" class="form-label"></label>
                <input asp-for="NTYPE" class="form-control" type="number" />
                <span asp-validation-for="NTYPE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
