@model WEBVisualTime.Servicios.Insudb.DTOs.TOAD_PLAN_SQL.TOAD_PLAN_SQLDto

@{
    ViewData["Title"] = "Detalles de TOAD_PLAN_SQL";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">USERNAME</dt>
            <dd class="col-sm-9">@Model.USERNAME</dd>
            <dt class="col-sm-3">STATEMENT_ID</dt>
            <dd class="col-sm-9">@Model.STATEMENT_ID</dd>
            <dt class="col-sm-3">TIMESTAMP</dt>
            <dd class="col-sm-9">@Model.TIMESTAMP</dd>
            <dt class="col-sm-3">STATEMENT</dt>
            <dd class="col-sm-9">@Model.STATEMENT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.USERNAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
