@model WEBVisualTime.Servicios.Insudb.DTOs.TOAD_PLAN_SQL.CreateTOAD_PLAN_SQLDto

@{
    ViewData["Title"] = "Crear TOAD_PLAN_SQL";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="USERNAME" class="form-label"></label>
                <input asp-for="USERNAME" class="form-control" />
                <span asp-validation-for="USERNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STATEMENT_ID" class="form-label"></label>
                <input asp-for="STATEMENT_ID" class="form-control" />
                <span asp-validation-for="STATEMENT_ID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TIMESTAMP" class="form-label"></label>
                <input asp-for="TIMESTAMP" class="form-control" type="datetime-local" />
                <span asp-validation-for="TIMESTAMP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STATEMENT" class="form-label"></label>
                <input asp-for="STATEMENT" class="form-control" />
                <span asp-validation-for="STATEMENT" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
