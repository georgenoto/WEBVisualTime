@model WEBVisualTime.Servicios.Insudb.DTOs.CLASSPROPERTYWIN.CLASSPROPERTYWINDto

@{
    ViewData["Title"] = "Detalles de CLASSPROPERTYWIN";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">WINDOWS</dt>
            <dd class="col-sm-9">@Model.WINDOWSSCODISP</dd>
            <dt class="col-sm-3">NIDCLASS</dt>
            <dd class="col-sm-9">@Model.NIDCLASS</dd>
            <dt class="col-sm-3">PROPERTYLIBRARY</dt>
            <dd class="col-sm-9">@Model.PROPERTYLIBRARYSPROPERTY</dd>
            <dt class="col-sm-3">SVISIBLE</dt>
            <dd class="col-sm-9">@Model.SVISIBLE</dd>
            <dt class="col-sm-3">NORDEN</dt>
            <dd class="col-sm-9">@Model.NORDEN</dd>
            <dt class="col-sm-3">SCAPTION</dt>
            <dd class="col-sm-9">@Model.SCAPTION</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NWIDTH</dt>
            <dd class="col-sm-9">@Model.NWIDTH</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SKEY</dt>
            <dd class="col-sm-9">@Model.SKEY</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SCODISPL" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
