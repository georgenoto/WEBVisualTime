@model WEBVisualTime.Servicios.Insudb.DTOs.CLASSPROPERTYWIN.CLASSPROPERTYWINDto

@{
    ViewData["Title"] = "Eliminar CLASSPROPERTYWIN";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCODISPL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCODISPL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIDCLASS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIDCLASS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIDPROPERTY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIDPROPERTY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SVISIBLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SVISIBLE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NORDEN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NORDEN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCAPTION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCAPTION)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NWIDTH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NWIDTH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.SCODISPL" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
