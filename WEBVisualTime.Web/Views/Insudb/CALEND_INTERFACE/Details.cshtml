@model WEBVisualTime.Servicios.Insudb.DTOs.CALEND_INTERFACE.CALEND_INTERFACEDto

@{
    ViewData["Title"] = "Detalles de CALEND_INTERFACE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NSHEET</dt>
            <dd class="col-sm-9">@Model.NSHEET</dd>
            <dt class="col-sm-3">NID</dt>
            <dd class="col-sm-9">@Model.NID</dd>
            <dt class="col-sm-3">NDAY</dt>
            <dd class="col-sm-9">@Model.NDAY</dd>
            <dt class="col-sm-3">DDATEPROC</dt>
            <dd class="col-sm-9">@Model.DDATEPROC</dd>
            <dt class="col-sm-3">SHOUR</dt>
            <dd class="col-sm-9">@Model.SHOUR</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NSHEET" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
