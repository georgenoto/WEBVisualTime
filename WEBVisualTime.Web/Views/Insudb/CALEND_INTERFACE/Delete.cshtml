@model WEBVisualTime.Servicios.Insudb.DTOs.CALEND_INTERFACE.CALEND_INTERFACEDto

@{
    ViewData["Title"] = "Eliminar CALEND_INTERFACE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSHEET)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSHEET)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDAY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDAY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DDATEPROC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DDATEPROC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SHOUR)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SHOUR)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NSHEET" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
