@model WEBVisualTime.Servicios.Insudb.DTOs.TABLESHEET.TABLESHEETDto

@{
    ViewData["Title"] = "Detalles de TABLESHEET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NSHEET</dt>
            <dd class="col-sm-9">@Model.NSHEET</dd>
            <dt class="col-sm-3">STABLE</dt>
            <dd class="col-sm-9">@Model.STABLE</dd>
            <dt class="col-sm-3">SALIAS</dt>
            <dd class="col-sm-9">@Model.SALIAS</dd>
            <dt class="col-sm-3">NORDER</dt>
            <dd class="col-sm-9">@Model.NORDER</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("TABLESHEET", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
