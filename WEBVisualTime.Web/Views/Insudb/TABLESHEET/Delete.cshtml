@model WEBVisualTime.Servicios.Insudb.DTOs.TABLESHEET.TABLESHEETDto

@{
    ViewData["Title"] = "Eliminar TABLESHEET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSHEET)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSHEET)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STABLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STABLE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SALIAS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SALIAS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NORDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NORDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NSHEET" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
