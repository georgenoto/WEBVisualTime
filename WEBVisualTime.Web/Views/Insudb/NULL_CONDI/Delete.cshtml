@model WEBVisualTime.Servicios.Insudb.DTOs.NULL_CONDI.NULL_CONDIDto

@{
    ViewData["Title"] = "Eliminar NULL_CONDI";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBRANCH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBRANCH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPRODUCT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPRODUCT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NNULLCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NNULLCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEFFECDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEFFECDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAMELEVEL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAMELEVEL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SREGTYPEN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SREGTYPEN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SRETURN_IND)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SRETURN_IND)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NRETURN_RAT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NRETURN_RAT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DNULLDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DNULLDATE)</dd>
