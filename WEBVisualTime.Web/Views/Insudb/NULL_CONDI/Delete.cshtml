            <dd class="col-sm-9">@Html.DisplayFor(model => model.SNOTREHAB)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SREHAB_AUTO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SREHAB_AUTO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SROUTINE_PAY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SROUTINE_PAY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NRETRACTION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NRETRACTION)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NBRANCH" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
