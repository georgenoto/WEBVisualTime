@model WEBVisualTime.Servicios.Insudb.DTOs.HEALTHCLAIMFORM.HEALTHCLAIMFORMDto

@{
    ViewData["Title"] = "Eliminar HEALTHCLAIMFORM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CLIENTE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CLIENTE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IDRECLAMACION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IDRECLAMACION)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCASENUM)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCASENUM)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FORMULARIO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FORMULARIO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FECHACOMPUTADOR)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FECHACOMPUTADOR)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FORMID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FORMID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MODELID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.MODELID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.USERID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.USERID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CONTENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CONTENT)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.FORMID" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
