@model WEBVisualTime.Servicios.Insudb.DTOs.HEALTHCLAIMFORM.HEALTHCLAIMFORMDto

@{
    ViewData["Title"] = "Detalles de HEALTHCLAIMFORM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">CLIENTE</dt>
            <dd class="col-sm-9">@Model.CLIENTE</dd>
            <dt class="col-sm-3">IDRECLAMACION</dt>
            <dd class="col-sm-9">@Model.IDRECLAMACION</dd>
            <dt class="col-sm-3">NCASENUM</dt>
            <dd class="col-sm-9">@Model.NCASENUM</dd>
            <dt class="col-sm-3">FORMULARIO</dt>
            <dd class="col-sm-9">@Model.FORMULARIO</dd>
            <dt class="col-sm-3">FECHACOMPUTADOR</dt>
            <dd class="col-sm-9">@Model.FECHACOMPUTADOR</dd>
            <dt class="col-sm-3">FORMID</dt>
            <dd class="col-sm-9">@Model.FORMID</dd>
            <dt class="col-sm-3">MODELID</dt>
            <dd class="col-sm-9">@Model.MODELID</dd>
            <dt class="col-sm-3">USERID</dt>
            <dd class="col-sm-9">@Model.USERID</dd>
            <dt class="col-sm-3">CONTENT</dt>
            <dd class="col-sm-9">@Model.CONTENT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("HEALTHCLAIMFORM", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
