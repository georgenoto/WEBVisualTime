@model WEBVisualTime.Servicios.Insudb.DTOs.COMPANY.UpdateCOMPANYDto

@{
    ViewData["Title"] = "Editar COMPANY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NCOMPANY" />
            <div class="mb-3">
                <label asp-for="SACCOUNT" class="form-label"></label>
                <input asp-for="SACCOUNT" class="form-control" />
                <span asp-validation-for="SACCOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <select asp-for="SCLIENT" class="form-select cascade-select" data-cascade-parent="NCOUNTRY" data-cascade-url="@Url.Action("GetByNRESIDENCECOUNTRY", "CLIENT")" data-current-value="@Model.SCLIENT">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SBANKNAME" class="form-label"></label>
                <input asp-for="SBANKNAME" class="form-control" />
                <span asp-validation-for="SBANKNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOUNTRY" class="form-label"></label>
                <select asp-for="NCOUNTRY" class="form-select" asp-items="@(ViewData["NCOUNTRY"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NCOUNTRY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DINPDATE" class="form-label"></label>
                <input asp-for="DINPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DINPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTAXRATE" class="form-label"></label>
                <input asp-for="NTAXRATE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NTAXRATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STYPE" class="form-label"></label>
                <input asp-for="STYPE" class="form-control" />
                <span asp-validation-for="STYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SREGSVS" class="form-label"></label>
                <input asp-for="SREGSVS" class="form-control" />
                <span asp-validation-for="SREGSVS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SNATIONAL" class="form-label"></label>
                <input asp-for="SNATIONAL" class="form-control" />
                <span asp-validation-for="SNATIONAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCLASIFIC" class="form-label"></label>
                <select asp-for="NCLASIFIC" class="form-select" asp-items="@(ViewData["NCLASIFIC"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NCLASIFIC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SABA_ID" class="form-label"></label>
                <input asp-for="SABA_ID" class="form-control" />
                <span asp-validation-for="SABA_ID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SWIFT_IT" class="form-label"></label>
                <input asp-for="SWIFT_IT" class="form-control" />
                <span asp-validation-for="SWIFT_IT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLOCAL" class="form-label"></label>
                <select asp-for="NLOCAL" class="form-select" asp-items="@(ViewData["NLOCAL"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NLOCAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCITY" class="form-label"></label>
                <input asp-for="SCITY" class="form-control" />
                <span asp-validation-for="SCITY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBANKCOUNTRY" class="form-label"></label>
                <input asp-for="NBANKCOUNTRY" class="form-control" />
                <span asp-validation-for="NBANKCOUNTRY" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
