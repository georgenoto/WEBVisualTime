@model WEBVisualTime.Servicios.Insudb.DTOs.HOLLIDAYS.HOLLIDAYSDto

@{
    ViewData["Title"] = "Detalles de HOLLIDAYS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">TABLE7013</dt>
            <dd class="col-sm-9">@Model.TABLE7013SDESCRIPT</dd>
            <dt class="col-sm-3">NDAY</dt>
            <dd class="col-sm-9">@Model.NDAY</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NCOUNTRY</dt>
            <dd class="col-sm-9">@Model.NCOUNTRY</dd>
            <dt class="col-sm-3">NYEAR</dt>
            <dd class="col-sm-9">@Model.NYEAR</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("HOLLIDAYS", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
