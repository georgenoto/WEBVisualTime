@model WEBVisualTime.Servicios.Insudb.DTOs.TCOMMISS.TCOMMISSDto

@{
    ViewData["Title"] = "Detalles de TCOMMISS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SKEY</dt>
            <dd class="col-sm-9">@Model.SKEY</dd>
            <dt class="col-sm-3">NINTERMED</dt>
            <dd class="col-sm-9">@Model.NINTERMED</dd>
            <dt class="col-sm-3">NCOMMISSION</dt>
            <dd class="col-sm-9">@Model.NCOMMISSION</dd>
            <dt class="col-sm-3">NSHARE</dt>
            <dd class="col-sm-9">@Model.NSHARE</dd>
            <dt class="col-sm-3">NCURRENCY</dt>
            <dd class="col-sm-9">@Model.NCURRENCY</dd>
            <dt class="col-sm-3">NCOM_AFEC</dt>
            <dd class="col-sm-9">@Model.NCOM_AFEC</dd>
            <dt class="col-sm-3">NCOM_EXEN</dt>
            <dd class="col-sm-9">@Model.NCOM_EXEN</dd>
            <dt class="col-sm-3">NPERCENT</dt>
            <dd class="col-sm-9">@Model.NPERCENT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SKEY" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
