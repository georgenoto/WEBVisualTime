@model WEBVisualTime.Servicios.Insudb.DTOs.TCOMMISS.TCOMMISSDto

@{
    ViewData["Title"] = "Eliminar TCOMMISS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINTERMED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINTERMED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOMMISSION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOMMISSION)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSHARE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSHARE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCURRENCY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCURRENCY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOM_AFEC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOM_AFEC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOM_EXEN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOM_EXEN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPERCENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPERCENT)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.SKEY" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
