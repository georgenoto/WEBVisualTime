@model WEBVisualTime.Servicios.Insudb.DTOs.DISC_XPREM.CreateDISC_XPREMDto

@{
    ViewData["Title"] = "Crear DISC_XPREM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NAMOUNT" class="form-label"></label>
                <input asp-for="NAMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAMOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCURRENCY" class="form-label"></label>
                <input asp-for="NCURRENCY" class="form-control" type="number" />
                <span asp-validation-for="NCURRENCY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NNOTENUM" class="form-label"></label>
                <input asp-for="NNOTENUM" class="form-control" type="number" />
                <span asp-validation-for="NNOTENUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCAUSE" class="form-label"></label>
                <select asp-for="NCAUSE" class="form-select" asp-items="@(ViewData["NCAUSE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NCAUSE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SAGREE" class="form-label"></label>
                <input asp-for="SAGREE" class="form-control" />
                <span asp-validation-for="SAGREE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPERCENT" class="form-label"></label>
                <input asp-for="NPERCENT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPERCENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT" class="form-label"></label>
                <input asp-for="NMOVEMENT" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMOVEMENT_NULL" class="form-label"></label>
                <input asp-for="NMOVEMENT_NULL" class="form-control" type="number" />
                <span asp-validation-for="NMOVEMENT_NULL" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
