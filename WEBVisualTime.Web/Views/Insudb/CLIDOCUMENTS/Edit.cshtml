@model WEBVisualTime.Servicios.Insudb.DTOs.CLIDOCUMENTS.UpdateCLIDOCUMENTSDto

@{
    ViewData["Title"] = "Editar CLIDOCUMENTS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NTYPCLIENTDOC" />
            <input type="hidden" asp-for="SCLINUMDOCU" />
            <input type="hidden" asp-for="SCLIENT" />
            <div class="mb-3">
                <label asp-for="DISSUEDAT" class="form-label"></label>
                <input asp-for="DISSUEDAT" class="form-control" type="datetime-local" />
                <span asp-validation-for="DISSUEDAT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DEXPIRDAT" class="form-label"></label>
                <input asp-for="DEXPIRDAT" class="form-control" type="datetime-local" />
                <span asp-validation-for="DEXPIRDAT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCLASSTYPDOC" class="form-label"></label>
                <input asp-for="NCLASSTYPDOC" class="form-control" type="number" />
                <span asp-validation-for="NCLASSTYPDOC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPEXP" class="form-label"></label>
                <input asp-for="NTYPEXP" class="form-control" type="number" />
                <span asp-validation-for="NTYPEXP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SIDCOMPL" class="form-label"></label>
                <input asp-for="SIDCOMPL" class="form-control" />
                <span asp-validation-for="SIDCOMPL" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
