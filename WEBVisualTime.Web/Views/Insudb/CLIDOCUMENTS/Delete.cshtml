@model WEBVisualTime.Servicios.Insudb.DTOs.CLIDOCUMENTS.CLIDOCUMENTSDto

@{
    ViewData["Title"] = "Eliminar CLIDOCUMENTS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPCLIENTDOC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPCLIENTDOC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLINUMDOCU)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLINUMDOCU)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DISSUEDAT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DISSUEDAT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEXPIRDAT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEXPIRDAT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCLASSTYPDOC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCLASSTYPDOC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPEXP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPEXP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SIDCOMPL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SIDCOMPL)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NTYPCLIENTDOC" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
