@model WEBVisualTime.Servicios.Insudb.DTOs.MEDICALFEES.MEDICALFEESDto

@{
    ViewData["Title"] = "Detalles de MEDICALFEES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NIDMEDICALFEE</dt>
            <dd class="col-sm-9">@Model.NIDMEDICALFEE</dd>
            <dt class="col-sm-3">SBENEFITCODE</dt>
            <dd class="col-sm-9">@Model.SBENEFITCODE</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">NVALUE</dt>
            <dd class="col-sm-9">@Model.NVALUE</dd>
            <dt class="col-sm-3">NCURRENCY</dt>
            <dd class="col-sm-9">@Model.NCURRENCY</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SHOMOLOG_BENEFIT</dt>
            <dd class="col-sm-9">@Model.SHOMOLOG_BENEFIT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("MEDICALFEES", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
