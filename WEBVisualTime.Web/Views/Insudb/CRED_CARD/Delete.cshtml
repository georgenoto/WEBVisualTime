@model WEBVisualTime.Servicios.Insudb.DTOs.CRED_CARD.CRED_CARDDto

@{
    ViewData["Title"] = "Eliminar CRED_CARD";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBANKEXT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBANKEXT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCREDI_CARD)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCREDI_CARD)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCARD_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCARD_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCARDEXPIR)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCARDEXPIR)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STYP_DIRDEB)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STYP_DIRDEB)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCURRENCY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCURRENCY)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.SCLIENT" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
