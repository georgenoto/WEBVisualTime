@model WEBVisualTime.Servicios.Insudb.DTOs.MARGENREP.MARGENREPDto

@{
    ViewData["Title"] = "Eliminar MARGENREP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBRANCH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBRANCH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPRODUCT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPRODUCT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NREPTYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NREPTYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SLOGO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SLOGO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SLOG)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SLOG)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.X1)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.X1)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Y1)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Y1)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIMAGENX)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIMAGENX)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIMAGENY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIMAGENY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPOSIMGX)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPOSIMGX)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPOSIMGY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPOSIMGY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NRADIOCURVA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NRADIOCURVA)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSPACE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSPACE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NBRANCH" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
