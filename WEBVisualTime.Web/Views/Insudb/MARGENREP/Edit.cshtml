            </div>
            <div class="mb-3">
                <label asp-for="Y1" class="form-label"></label>
                <input asp-for="Y1" class="form-control" type="number" step="any" />
                <span asp-validation-for="Y1" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NIMAGENX" class="form-label"></label>
                <input asp-for="NIMAGENX" class="form-control" type="number" step="any" />
                <span asp-validation-for="NIMAGENX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NIMAGENY" class="form-label"></label>
                <input asp-for="NIMAGENY" class="form-control" type="number" step="any" />
                <span asp-validation-for="NIMAGENY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPOSIMGX" class="form-label"></label>
                <input asp-for="NPOSIMGX" class="form-control" type="number" step="any" />
