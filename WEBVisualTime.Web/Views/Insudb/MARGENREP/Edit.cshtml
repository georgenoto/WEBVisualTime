@model WEBVisualTime.Servicios.Insudb.DTOs.MARGENREP.UpdateMARGENREPDto

@{
    ViewData["Title"] = "Editar MARGENREP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
