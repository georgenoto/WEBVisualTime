@model WEBVisualTime.Servicios.Insudb.DTOs.DURPAY_PROD.UpdateDURPAY_PRODDto

@{
    ViewData["Title"] = "Editar DURPAY_PROD";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NID" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <div class="mb-3">
                <label asp-for="NIDURAFIX" class="form-label"></label>
                <input asp-for="NIDURAFIX" class="form-control" type="number" />
                <span asp-validation-for="NIDURAFIX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPDURAFIX" class="form-label"></label>
                <input asp-for="NPDURAFIX" class="form-control" type="number" />
                <span asp-validation-for="NPDURAFIX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPDURINS" class="form-label"></label>
                <select asp-for="NTYPDURINS" class="form-select" asp-items="@(ViewData["NTYPDURINS"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYPDURINS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPDURPAY" class="form-label"></label>
                <select asp-for="NTYPDURPAY" class="form-select" asp-items="@(ViewData["NTYPDURPAY"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYPDURPAY" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
