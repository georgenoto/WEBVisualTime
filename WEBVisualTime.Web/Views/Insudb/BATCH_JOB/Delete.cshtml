@model WEBVisualTime.Servicios.Insudb.DTOs.BATCH_JOB.BATCH_JOBDto

@{
    ViewData["Title"] = "Eliminar BATCH_JOB";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBATCH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBATCH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DSTART)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DSTART)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEND)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEND)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSTATUS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSTATUS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCOMMAND)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCOMMAND)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DSUBMIT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DSUBMIT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NORAJOB)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NORAJOB)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERSUBMIT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERSUBMIT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSHEET)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSHEET)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY_FATHER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY_FATHER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SOUTPUTFILE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SOUTPUTFILE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SFILE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SFILE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SVERIFIED_PLA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SVERIFIED_PLA)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.SKEY" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
