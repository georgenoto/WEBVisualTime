@model WEBVisualTime.Servicios.Insudb.DTOs.USERS.UpdateUSERSDto

@{
    ViewData["Title"] = "Editar USERS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NUSERCODE" />
            <div class="mb-3">
                <label asp-for="SACCESSWO" class="form-label"></label>
                <input asp-for="SACCESSWO" class="form-control" />
                <span asp-validation-for="SACCESSWO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NOFFICE" class="form-label"></label>
                <select asp-for="NOFFICE" class="form-select" asp-items="@(ViewData["NOFFICE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NOFFICE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <select asp-for="SCLIENT" class="form-select cascade-select" data-cascade-parent="NOFFICE" data-cascade-url="@Url.Action("GetByNOFFICE", "CLIENT")" data-current-value="@Model.SCLIENT">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SINITIALS" class="form-label"></label>
                <input asp-for="SINITIALS" class="form-control" />
                <span asp-validation-for="SINITIALS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSCHE_CODE" class="form-label"></label>
                <select asp-for="SSCHE_CODE" class="form-select" asp-items="@(ViewData["SSCHE_CODE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SSCHE_CODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STYPE" class="form-label"></label>
                <select asp-for="STYPE" class="form-select" asp-items="@(ViewData["STYPE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="STYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NDEPARTME" class="form-label"></label>
                <select asp-for="NDEPARTME" class="form-select" asp-items="@(ViewData["NDEPARTME"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NDEPARTME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SMENU" class="form-label"></label>
                <input asp-for="SMENU" class="form-control" />
                <span asp-validation-for="SMENU" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCHNEXTLOGON" class="form-label"></label>
                <input asp-for="SCHNEXTLOGON" class="form-control" />
                <span asp-validation-for="SCHNEXTLOGON" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SNEVERCHANGE" class="form-label"></label>
                <input asp-for="SNEVERCHANGE" class="form-control" />
                <span asp-validation-for="SNEVERCHANGE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SNEVEREXPIRES" class="form-label"></label>
                <input asp-for="SNEVEREXPIRES" class="form-control" />
                <span asp-validation-for="SNEVEREXPIRES" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SLOCKEDOUT" class="form-label"></label>
                <input asp-for="SLOCKEDOUT" class="form-control" />
                <span asp-validation-for="SLOCKEDOUT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DFROMDATE" class="form-label"></label>
                <input asp-for="DFROMDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DFROMDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NOFFICEAGEN" class="form-label"></label>
                <input asp-for="NOFFICEAGEN" class="form-control" type="number" />
                <span asp-validation-for="NOFFICEAGEN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAGENCY" class="form-label"></label>
                <input asp-for="NAGENCY" class="form-control" type="number" />
                <span asp-validation-for="NAGENCY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NFAILED_LOGON_ATTEMPTS" class="form-label"></label>
                <input asp-for="NFAILED_LOGON_ATTEMPTS" class="form-control" type="number" />
                <span asp-validation-for="NFAILED_LOGON_ATTEMPTS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DPASSWORD_EXPIRES" class="form-label"></label>
                <input asp-for="DPASSWORD_EXPIRES" class="form-control" type="datetime-local" />
                <span asp-validation-for="DPASSWORD_EXPIRES" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
