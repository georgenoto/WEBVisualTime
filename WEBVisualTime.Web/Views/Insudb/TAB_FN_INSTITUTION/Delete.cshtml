@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_FN_INSTITUTION.TAB_FN_INSTITUTIONDto

@{
    ViewData["Title"] = "Eliminar TAB_FN_INSTITUTION";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINSTITUTION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINSTITUTION)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPEINSTITU)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPEINSTITU)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SNAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SNAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SINSTITUTION)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SINSTITUTION)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLIENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLIENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDIGIT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDIGIT)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NINSTITUTION" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
