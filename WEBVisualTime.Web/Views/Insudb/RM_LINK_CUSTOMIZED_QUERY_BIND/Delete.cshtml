@model WEBVisualTime.Servicios.Insudb.DTOs.RM_LINK_CUSTOMIZED_QUERY_BIND.RM_LINK_CUSTOMIZED_QUERY_BINDDto

@{
    ViewData["Title"] = "Eliminar RM_LINK_CUSTOMIZED_QUERY_BIND";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.QUERY_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.QUERY_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.BIND_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.BIND_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.BIND_PROPERTY_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.BIND_PROPERTY_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.BIND_SEQUENCE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.BIND_SEQUENCE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.QUERY_NAME" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
