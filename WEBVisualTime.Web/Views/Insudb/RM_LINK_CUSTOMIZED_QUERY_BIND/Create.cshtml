@model WEBVisualTime.Servicios.Insudb.DTOs.RM_LINK_CUSTOMIZED_QUERY_BIND.CreateRM_LINK_CUSTOMIZED_QUERY_BINDDto

@{
    ViewData["Title"] = "Crear RM_LINK_CUSTOMIZED_QUERY_BIND";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="QUERY_NAME" class="form-label"></label>
                <input asp-for="QUERY_NAME" class="form-control" />
                <span asp-validation-for="QUERY_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BIND_NAME" class="form-label"></label>
                <input asp-for="BIND_NAME" class="form-control" />
                <span asp-validation-for="BIND_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BIND_PROPERTY_NAME" class="form-label"></label>
                <input asp-for="BIND_PROPERTY_NAME" class="form-control" />
                <span asp-validation-for="BIND_PROPERTY_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="BIND_SEQUENCE" class="form-label"></label>
                <input asp-for="BIND_SEQUENCE" class="form-control" type="number" />
                <span asp-validation-for="BIND_SEQUENCE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
