@model WEBVisualTime.Servicios.Insudb.DTOs.T_INTERFACE.T_INTERFACEDto

@{
    ViewData["Title"] = "Eliminar T_INTERFACE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NROW)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NROW)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOLUMN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOLUMN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SVALUE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SVALUE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STABLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STABLE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SPROCESS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SPROCESS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NFIELD)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NFIELD)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SVALUE_HOMO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SVALUE_HOMO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SFIELDDESC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SFIELDDESC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDATATYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDATATYPE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.SKEY" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
