@model WEBVisualTime.Servicios.Insudb.DTOs.MASSIVE_RULES.CreateMASSIVE_RULESDto

@{
    ViewData["Title"] = "Crear MASSIVE_RULES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NERRORNUM" class="form-label"></label>
                <input asp-for="NERRORNUM" class="form-control" type="number" />
                <span asp-validation-for="NERRORNUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SERRORTYP" class="form-label"></label>
                <select asp-for="SERRORTYP" class="form-select" asp-items="@(ViewData["SERRORTYP"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SERRORTYP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SBREAK" class="form-label"></label>
                <input asp-for="SBREAK" class="form-control" />
                <span asp-validation-for="SBREAK" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SENABLED" class="form-label"></label>
                <input asp-for="SENABLED" class="form-control" />
                <span asp-validation-for="SENABLED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBRANCH" class="form-label"></label>
                <input asp-for="NBRANCH" class="form-control" type="number" />
                <span asp-validation-for="NBRANCH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPRODUCT" class="form-label"></label>
                <input asp-for="NPRODUCT" class="form-control" type="number" />
                <span asp-validation-for="NPRODUCT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NACTIONPROC" class="form-label"></label>
                <input asp-for="NACTIONPROC" class="form-control" type="number" />
                <span asp-validation-for="NACTIONPROC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SVIP" class="form-label"></label>
                <input asp-for="SVIP" class="form-control" />
                <span asp-validation-for="SVIP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STYP_CONDI" class="form-label"></label>
                <select asp-for="STYP_CONDI" class="form-select" asp-items="@(ViewData["STYP_CONDI"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="STYP_CONDI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSECTION" class="form-label"></label>
                <select asp-for="NSECTION" class="form-select" asp-items="@(ViewData["NSECTION"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NSECTION" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
