@model WEBVisualTime.Servicios.Insudb.DTOs.LEVELS.UpdateLEVELSDto

@{
    ViewData["Title"] = "Editar LEVELS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SSCHE_CODE" />
            <input type="hidden" asp-for="SIND_TYPE" />
            <input type="hidden" asp-for="SCODE_MT" />
            <div class="mb-3">
                <label asp-for="NAMELEVEL" class="form-label"></label>
                <input asp-for="NAMELEVEL" class="form-control" type="number" />
                <span asp-validation-for="NAMELEVEL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINQLEVEL" class="form-label"></label>
                <input asp-for="NINQLEVEL" class="form-control" type="number" />
                <span asp-validation-for="NINQLEVEL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSUPERVIS" class="form-label"></label>
                <input asp-for="SSUPERVIS" class="form-control" />
                <span asp-validation-for="SSUPERVIS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPERMITTED" class="form-label"></label>
                <input asp-for="SPERMITTED" class="form-control" />
                <span asp-validation-for="SPERMITTED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SENCRYPTED" class="form-label"></label>
                <input asp-for="SENCRYPTED" class="form-control" />
                <span asp-validation-for="SENCRYPTED" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
