}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">STATEMENT_ID</dt>
            <dd class="col-sm-9">@Model.STATEMENT_ID</dd>
            <dt class="col-sm-3">TIMESTAMP</dt>
            <dd class="col-sm-9">@Model.TIMESTAMP</dd>
            <dt class="col-sm-3">REMARKS</dt>
            <dd class="col-sm-9">@Model.REMARKS</dd>
            <dt class="col-sm-3">OPERATION</dt>
