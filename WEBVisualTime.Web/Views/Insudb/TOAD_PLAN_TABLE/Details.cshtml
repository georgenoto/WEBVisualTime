            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.ID</dd>
            <dt class="col-sm-3">COST</dt>
            <dd class="col-sm-9">@Model.COST</dd>
            <dt class="col-sm-3">PARENT_ID</dt>
            <dd class="col-sm-9">@Model.PARENT_ID</dd>
            <dt class="col-sm-3">POSITION</dt>
            <dd class="col-sm-9">@Model.POSITION</dd>
            <dt class="col-sm-3">CARDINALITY</dt>
