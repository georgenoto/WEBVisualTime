            <dt class="col-sm-3">PARTITION_ID</dt>
            <dd class="col-sm-9">@Model.PARTITION_ID</dd>
            <dt class="col-sm-3">PARTITION_START</dt>
            <dd class="col-sm-9">@Model.PARTITION_START</dd>
            <dt class="col-sm-3">PARTITION_STOP</dt>
            <dd class="col-sm-9">@Model.PARTITION_STOP</dd>
            <dt class="col-sm-3">DISTRIBUTION</dt>
            <dd class="col-sm-9">@Model.DISTRIBUTION</dd>
            <dt class="col-sm-3">OTHER</dt>
            <dd class="col-sm-9">@Model.OTHER</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
