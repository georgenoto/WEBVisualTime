@model IEnumerable<WEBVisualTime.Servicios.Insudb.DTOs.TRACE.TRACEDto>

@{
    ViewData["Title"] = "TRACE";
    ViewData["ColumnHeaders"] = new[] { "ID", "PROC", "NUSERCODE", "TEXT" };
    ViewData["ColumnProperties"] = new[] { "ID", "PROC", "NUSERCODE", "TEXT" };
    ViewData["KeyName"] = "ID";
    ViewData["PageSize"] = 20;
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<p><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear Nuevo</a></p>

@await Html.PartialAsync("_DataTable", Model)

@section Scripts {
    <script>initDataTables();</script>
}
