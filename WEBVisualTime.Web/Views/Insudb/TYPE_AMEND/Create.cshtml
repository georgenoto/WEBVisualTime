@model WEBVisualTime.Servicios.Insudb.DTOs.TYPE_AMEND.CreateTYPE_AMENDDto

@{
    ViewData["Title"] = "Crear TYPE_AMEND";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SIND_ORDER_SERV" class="form-label"></label>
                <input asp-for="SIND_ORDER_SERV" class="form-control" />
                <span asp-validation-for="SIND_ORDER_SERV" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <select asp-for="NUSERCODE" class="form-select" asp-items="@(ViewData["NUSERCODE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPEISSUE" class="form-label"></label>
                <select asp-for="NTYPEISSUE" class="form-select" asp-items="@(ViewData["NTYPEISSUE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYPEISSUE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLEVEL" class="form-label"></label>
                <input asp-for="NLEVEL" class="form-control" type="number" />
                <span asp-validation-for="NLEVEL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SRETARIF" class="form-label"></label>
                <input asp-for="SRETARIF" class="form-control" />
                <span asp-validation-for="SRETARIF" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPE_EV_ENDOR" class="form-label"></label>
                <select asp-for="NTYPE_EV_ENDOR" class="form-select" asp-items="@(ViewData["NTYPE_EV_ENDOR"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYPE_EV_ENDOR" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SRESOLUTION" class="form-label"></label>
                <input asp-for="SRESOLUTION" class="form-control" />
                <span asp-validation-for="SRESOLUTION" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SGOVAPRNAME" class="form-label"></label>
                <input asp-for="SGOVAPRNAME" class="form-control" />
                <span asp-validation-for="SGOVAPRNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DRESDATE" class="form-label"></label>
                <input asp-for="DRESDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DRESDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCONDSVS" class="form-label"></label>
                <input asp-for="SCONDSVS" class="form-control" />
                <span asp-validation-for="SCONDSVS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPEA_AMEND" class="form-label"></label>
                <input asp-for="NTYPEA_AMEND" class="form-control" type="number" />
                <span asp-validation-for="NTYPEA_AMEND" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSHOWSTATUS" class="form-label"></label>
                <input asp-for="SSHOWSTATUS" class="form-control" />
                <span asp-validation-for="SSHOWSTATUS" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
