@model WEBVisualTime.Servicios.Insudb.DTOs.LATEPAYMENTPENALTY.UpdateLATEPAYMENTPENALTYDto

@{
    ViewData["Title"] = "Editar LATEPAYMENTPENALTY";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NDAY_INI" />
            <input type="hidden" asp-for="DEFFECTDATE" />
            <div class="mb-3">
                <label asp-for="NDAY_END" class="form-label"></label>
                <input asp-for="NDAY_END" class="form-control" type="number" />
                <span asp-validation-for="NDAY_END" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NDAYSPENALTY" class="form-label"></label>
                <input asp-for="NDAYSPENALTY" class="form-control" type="number" />
                <span asp-validation-for="NDAYSPENALTY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
