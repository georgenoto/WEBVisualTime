@model WEBVisualTime.Servicios.Insudb.DTOs.NUMERATOR.NUMERATORDto

@{
    ViewData["Title"] = "Detalles de NUMERATOR";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NTYPENUM</dt>
            <dd class="col-sm-9">@Model.NTYPENUM</dd>
            <dt class="col-sm-3">NORD_NUM</dt>
            <dd class="col-sm-9">@Model.NORD_NUM</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NEND_NUM</dt>
            <dd class="col-sm-9">@Model.NEND_NUM</dd>
            <dt class="col-sm-3">NINITIAL</dt>
            <dd class="col-sm-9">@Model.NINITIAL</dd>
            <dt class="col-sm-3">NLASTNUMB</dt>
            <dd class="col-sm-9">@Model.NLASTNUMB</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NTYPENUM" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
