@model WEBVisualTime.Servicios.Insudb.DTOs.SPORT.SPORTDto

@{
    ViewData["Title"] = "Detalles de SPORT";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">TABLE512</dt>
            <dd class="col-sm-9">@Model.TABLE512SDESCRIPT</dd>
            <dt class="col-sm-3">CLIENT</dt>
            <dd class="col-sm-9">@Model.CLIENTSACCOUNT_IN</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NSPORT" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
