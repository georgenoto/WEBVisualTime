@model WEBVisualTime.Servicios.Insudb.DTOs.COMM_TOT.COMM_TOTDto

@{
    ViewData["Title"] = "Detalles de COMM_TOT";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">INTERMEDIA</dt>
            <dd class="col-sm-9">@Model.INTERMEDIASCOL_AGREE</dd>
            <dt class="col-sm-3">NRECEIPT</dt>
            <dd class="col-sm-9">@Model.NRECEIPT</dd>
            <dt class="col-sm-3">CERTIFICATSCERTYPE</dt>
            <dd class="col-sm-9">@Model.CERTIFICATSCERTYPESCUMUL_CODE</dd>
            <dt class="col-sm-3">CERTIFICATNBRANCH</dt>
            <dd class="col-sm-9">@Model.CERTIFICATNBRANCHSCUMUL_CODE</dd>
            <dt class="col-sm-3">CERTIFICATNPRODUCT</dt>
            <dd class="col-sm-9">@Model.CERTIFICATNPRODUCTSCUMUL_CODE</dd>
            <dt class="col-sm-3">CERTIFICATNPOLICY</dt>
            <dd class="col-sm-9">@Model.CERTIFICATNPOLICYSCUMUL_CODE</dd>
            <dt class="col-sm-3">CERTIFICATNCERTIF</dt>
            <dd class="col-sm-9">@Model.CERTIFICATNCERTIFSCUMUL_CODE</dd>
            <dt class="col-sm-3">NDIGIT</dt>
            <dd class="col-sm-9">@Model.NDIGIT</dd>
            <dt class="col-sm-3">NPAYNUMBE</dt>
            <dd class="col-sm-9">@Model.NPAYNUMBE</dd>
            <dt class="col-sm-3">NCOMM</dt>
            <dd class="col-sm-9">@Model.NCOMM</dd>
            <dt class="col-sm-3">NMOVNUMBE</dt>
            <dd class="col-sm-9">@Model.NMOVNUMBE</dd>
            <dt class="col-sm-3">NTOTALPREMIUM</dt>
            <dd class="col-sm-9">@Model.NTOTALPREMIUM</dd>
            <dt class="col-sm-3">NTOTALCOMM</dt>
            <dd class="col-sm-9">@Model.NTOTALCOMM</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NCOMM" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
