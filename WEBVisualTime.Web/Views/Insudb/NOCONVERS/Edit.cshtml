@model WEBVisualTime.Servicios.Insudb.DTOs.NOCONVERS.UpdateNOCONVERSDto

@{
    ViewData["Title"] = "Editar NOCONVERS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NNO_CONVERS" />
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAREAWAIT" class="form-label"></label>
                <select asp-for="NAREAWAIT" class="form-select" asp-items="@(ViewData["NAREAWAIT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NAREAWAIT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDEVO" class="form-label"></label>
                <input asp-for="SDEVO" class="form-control" />
                <span asp-validation-for="SDEVO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDISC" class="form-label"></label>
                <input asp-for="SDISC" class="form-control" />
                <span asp-validation-for="SDISC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NEXPENSES" class="form-label"></label>
                <input asp-for="NEXPENSES" class="form-control" type="number" step="any" />
                <span asp-validation-for="NEXPENSES" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SROUTINE" class="form-label"></label>
                <input asp-for="SROUTINE" class="form-control" />
                <span asp-validation-for="SROUTINE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NHEALTHEXP" class="form-label"></label>
                <input asp-for="NHEALTHEXP" class="form-control" type="number" step="any" />
                <span asp-validation-for="NHEALTHEXP" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
