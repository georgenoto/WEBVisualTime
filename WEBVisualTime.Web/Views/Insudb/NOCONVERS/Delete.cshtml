@model WEBVisualTime.Servicios.Insudb.DTOs.NOCONVERS.NOCONVERSDto

@{
    ViewData["Title"] = "Eliminar NOCONVERS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NNO_CONVERS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NNO_CONVERS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDESCRIPT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDESCRIPT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAREAWAIT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAREAWAIT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDEVO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDEVO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDISC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDISC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NEXPENSES)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NEXPENSES)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SROUTINE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SROUTINE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NHEALTHEXP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NHEALTHEXP)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NNO_CONVERS" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
