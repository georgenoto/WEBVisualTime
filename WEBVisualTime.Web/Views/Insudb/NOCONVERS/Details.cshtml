@model WEBVisualTime.Servicios.Insudb.DTOs.NOCONVERS.NOCONVERSDto

@{
    ViewData["Title"] = "Detalles de NOCONVERS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NNO_CONVERS</dt>
            <dd class="col-sm-9">@Model.NNO_CONVERS</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">TABLE5603</dt>
            <dd class="col-sm-9">@Model.TABLE5603SDESCRIPT</dd>
            <dt class="col-sm-3">SDEVO</dt>
            <dd class="col-sm-9">@Model.SDEVO</dd>
            <dt class="col-sm-3">SDISC</dt>
            <dd class="col-sm-9">@Model.SDISC</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">NEXPENSES</dt>
            <dd class="col-sm-9">@Model.NEXPENSES</dd>
            <dt class="col-sm-3">SROUTINE</dt>
            <dd class="col-sm-9">@Model.SROUTINE</dd>
            <dt class="col-sm-3">NHEALTHEXP</dt>
            <dd class="col-sm-9">@Model.NHEALTHEXP</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NNO_CONVERS" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
