@model WEBVisualTime.Servicios.Insudb.DTOs.REPORT_PROD.REPORT_PRODDto

@{
    ViewData["Title"] = "Detalles de REPORT_PROD";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">WINDOWS</dt>
            <dd class="col-sm-9">@Model.WINDOWSSCODISP</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">NREPTYPE</dt>
            <dd class="col-sm-9">@Model.NREPTYPE</dd>
            <dt class="col-sm-3">NTRATYPEP</dt>
            <dd class="col-sm-9">@Model.NTRATYPEP</dd>
            <dt class="col-sm-3">SREPORT</dt>
            <dd class="col-sm-9">@Model.SREPORT</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("REPORT_PROD", Model))" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
