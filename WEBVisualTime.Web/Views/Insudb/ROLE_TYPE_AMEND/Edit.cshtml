@model WEBVisualTime.Servicios.Insudb.DTOs.ROLE_TYPE_AMEND.UpdateROLE_TYPE_AMENDDto

@{
    ViewData["Title"] = "Editar ROLE_TYPE_AMEND";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <input type="hidden" asp-for="NTYPE_AMEND" />
            <input type="hidden" asp-for="NROLEID" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
