@model WEBVisualTime.Servicios.Insudb.DTOs.PAY_FRACTI.PAY_FRACTIDto

@{
    ViewData["Title"] = "Detalles de PAY_FRACTI";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
            <dt class="col-sm-3">TABLE36</dt>
            <dd class="col-sm-9">@Model.TABLE36SDESCRIPT</dd>
            <dt class="col-sm-3">NQUOTA</dt>
            <dd class="col-sm-9">@Model.NQUOTA</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">NRATEPAYF</dt>
            <dd class="col-sm-9">@Model.NRATEPAYF</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NBRANCH" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
