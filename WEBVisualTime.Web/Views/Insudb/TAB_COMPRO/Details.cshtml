@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_COMPRO.TAB_COMPRODto

@{
    ViewData["Title"] = "Detalles de TAB_COMPRO";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">TABLE6</dt>
            <dd class="col-sm-9">@Model.TABLE6SDESCRIPT</dd>
            <dt class="col-sm-3">NLINE</dt>
            <dd class="col-sm-9">@Model.NLINE</dd>
            <dt class="col-sm-3">NTYP_ACCO</dt>
            <dd class="col-sm-9">@Model.NTYP_ACCO</dd>
            <dt class="col-sm-3">SDEBITSIDE</dt>
            <dd class="col-sm-9">@Model.SDEBITSIDE</dd>
            <dt class="col-sm-3">TABLE532</dt>
            <dd class="col-sm-9">@Model.TABLE532SDESCRIPT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NTYPE_TRAN" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
