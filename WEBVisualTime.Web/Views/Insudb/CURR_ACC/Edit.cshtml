@model WEBVisualTime.Servicios.Insudb.DTOs.CURR_ACC.UpdateCURR_ACCDto

@{
    ViewData["Title"] = "Editar CURR_ACC";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NTYP_ACCO" />
            <input type="hidden" asp-for="STYPE_ACC" />
            <input type="hidden" asp-for="SCLIENT" />
            <input type="hidden" asp-for="NCURRENCY" />
            <div class="mb-3">
                <label asp-for="NBALANCE" class="form-label"></label>
                <input asp-for="NBALANCE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NBALANCE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCREDIT" class="form-label"></label>
                <input asp-for="NCREDIT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCREDIT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NDEBIT" class="form-label"></label>
                <input asp-for="NDEBIT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NDEBIT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DEFFECDATE" class="form-label"></label>
                <input asp-for="DEFFECDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DEFFECDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLED_COMPAN" class="form-label"></label>
                <select asp-for="NLED_COMPAN" class="form-select" asp-items="@(ViewData["NLED_COMPAN"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NLED_COMPAN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SACCOUNT" class="form-label"></label>
                <select asp-for="SACCOUNT" class="form-select" asp-items="@(ViewData["SACCOUNT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SACCOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCERTYPE" class="form-label"></label>
                <select asp-for="SCERTYPE" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-parameter="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.SCERTYPE">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCERTYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOMPANY" class="form-label"></label>
                <select asp-for="NCOMPANY" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-parameter="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "COMPANY")" data-current-value="@Model.NCOMPANY">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NCOMPANY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPRODUCT" class="form-label"></label>
                <select asp-for="NPRODUCT" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-parameter="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NPRODUCT">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NPRODUCT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SAUX_ACCOUN" class="form-label"></label>
                <select asp-for="SAUX_ACCOUN" class="form-select" asp-items="@(ViewData["SAUX_ACCOUN"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SAUX_ACCOUN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBRANCH" class="form-label"></label>
                <select asp-for="NBRANCH" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-parameter="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NBRANCH">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NBRANCH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCERTIF" class="form-label"></label>
                <select asp-for="NCERTIF" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-parameter="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NCERTIF">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NCERTIF" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPOLICY" class="form-label"></label>
                <select asp-for="NPOLICY" class="form-select cascade-select" data-cascade-parent="SCLIENT" data-cascade-parameter="SCLIENT" data-cascade-url="@Url.Action("GetBySCLIENT", "CERTIFICAT")" data-current-value="@Model.NPOLICY">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NPOLICY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINSUR_AREA" class="form-label"></label>
                <select asp-for="NINSUR_AREA" class="form-select" asp-items="@(ViewData["NINSUR_AREA"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NINSUR_AREA" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
