@model WEBVisualTime.Servicios.Insudb.DTOs.COVER_QUOTA.UpdateCOVER_QUOTADto

@{
    ViewData["Title"] = "Editar COVER_QUOTA";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="SCERTYPE" />
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NPOLICY" />
            <input type="hidden" asp-for="NGROUP" />
            <input type="hidden" asp-for="NMODULEC" />
            <input type="hidden" asp-for="NROLE" />
            <input type="hidden" asp-for="NCOVER" />
            <div class="mb-3">
                <label asp-for="NCAPITAL" class="form-label"></label>
                <input asp-for="NCAPITAL" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCAPITAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTAXIVA" class="form-label"></label>
                <input asp-for="NTAXIVA" class="form-control" type="number" step="any" />
                <span asp-validation-for="NTAXIVA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTAX" class="form-label"></label>
                <input asp-for="NTAX" class="form-control" type="number" step="any" />
                <span asp-validation-for="NTAX" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPREMIUM" class="form-label"></label>
                <input asp-for="NPREMIUM" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPREMIUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINSUCOUNT" class="form-label"></label>
                <input asp-for="NINSUCOUNT" class="form-control" type="number" />
                <span asp-validation-for="NINSUCOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINSURED" class="form-label"></label>
                <input asp-for="NINSURED" class="form-control" type="number" />
                <span asp-validation-for="NINSURED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCERTIF" class="form-label"></label>
                <input asp-for="NCERTIF" class="form-control" type="number" />
                <span asp-validation-for="NCERTIF" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
