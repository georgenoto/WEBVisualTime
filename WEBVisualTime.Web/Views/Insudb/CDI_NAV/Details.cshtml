@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_NAV.CDI_NAVDto

@{
    ViewData["Title"] = "Detalles de CDI_NAV";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NAV_TYPE</dt>
            <dd class="col-sm-9">@Model.NAV_TYPE</dd>
            <dt class="col-sm-3">NAV_FNAME</dt>
            <dd class="col-sm-9">@Model.NAV_FNAME</dd>
            <dt class="col-sm-3">NAV_NAME</dt>
            <dd class="col-sm-9">@Model.NAV_NAME</dd>
            <dt class="col-sm-3">NAV_BTNAME</dt>
            <dd class="col-sm-9">@Model.NAV_BTNAME</dd>
            <dt class="col-sm-3">NAV_CNAME</dt>
            <dd class="col-sm-9">@Model.NAV_CNAME</dd>
            <dt class="col-sm-3">NAV_REF_BTNAME</dt>
            <dd class="col-sm-9">@Model.NAV_REF_BTNAME</dd>
            <dt class="col-sm-3">NAV_REF_CNAME</dt>
            <dd class="col-sm-9">@Model.NAV_REF_CNAME</dd>
            <dt class="col-sm-3">NAV_SEQ</dt>
            <dd class="col-sm-9">@Model.NAV_SEQ</dd>
            <dt class="col-sm-3">NAV_ASSOC_END</dt>
            <dd class="col-sm-9">@Model.NAV_ASSOC_END</dd>
            <dt class="col-sm-3">NAV_DESCRIPTION</dt>
            <dd class="col-sm-9">@Model.NAV_DESCRIPTION</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NAV_TYPE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
