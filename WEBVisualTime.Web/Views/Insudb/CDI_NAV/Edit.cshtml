@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_NAV.UpdateCDI_NAVDto

@{
    ViewData["Title"] = "Editar CDI_NAV";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NAV_TYPE" class="form-label"></label>
                <input asp-for="NAV_TYPE" class="form-control" />
                <span asp-validation-for="NAV_TYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_FNAME" class="form-label"></label>
                <input asp-for="NAV_FNAME" class="form-control" />
                <span asp-validation-for="NAV_FNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_NAME" class="form-label"></label>
                <input asp-for="NAV_NAME" class="form-control" />
                <span asp-validation-for="NAV_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_BTNAME" class="form-label"></label>
                <input asp-for="NAV_BTNAME" class="form-control" />
                <span asp-validation-for="NAV_BTNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_CNAME" class="form-label"></label>
                <input asp-for="NAV_CNAME" class="form-control" />
                <span asp-validation-for="NAV_CNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_REF_BTNAME" class="form-label"></label>
                <input asp-for="NAV_REF_BTNAME" class="form-control" />
                <span asp-validation-for="NAV_REF_BTNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_REF_CNAME" class="form-label"></label>
                <input asp-for="NAV_REF_CNAME" class="form-control" />
                <span asp-validation-for="NAV_REF_CNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_SEQ" class="form-label"></label>
                <input asp-for="NAV_SEQ" class="form-control" type="number" />
                <span asp-validation-for="NAV_SEQ" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_ASSOC_END" class="form-label"></label>
                <input asp-for="NAV_ASSOC_END" class="form-control" />
                <span asp-validation-for="NAV_ASSOC_END" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAV_DESCRIPTION" class="form-label"></label>
                <input asp-for="NAV_DESCRIPTION" class="form-control" />
                <span asp-validation-for="NAV_DESCRIPTION" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
