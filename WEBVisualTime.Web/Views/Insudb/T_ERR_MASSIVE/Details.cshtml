@model WEBVisualTime.Servicios.Insudb.DTOs.T_ERR_MASSIVE.T_ERR_MASSIVEDto

@{
    ViewData["Title"] = "Detalles de T_ERR_MASSIVE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SKEY</dt>
            <dd class="col-sm-9">@Model.SKEY</dd>
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
            <dt class="col-sm-3">NPOLICY</dt>
            <dd class="col-sm-9">@Model.NPOLICY</dd>
            <dt class="col-sm-3">NCERTIF</dt>
            <dd class="col-sm-9">@Model.NCERTIF</dd>
            <dt class="col-sm-3">NERROR</dt>
            <dd class="col-sm-9">@Model.NERROR</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">SCERTYPE</dt>
            <dd class="col-sm-9">@Model.SCERTYPE</dd>
            <dt class="col-sm-3">SCLIENT</dt>
            <dd class="col-sm-9">@Model.SCLIENT</dd>
            <dt class="col-sm-3">NSEQ</dt>
            <dd class="col-sm-9">@Model.NSEQ</dd>
            <dt class="col-sm-3">STYPE</dt>
            <dd class="col-sm-9">@Model.STYPE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SKEY" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
