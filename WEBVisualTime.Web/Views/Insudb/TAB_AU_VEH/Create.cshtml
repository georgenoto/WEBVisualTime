@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_AU_VEH.CreateTAB_AU_VEHDto

@{
    ViewData["Title"] = "Crear TAB_AU_VEH";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NNATIONAL" class="form-label"></label>
                <input asp-for="NNATIONAL" class="form-control" type="number" />
                <span asp-validation-for="NNATIONAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NVEHBRAND" class="form-label"></label>
                <input asp-for="NVEHBRAND" class="form-control" type="number" />
                <span asp-validation-for="NVEHBRAND" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SVEHMODEL" class="form-label"></label>
                <input asp-for="SVEHMODEL" class="form-control" />
                <span asp-validation-for="SVEHMODEL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NVEHTYPE" class="form-label"></label>
                <select asp-for="NVEHTYPE" class="form-select" asp-items="@(ViewData["NVEHTYPE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NVEHTYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NVEHPLACE" class="form-label"></label>
                <input asp-for="NVEHPLACE" class="form-control" type="number" />
                <span asp-validation-for="NVEHPLACE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NVEHPMA" class="form-label"></label>
                <input asp-for="NVEHPMA" class="form-control" type="number" />
                <span asp-validation-for="NVEHPMA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSOAP_VEHTYPE" class="form-label"></label>
                <input asp-for="NSOAP_VEHTYPE" class="form-control" type="number" />
                <span asp-validation-for="NSOAP_VEHTYPE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SAACHCODE" class="form-label"></label>
                <input asp-for="SAACHCODE" class="form-control" />
                <span asp-validation-for="SAACHCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NGROUPVEH" class="form-label"></label>
                <input asp-for="NGROUPVEH" class="form-control" type="number" />
                <span asp-validation-for="NGROUPVEH" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
