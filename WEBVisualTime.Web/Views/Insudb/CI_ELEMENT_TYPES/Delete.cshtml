@model WEBVisualTime.Servicios.Insudb.DTOs.CI_ELEMENT_TYPES.CI_ELEMENT_TYPESDto

@{
    ViewData["Title"] = "Eliminar CI_ELEMENT_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SHORT_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SHORT_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EL_TYPE_OF)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.EL_TYPE_OF)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PRODUCT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PRODUCT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RELEASE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RELEASE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PACK_GEN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PACK_GEN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.VIEW_GEN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.VIEW_GEN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SUPERTYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SUPERTYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PARENT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PARENT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ADDED_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ADDED_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EXTENSIBLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.EXTENSIBLE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NAME" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
