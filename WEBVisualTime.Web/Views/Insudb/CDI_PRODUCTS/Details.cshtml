@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_PRODUCTS.CDI_PRODUCTSDto

@{
    ViewData["Title"] = "Detalles de CDI_PRODUCTS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SNAME</dt>
            <dd class="col-sm-9">@Model.SNAME</dd>
            <dt class="col-sm-3">NAME</dt>
            <dd class="col-sm-9">@Model.NAME</dd>
            <dt class="col-sm-3">VERSION</dt>
            <dd class="col-sm-9">@Model.VERSION</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SNAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
