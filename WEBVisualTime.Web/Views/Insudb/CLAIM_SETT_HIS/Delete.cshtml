</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSETTLEMENT_NUM)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSETTLEMENT_NUM)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTRANSAC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTRANSAC)</dd>
