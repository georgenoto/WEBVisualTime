            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NMOVEMENT_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NMOVEMENT_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NNULLCODE)</dt>
