@model WEBVisualTime.Servicios.Insudb.DTOs.CLAIM_CASE.CreateCLAIM_CASEDto

@{
    ViewData["Title"] = "Crear CLAIM_CASE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTACASE" class="form-label"></label>
                <select asp-for="SSTACASE" class="form-select" asp-items="@(ViewData["SSTACASE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SSTACASE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NNOTEDAMA" class="form-label"></label>
                <input asp-for="NNOTEDAMA" class="form-control" type="number" />
