                <input asp-for="NAPV_BENEF_BALANCE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAPV_BENEF_BALANCE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAFP" class="form-label"></label>
                <select asp-for="NAFP" class="form-select" asp-items="@(ViewData["NAFP"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NAFP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSENDTO_LGM" class="form-label"></label>
                <input asp-for="NSENDTO_LGM" class="form-control" type="number" />
                <span asp-validation-for="NSENDTO_LGM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
