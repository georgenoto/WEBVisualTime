            </div>
            <div class="mb-3">
                <label asp-for="NGROWTH_RATEI" class="form-label"></label>
                <input asp-for="NGROWTH_RATEI" class="form-control" type="number" step="any" />
                <span asp-validation-for="NGROWTH_RATEI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NGROWTH_RATEE" class="form-label"></label>
                <input asp-for="NGROWTH_RATEE" class="form-control" type="number" step="any" />
                <span asp-validation-for="NGROWTH_RATEE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAPV_CAPITAL" class="form-label"></label>
                <input asp-for="NAPV_CAPITAL" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAPV_CAPITAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DSUMMON_LIMIT" class="form-label"></label>
                <input asp-for="DSUMMON_LIMIT" class="form-control" type="datetime-local" />
                <span asp-validation-for="DSUMMON_LIMIT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SHAS_SURV_PENSION_BENEFS" class="form-label"></label>
                <input asp-for="SHAS_SURV_PENSION_BENEFS" class="form-control" />
                <span asp-validation-for="SHAS_SURV_PENSION_BENEFS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DSUMMON" class="form-label"></label>
                <input asp-for="DSUMMON" class="form-control" type="datetime-local" />
                <span asp-validation-for="DSUMMON" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SAFP_TRANS_TYPE" class="form-label"></label>
                <input asp-for="SAFP_TRANS_TYPE" class="form-control" />
