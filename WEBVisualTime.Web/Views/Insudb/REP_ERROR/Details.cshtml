@model WEBVisualTime.Servicios.Insudb.DTOs.REP_ERROR.REP_ERRORDto

@{
    ViewData["Title"] = "Detalles de REP_ERROR";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SPROCESS_NAME</dt>
            <dd class="col-sm-9">@Model.SPROCESS_NAME</dd>
            <dt class="col-sm-3">SSQLCODE</dt>
            <dd class="col-sm-9">@Model.SSQLCODE</dd>
            <dt class="col-sm-3">SSQLERRM</dt>
            <dd class="col-sm-9">@Model.SSQLERRM</dd>
            <dt class="col-sm-3">SDESCRIPTION</dt>
            <dd class="col-sm-9">@Model.SDESCRIPTION</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NORDER</dt>
            <dd class="col-sm-9">@Model.NORDER</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SPROCESS_NAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
