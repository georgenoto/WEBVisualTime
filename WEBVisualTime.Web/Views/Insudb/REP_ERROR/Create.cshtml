@model WEBVisualTime.Servicios.Insudb.DTOs.REP_ERROR.CreateREP_ERRORDto

@{
    ViewData["Title"] = "Crear REP_ERROR";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SPROCESS_NAME" class="form-label"></label>
                <input asp-for="SPROCESS_NAME" class="form-control" />
                <span asp-validation-for="SPROCESS_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSQLCODE" class="form-label"></label>
                <input asp-for="SSQLCODE" class="form-control" type="number" />
                <span asp-validation-for="SSQLCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSQLERRM" class="form-label"></label>
                <input asp-for="SSQLERRM" class="form-control" />
                <span asp-validation-for="SSQLERRM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPTION" class="form-label"></label>
                <input asp-for="SDESCRIPTION" class="form-control" />
                <span asp-validation-for="SDESCRIPTION" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NORDER" class="form-label"></label>
                <input asp-for="NORDER" class="form-control" type="number" />
                <span asp-validation-for="NORDER" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
