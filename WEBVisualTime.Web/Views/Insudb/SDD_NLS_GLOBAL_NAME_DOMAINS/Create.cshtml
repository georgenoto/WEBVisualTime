@model WEBVisualTime.Servicios.Insudb.DTOs.SDD_NLS_GLOBAL_NAME_DOMAINS.CreateSDD_NLS_GLOBAL_NAME_DOMAINSDto

@{
    ViewData["Title"] = "Crear SDD_NLS_GLOBAL_NAME_DOMAINS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="IVID" class="form-label"></label>
                <input asp-for="IVID" class="form-control" type="number" />
                <span asp-validation-for="IVID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLS_NAME" class="form-label"></label>
                <input asp-for="NLS_NAME" class="form-control" />
                <span asp-validation-for="NLS_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLS_PLURAL_NAME" class="form-label"></label>
                <input asp-for="NLS_PLURAL_NAME" class="form-control" />
                <span asp-validation-for="NLS_PLURAL_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NLS_LANG" class="form-label"></label>
                <input asp-for="NLS_LANG" class="form-control" />
                <span asp-validation-for="NLS_LANG" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GND_IRID" class="form-label"></label>
                <select asp-for="GND_IRID" class="form-select" asp-items="@(ViewData["GND_IRID"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="GND_IRID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUMBER_OF_TIMES_MODIFIED" class="form-label"></label>
                <input asp-for="NUMBER_OF_TIMES_MODIFIED" class="form-control" type="number" />
                <span asp-validation-for="NUMBER_OF_TIMES_MODIFIED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DATE_CREATED" class="form-label"></label>
                <input asp-for="DATE_CREATED" class="form-control" type="datetime-local" />
                <span asp-validation-for="DATE_CREATED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CREATED_BY" class="form-label"></label>
                <input asp-for="CREATED_BY" class="form-control" />
                <span asp-validation-for="CREATED_BY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DATE_CHANGED" class="form-label"></label>
                <input asp-for="DATE_CHANGED" class="form-control" type="datetime-local" />
                <span asp-validation-for="DATE_CHANGED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="CHANGED_BY" class="form-label"></label>
                <input asp-for="CHANGED_BY" class="form-control" />
                <span asp-validation-for="CHANGED_BY" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
