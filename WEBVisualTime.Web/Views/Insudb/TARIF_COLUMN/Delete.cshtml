@model WEBVisualTime.Servicios.Insudb.DTOs.TARIF_COLUMN.TARIF_COLUMNDto

@{
    ViewData["Title"] = "Eliminar TARIF_COLUMN";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NID_COLUMN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NID_COLUMN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STABLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STABLE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCOLUMN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCOLUMN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SNAME_COL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SNAME_COL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDATA_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDATA_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSIZE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSIZE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDECIMAL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDECIMAL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STABLEFK)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STABLEFK)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NID_COLUMN" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
