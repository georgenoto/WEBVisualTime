@model WEBVisualTime.Servicios.Insudb.DTOs.TARIF_COLUMN.TARIF_COLUMNDto

@{
    ViewData["Title"] = "Detalles de TARIF_COLUMN";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NID_COLUMN</dt>
            <dd class="col-sm-9">@Model.NID_COLUMN</dd>
            <dt class="col-sm-3">STABLE</dt>
            <dd class="col-sm-9">@Model.STABLE</dd>
            <dt class="col-sm-3">SCOLUMN</dt>
            <dd class="col-sm-9">@Model.SCOLUMN</dd>
            <dt class="col-sm-3">SNAME_COL</dt>
            <dd class="col-sm-9">@Model.SNAME_COL</dd>
            <dt class="col-sm-3">NDATA_TYPE</dt>
            <dd class="col-sm-9">@Model.NDATA_TYPE</dd>
            <dt class="col-sm-3">NSIZE</dt>
            <dd class="col-sm-9">@Model.NSIZE</dd>
            <dt class="col-sm-3">NDECIMAL</dt>
            <dd class="col-sm-9">@Model.NDECIMAL</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">STABLEFK</dt>
            <dd class="col-sm-9">@Model.STABLEFK</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NID_COLUMN" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
