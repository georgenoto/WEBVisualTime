@model WEBVisualTime.Servicios.Insudb.DTOs.H_ASSIGNMENT_PART.H_ASSIGNMENT_PARTDto

@{
    ViewData["Title"] = "Detalles de H_ASSIGNMENT_PART";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NID_NUMREG</dt>
            <dd class="col-sm-9">@Model.NID_NUMREG</dd>
            <dt class="col-sm-3">NINSUR_AREA</dt>
            <dd class="col-sm-9">@Model.NINSUR_AREA</dd>
            <dt class="col-sm-3">NINTERTYP</dt>
            <dd class="col-sm-9">@Model.NINTERTYP</dd>
            <dt class="col-sm-3">NTYPE_ASSIGN</dt>
            <dd class="col-sm-9">@Model.NTYPE_ASSIGN</dd>
            <dt class="col-sm-3">DATE_ASSIG_INI</dt>
            <dd class="col-sm-9">@Model.DATE_ASSIG_INI</dd>
            <dt class="col-sm-3">DATE_ASSIG_END</dt>
            <dd class="col-sm-9">@Model.DATE_ASSIG_END</dd>
            <dt class="col-sm-3">NINTERMED</dt>
            <dd class="col-sm-9">@Model.NINTERMED</dd>
            <dt class="col-sm-3">NTEMPASSI</dt>
            <dd class="col-sm-9">@Model.NTEMPASSI</dd>
            <dt class="col-sm-3">STEMPASSI</dt>
            <dd class="col-sm-9">@Model.STEMPASSI</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NID_NUMREG" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
