@model WEBVisualTime.Servicios.Insudb.DTOs.H_ASSIGNMENT_PART.H_ASSIGNMENT_PARTDto

@{
    ViewData["Title"] = "Eliminar H_ASSIGNMENT_PART";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NID_NUMREG)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NID_NUMREG)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINSUR_AREA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINSUR_AREA)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINTERTYP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINTERTYP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPE_ASSIGN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPE_ASSIGN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DATE_ASSIG_INI)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DATE_ASSIG_INI)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DATE_ASSIG_END)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DATE_ASSIG_END)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINTERMED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINTERMED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTEMPASSI)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTEMPASSI)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STEMPASSI)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STEMPASSI)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREGT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREGT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NID_NUMREG" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
