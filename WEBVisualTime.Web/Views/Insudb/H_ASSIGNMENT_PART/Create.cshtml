@model WEBVisualTime.Servicios.Insudb.DTOs.H_ASSIGNMENT_PART.CreateH_ASSIGNMENT_PARTDto

@{
    ViewData["Title"] = "Crear H_ASSIGNMENT_PART";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NINSUR_AREA" class="form-label"></label>
                <input asp-for="NINSUR_AREA" class="form-control" type="number" />
                <span asp-validation-for="NINSUR_AREA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINTERTYP" class="form-label"></label>
                <input asp-for="NINTERTYP" class="form-control" type="number" />
                <span asp-validation-for="NINTERTYP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPE_ASSIGN" class="form-label"></label>
                <input asp-for="NTYPE_ASSIGN" class="form-control" type="number" />
                <span asp-validation-for="NTYPE_ASSIGN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DATE_ASSIG_INI" class="form-label"></label>
                <input asp-for="DATE_ASSIG_INI" class="form-control" type="datetime-local" />
                <span asp-validation-for="DATE_ASSIG_INI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DATE_ASSIG_END" class="form-label"></label>
                <input asp-for="DATE_ASSIG_END" class="form-control" type="datetime-local" />
                <span asp-validation-for="DATE_ASSIG_END" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINTERMED" class="form-label"></label>
                <input asp-for="NINTERMED" class="form-control" type="number" />
                <span asp-validation-for="NINTERMED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTEMPASSI" class="form-label"></label>
                <input asp-for="NTEMPASSI" class="form-control" type="number" />
                <span asp-validation-for="NTEMPASSI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STEMPASSI" class="form-label"></label>
                <input asp-for="STEMPASSI" class="form-control" />
                <span asp-validation-for="STEMPASSI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
