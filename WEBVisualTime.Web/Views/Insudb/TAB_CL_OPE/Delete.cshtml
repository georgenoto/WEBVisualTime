@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_CL_OPE.TAB_CL_OPEDto

@{
    ViewData["Title"] = "Eliminar TAB_CL_OPE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NOPER_TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NOPER_TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NGEN_OPERA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NGEN_OPERA)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIND_REV)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIND_REV)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPAY_IND)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPAY_IND)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NREC_ESP_IN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NREC_ESP_IN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NRECOVER_IN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NRECOVER_IN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NRESERVE_IN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NRESERVE_IN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NOPER_TYPE" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
