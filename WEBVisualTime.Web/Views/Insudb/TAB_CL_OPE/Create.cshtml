@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_CL_OPE.CreateTAB_CL_OPEDto

@{
    ViewData["Title"] = "Crear TAB_CL_OPE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NGEN_OPERA" class="form-label"></label>
                <select asp-for="NGEN_OPERA" class="form-select" asp-items="@(ViewData["NGEN_OPERA"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NGEN_OPERA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NIND_REV" class="form-label"></label>
                <input asp-for="NIND_REV" class="form-control" type="number" />
                <span asp-validation-for="NIND_REV" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPAY_IND" class="form-label"></label>
                <select asp-for="NPAY_IND" class="form-select" asp-items="@(ViewData["NPAY_IND"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NPAY_IND" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NREC_ESP_IN" class="form-label"></label>
                <select asp-for="NREC_ESP_IN" class="form-select" asp-items="@(ViewData["NREC_ESP_IN"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NREC_ESP_IN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRECOVER_IN" class="form-label"></label>
                <select asp-for="NRECOVER_IN" class="form-select" asp-items="@(ViewData["NRECOVER_IN"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NRECOVER_IN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRESERVE_IN" class="form-label"></label>
                <select asp-for="NRESERVE_IN" class="form-select" asp-items="@(ViewData["NRESERVE_IN"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NRESERVE_IN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
