@model WEBVisualTime.Servicios.Insudb.DTOs.T_MASIVECHARGE.CreateT_MASIVECHARGEDto

@{
    ViewData["Title"] = "Crear T_MASIVECHARGE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SFIELD" class="form-label"></label>
                <input asp-for="SFIELD" class="form-control" />
                <span asp-validation-for="SFIELD" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SVALUE" class="form-label"></label>
                <input asp-for="SVALUE" class="form-control" />
                <span asp-validation-for="SVALUE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSEARCH" class="form-label"></label>
                <select asp-for="NSEARCH" class="form-select" asp-items="@(ViewData["NSEARCH"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NSEARCH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STABLE" class="form-label"></label>
                <input asp-for="STABLE" class="form-control" />
                <span asp-validation-for="STABLE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SVALUESLIST" class="form-label"></label>
                <input asp-for="SVALUESLIST" class="form-control" />
                <span asp-validation-for="SVALUESLIST" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
