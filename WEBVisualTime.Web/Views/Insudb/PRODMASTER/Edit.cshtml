@model WEBVisualTime.Servicios.Insudb.DTOs.PRODMASTER.UpdatePRODMASTERDto

@{
    ViewData["Title"] = "Editar PRODMASTER";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSHORT_DES" class="form-label"></label>
                <input asp-for="SSHORT_DES" class="form-control" />
                <span asp-validation-for="SSHORT_DES" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SBRANCHT" class="form-label"></label>
                <select asp-for="SBRANCHT" class="form-select" asp-items="@(ViewData["SBRANCHT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SBRANCHT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SREALIND" class="form-label"></label>
                <input asp-for="SREALIND" class="form-control" />
                <span asp-validation-for="SREALIND" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOMPANY" class="form-label"></label>
                <input asp-for="NCOMPANY" class="form-control" type="number" />
                <span asp-validation-for="NCOMPANY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPREFFIX" class="form-label"></label>
                <input asp-for="SPREFFIX" class="form-control" />
                <span asp-validation-for="SPREFFIX" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
