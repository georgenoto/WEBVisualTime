@model WEBVisualTime.Servicios.Insudb.DTOs.SCHE_TRANSAC.CreateSCHE_TRANSACDto

@{
    ViewData["Title"] = "Crear SCHE_TRANSAC";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <select asp-for="NUSERCODE" class="form-select cascade-select" data-cascade-parent="SSCHE_CODE" data-cascade-url="@Url.Action("GetBySSCHE_CODE", "USERS")" data-current-value="@Model.NUSERCODE">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPAY_FORM" class="form-label"></label>
                <select asp-for="SPAY_FORM" class="form-select" asp-items="@(ViewData["SPAY_FORM"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SPAY_FORM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYPE_AMEND" class="form-label"></label>
                <select asp-for="NTYPE_AMEND" class="form-select" asp-items="@(ViewData["NTYPE_AMEND"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYPE_AMEND" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
