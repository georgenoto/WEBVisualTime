@model WEBVisualTime.Servicios.Insudb.DTOs.PIE_ELEMENT_TYPES.PIE_ELEMENT_TYPESDto

@{
    ViewData["Title"] = "Eliminar PIE_ELEMENT_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DISPLAY_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DISPLAY_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RM_ID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.RM_ID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PLURAL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PLURAL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.GIF_FILE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.GIF_FILE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ROOT_PROCEDURE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ROOT_PROCEDURE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SHORT_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SHORT_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DETAIL_PROCEDURE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DETAIL_PROCEDURE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DISPLAY_SEQUENCE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DISPLAY_SEQUENCE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.SHORT_NAME" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
