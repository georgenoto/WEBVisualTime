@model WEBVisualTime.Servicios.Insudb.DTOs.PIE_ELEMENT_TYPES.UpdatePIE_ELEMENT_TYPESDto

@{
    ViewData["Title"] = "Editar PIE_ELEMENT_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DISPLAY_NAME" class="form-label"></label>
                <input asp-for="DISPLAY_NAME" class="form-control" />
                <span asp-validation-for="DISPLAY_NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAME" class="form-label"></label>
                <input asp-for="NAME" class="form-control" />
                <span asp-validation-for="NAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="RM_ID" class="form-label"></label>
                <input asp-for="RM_ID" class="form-control" type="number" />
                <span asp-validation-for="RM_ID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PLURAL" class="form-label"></label>
                <input asp-for="PLURAL" class="form-control" />
                <span asp-validation-for="PLURAL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="GIF_FILE" class="form-label"></label>
                <input asp-for="GIF_FILE" class="form-control" />
                <span asp-validation-for="GIF_FILE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ROOT_PROCEDURE" class="form-label"></label>
                <input asp-for="ROOT_PROCEDURE" class="form-control" />
                <span asp-validation-for="ROOT_PROCEDURE" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="SHORT_NAME" />
            <div class="mb-3">
                <label asp-for="DETAIL_PROCEDURE" class="form-label"></label>
                <input asp-for="DETAIL_PROCEDURE" class="form-control" />
                <span asp-validation-for="DETAIL_PROCEDURE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DISPLAY_SEQUENCE" class="form-label"></label>
                <input asp-for="DISPLAY_SEQUENCE" class="form-control" type="number" />
                <span asp-validation-for="DISPLAY_SEQUENCE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
