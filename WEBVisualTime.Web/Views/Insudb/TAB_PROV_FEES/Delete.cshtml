@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_PROV_FEES.TAB_PROV_FEESDto

@{
    ViewData["Title"] = "Eliminar TAB_PROV_FEES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPROVIDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPROVIDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NZONE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NZONE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STYPEBENEFIT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STYPEBENEFIT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SBENEFITCLAS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SBENEFITCLAS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEFFECDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEFFECDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DNULLDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DNULLDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDISC_FEE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDISC_FEE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("TAB_PROV_FEES", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
