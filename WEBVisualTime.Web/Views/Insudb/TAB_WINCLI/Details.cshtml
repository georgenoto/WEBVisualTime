@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_WINCLI.TAB_WINCLIDto

@{
    ViewData["Title"] = "Detalles de TAB_WINCLI";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">STYPE_CLIE</dt>
            <dd class="col-sm-9">@Model.STYPE_CLIE</dd>
            <dt class="col-sm-3">STYPE_SEQ</dt>
            <dd class="col-sm-9">@Model.STYPE_SEQ</dd>
            <dt class="col-sm-3">NSEQUENCE</dt>
            <dd class="col-sm-9">@Model.NSEQUENCE</dd>
            <dt class="col-sm-3">WINDOWS</dt>
            <dd class="col-sm-9">@Model.WINDOWSSCODISP</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">SDEFAULTI</dt>
            <dd class="col-sm-9">@Model.SDEFAULTI</dd>
            <dt class="col-sm-3">SREQUIRE</dt>
            <dd class="col-sm-9">@Model.SREQUIRE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.STYPE_CLIE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
