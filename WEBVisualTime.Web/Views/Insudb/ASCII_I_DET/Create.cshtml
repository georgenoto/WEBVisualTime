@model WEBVisualTime.Servicios.Insudb.DTOs.ASCII_I_DET.CreateASCII_I_DETDto

@{
    ViewData["Title"] = "Crear ASCII_I_DET";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SCLIENT" class="form-label"></label>
                <select asp-for="SCLIENT" class="form-select cascade-select" data-cascade-parent="NOFF_DEST_ID" data-cascade-parameter="NOFFICE" data-cascade-url="@Url.Action("GetByNOFFICE", "CLIENT")" data-current-value="@Model.SCLIENT">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SCLIENT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCLIENAME" class="form-label"></label>
                <input asp-for="SCLIENAME" class="form-control" />
                <span asp-validation-for="SCLIENAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NREQUEST_NEW" class="form-label"></label>
                <input asp-for="NREQUEST_NEW" class="form-control" type="number" />
                <span asp-validation-for="NREQUEST_NEW" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAMOUNT" class="form-label"></label>
                <input asp-for="NAMOUNT" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAMOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SBANKACCOUNT" class="form-label"></label>
                <input asp-for="SBANKACCOUNT" class="form-control" />
                <span asp-validation-for="SBANKACCOUNT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NBANKEXT" class="form-label"></label>
                <select asp-for="NBANKEXT" class="form-select" asp-items="@(ViewData["NBANKEXT"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NBANKEXT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NOFF_DEST_ID" class="form-label"></label>
                <select asp-for="NOFF_DEST_ID" class="form-select" asp-items="@(ViewData["NOFF_DEST_ID"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NOFF_DEST_ID" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DDATE_PAY" class="form-label"></label>
                <input asp-for="DDATE_PAY" class="form-control" type="datetime-local" />
                <span asp-validation-for="DDATE_PAY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
