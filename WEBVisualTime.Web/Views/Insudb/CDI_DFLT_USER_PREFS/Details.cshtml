@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_DFLT_USER_PREFS.CDI_DFLT_USER_PREFSDto

@{
    ViewData["Title"] = "Detalles de CDI_DFLT_USER_PREFS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">P_SNAME</dt>
            <dd class="col-sm-9">@Model.P_SNAME</dd>
            <dt class="col-sm-3">P_CGVERSION</dt>
            <dd class="col-sm-9">@Model.P_CGVERSION</dd>
            <dt class="col-sm-3">SNAME</dt>
            <dd class="col-sm-9">@Model.SNAME</dd>
            <dt class="col-sm-3">NAME</dt>
            <dd class="col-sm-9">@Model.NAME</dd>
            <dt class="col-sm-3">VALUE</dt>
            <dd class="col-sm-9">@Model.VALUE</dd>
            <dt class="col-sm-3">INTERNAL</dt>
            <dd class="col-sm-9">@Model.INTERNAL</dd>
            <dt class="col-sm-3">TYPE</dt>
            <dd class="col-sm-9">@Model.TYPE</dd>
            <dt class="col-sm-3">DESCRIPTION</dt>
            <dd class="col-sm-9">@Model.DESCRIPTION</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.P_SNAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
