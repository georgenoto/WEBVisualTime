@model WEBVisualTime.Servicios.Insudb.DTOs.MASSIVE_PART_CONDITIONS.MASSIVE_PART_CONDITIONSDto

@{
    ViewData["Title"] = "Detalles de MASSIVE_PART_CONDITIONS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NIDCONDI</dt>
            <dd class="col-sm-9">@Model.NIDCONDI</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">SENABLED</dt>
            <dd class="col-sm-9">@Model.SENABLED</dd>
            <dt class="col-sm-3">NBRANCH</dt>
            <dd class="col-sm-9">@Model.NBRANCH</dd>
            <dt class="col-sm-3">NPRODUCT</dt>
            <dd class="col-sm-9">@Model.NPRODUCT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">STYP_CONDI</dt>
            <dd class="col-sm-9">@Model.STYP_CONDI</dd>
            <dt class="col-sm-3">NSECTION</dt>
            <dd class="col-sm-9">@Model.NSECTION</dd>
            <dt class="col-sm-3">NSHEET</dt>
            <dd class="col-sm-9">@Model.NSHEET</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NIDCONDI" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
