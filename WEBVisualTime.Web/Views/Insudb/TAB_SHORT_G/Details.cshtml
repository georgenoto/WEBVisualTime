@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_SHORT_G.TAB_SHORT_GDto

@{
    ViewData["Title"] = "Detalles de TAB_SHORT_G";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NMONTHMAX</dt>
            <dd class="col-sm-9">@Model.NMONTHMAX</dd>
            <dt class="col-sm-3">NDAYSMAX</dt>
            <dd class="col-sm-9">@Model.NDAYSMAX</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">DNULLDATE</dt>
            <dd class="col-sm-9">@Model.DNULLDATE</dd>
            <dt class="col-sm-3">NRATEDEVO</dt>
            <dd class="col-sm-9">@Model.NRATEDEVO</dd>
            <dt class="col-sm-3">NRATEPREM</dt>
            <dd class="col-sm-9">@Model.NRATEPREM</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NMONTHMAX" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
