@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_SHORT_G.UpdateTAB_SHORT_GDto

@{
    ViewData["Title"] = "Editar TAB_SHORT_G";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NMONTHMAX" />
            <input type="hidden" asp-for="NDAYSMAX" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRATEDEVO" class="form-label"></label>
                <input asp-for="NRATEDEVO" class="form-control" type="number" step="any" />
                <span asp-validation-for="NRATEDEVO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRATEPREM" class="form-label"></label>
                <input asp-for="NRATEPREM" class="form-control" type="number" step="any" />
                <span asp-validation-for="NRATEPREM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
