@model WEBVisualTime.Servicios.Insudb.DTOs.ADDRESS_CONFIG.ADDRESS_CONFIGDto

@{
    ViewData["Title"] = "Detalles de ADDRESS_CONFIG";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">COUNTRY</dt>
            <dd class="col-sm-9">@Model.COUNTRY</dd>
            <dt class="col-sm-3">ADDRESS_SETTINGS</dt>
            <dd class="col-sm-9">@Model.ADDRESS_SETTINGS</dd>
            <dt class="col-sm-3">PHONE_SETTINGS</dt>
            <dd class="col-sm-9">@Model.PHONE_SETTINGS</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">UPDATEDATE</dt>
            <dd class="col-sm-9">@Model.UPDATEDATE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.COUNTRY" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
