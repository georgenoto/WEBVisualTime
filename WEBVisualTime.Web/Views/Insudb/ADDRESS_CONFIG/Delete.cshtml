@model WEBVisualTime.Servicios.Insudb.DTOs.ADDRESS_CONFIG.ADDRESS_CONFIGDto

@{
    ViewData["Title"] = "Eliminar ADDRESS_CONFIG";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.COUNTRY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.COUNTRY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ADDRESS_SETTINGS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.ADDRESS_SETTINGS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PHONE_SETTINGS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.PHONE_SETTINGS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.UPDATEDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.UPDATEDATE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.COUNTRY" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
