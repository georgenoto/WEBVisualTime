@model WEBVisualTime.Servicios.Insudb.DTOs.NOTIFICA_ERP.NOTIFICA_ERPDto

@{
    ViewData["Title"] = "Detalles de NOTIFICA_ERP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">SPROCESO</dt>
            <dd class="col-sm-9">@Model.SPROCESO</dd>
            <dt class="col-sm-3">SKEY</dt>
            <dd class="col-sm-9">@Model.SKEY</dd>
            <dt class="col-sm-3">SESTADO</dt>
            <dd class="col-sm-9">@Model.SESTADO</dd>
            <dt class="col-sm-3">DFECHA_PROCESO</dt>
            <dd class="col-sm-9">@Model.DFECHA_PROCESO</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">DOPERDATE</dt>
            <dd class="col-sm-9">@Model.DOPERDATE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.SKEY" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
