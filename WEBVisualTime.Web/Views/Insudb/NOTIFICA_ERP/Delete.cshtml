@model WEBVisualTime.Servicios.Insudb.DTOs.NOTIFICA_ERP.NOTIFICA_ERPDto

@{
    ViewData["Title"] = "Eliminar NOTIFICA_ERP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SPROCESO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SPROCESO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SESTADO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SESTADO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DFECHA_PROCESO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DFECHA_PROCESO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DOPERDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DOPERDATE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.SKEY" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
