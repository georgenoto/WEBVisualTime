@model WEBVisualTime.Servicios.Insudb.DTOs.REP_CLEAR_VTIME.REP_CLEAR_VTIMEDto

@{
    ViewData["Title"] = "Detalles de REP_CLEAR_VTIME";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">STABLE</dt>
            <dd class="col-sm-9">@Model.STABLE</dd>
            <dt class="col-sm-3">NCOUNT</dt>
            <dd class="col-sm-9">@Model.NCOUNT</dd>
            <dt class="col-sm-3">NCOUNT_BD</dt>
            <dd class="col-sm-9">@Model.NCOUNT_BD</dd>
            <dt class="col-sm-3">NCOUNT_DEP</dt>
            <dd class="col-sm-9">@Model.NCOUNT_DEP</dd>
            <dt class="col-sm-3">NERASE</dt>
            <dd class="col-sm-9">@Model.NERASE</dd>
            <dt class="col-sm-3">NDROP</dt>
            <dd class="col-sm-9">@Model.NDROP</dd>
            <dt class="col-sm-3">SCOMMENTS</dt>
            <dd class="col-sm-9">@Model.SCOMMENTS</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.STABLE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
