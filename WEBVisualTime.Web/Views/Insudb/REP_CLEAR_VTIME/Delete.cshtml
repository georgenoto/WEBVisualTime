@model WEBVisualTime.Servicios.Insudb.DTOs.REP_CLEAR_VTIME.REP_CLEAR_VTIMEDto

@{
    ViewData["Title"] = "Eliminar REP_CLEAR_VTIME";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.STABLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.STABLE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOUNT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOUNT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOUNT_BD)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOUNT_BD)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCOUNT_DEP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCOUNT_DEP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NERASE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NERASE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDROP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDROP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCOMMENTS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCOMMENTS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.STABLE" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
