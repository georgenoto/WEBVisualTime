@model WEBVisualTime.Servicios.Insudb.DTOs.CHEQ_BOOK.UpdateCHEQ_BOOKDto

@{
    ViewData["Title"] = "Editar CHEQ_BOOK";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NACC_BANK" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="SCHEQUE_END" class="form-label"></label>
                <input asp-for="SCHEQUE_END" class="form-control" />
                <span asp-validation-for="SCHEQUE_END" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCHEQUE_LAS" class="form-label"></label>
                <input asp-for="SCHEQUE_LAS" class="form-control" />
                <span asp-validation-for="SCHEQUE_LAS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCHEQUE_STA" class="form-label"></label>
                <input asp-for="SCHEQUE_STA" class="form-control" />
                <span asp-validation-for="SCHEQUE_STA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NQ_CHE_DAMA" class="form-label"></label>
                <input asp-for="NQ_CHE_DAMA" class="form-control" type="number" />
                <span asp-validation-for="NQ_CHE_DAMA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NQ_CHE_NULL" class="form-label"></label>
                <input asp-for="NQ_CHE_NULL" class="form-control" type="number" />
                <span asp-validation-for="NQ_CHE_NULL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
