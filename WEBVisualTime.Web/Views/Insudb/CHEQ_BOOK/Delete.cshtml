@model WEBVisualTime.Servicios.Insudb.DTOs.CHEQ_BOOK.CHEQ_BOOKDto

@{
    ViewData["Title"] = "Eliminar CHEQ_BOOK";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NACC_BANK)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NACC_BANK)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEFFECDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEFFECDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCHEQUE_END)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCHEQUE_END)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCHEQUE_LAS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCHEQUE_LAS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCHEQUE_STA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCHEQUE_STA)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DNULLDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DNULLDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NQ_CHE_DAMA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NQ_CHE_DAMA)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NQ_CHE_NULL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NQ_CHE_NULL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NACC_BANK" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
