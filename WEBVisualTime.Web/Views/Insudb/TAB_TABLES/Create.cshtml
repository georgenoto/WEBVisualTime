@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_TABLES.CreateTAB_TABLESDto

@{
    ViewData["Title"] = "Crear TAB_TABLES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NCOUNT_ITEM" class="form-label"></label>
                <input asp-for="NCOUNT_ITEM" class="form-control" type="number" />
                <span asp-validation-for="NCOUNT_ITEM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCODE_ITEM" class="form-label"></label>
                <input asp-for="SCODE_ITEM" class="form-control" />
                <span asp-validation-for="SCODE_ITEM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESC_ITEM" class="form-label"></label>
                <input asp-for="SDESC_ITEM" class="form-control" />
                <span asp-validation-for="SDESC_ITEM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCOUNT_TABL" class="form-label"></label>
                <input asp-for="NCOUNT_TABL" class="form-control" type="number" />
                <span asp-validation-for="NCOUNT_TABL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDS_SELECT" class="form-label"></label>
                <input asp-for="SDS_SELECT" class="form-control" />
                <span asp-validation-for="SDS_SELECT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SQ_VALUE" class="form-label"></label>
                <input asp-for="SQ_VALUE" class="form-control" />
                <span asp-validation-for="SQ_VALUE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSHOWNUM" class="form-label"></label>
                <input asp-for="SSHOWNUM" class="form-control" />
                <span asp-validation-for="SSHOWNUM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SINITQUERY" class="form-label"></label>
                <input asp-for="SINITQUERY" class="form-control" />
                <span asp-validation-for="SINITQUERY" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SINDSP" class="form-label"></label>
                <input asp-for="SINDSP" class="form-control" />
                <span asp-validation-for="SINDSP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SKEY" class="form-label"></label>
                <input asp-for="SKEY" class="form-control" />
                <span asp-validation-for="SKEY" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
