@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_TABLES.TAB_TABLESDto

@{
    ViewData["Title"] = "Detalles de TAB_TABLES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">STAB_CODE</dt>
            <dd class="col-sm-9">@Model.STAB_CODE</dd>
            <dt class="col-sm-3">NCOUNT_ITEM</dt>
            <dd class="col-sm-9">@Model.NCOUNT_ITEM</dd>
            <dt class="col-sm-3">SCODE_ITEM</dt>
            <dd class="col-sm-9">@Model.SCODE_ITEM</dd>
            <dt class="col-sm-3">SDESC_ITEM</dt>
            <dd class="col-sm-9">@Model.SDESC_ITEM</dd>
            <dt class="col-sm-3">NCOUNT_TABL</dt>
            <dd class="col-sm-9">@Model.NCOUNT_TABL</dd>
            <dt class="col-sm-3">SDESCRIPT</dt>
            <dd class="col-sm-9">@Model.SDESCRIPT</dd>
            <dt class="col-sm-3">SDS_SELECT</dt>
            <dd class="col-sm-9">@Model.SDS_SELECT</dd>
            <dt class="col-sm-3">SQ_VALUE</dt>
            <dd class="col-sm-9">@Model.SQ_VALUE</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
            <dt class="col-sm-3">SSHOWNUM</dt>
            <dd class="col-sm-9">@Model.SSHOWNUM</dd>
            <dt class="col-sm-3">SINITQUERY</dt>
            <dd class="col-sm-9">@Model.SINITQUERY</dd>
            <dt class="col-sm-3">SINDSP</dt>
            <dd class="col-sm-9">@Model.SINDSP</dd>
            <dt class="col-sm-3">SKEY</dt>
            <dd class="col-sm-9">@Model.SKEY</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.STAB_CODE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
