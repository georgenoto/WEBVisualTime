@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_PRODUCT_FLAVOURS.CreateCDI_PRODUCT_FLAVOURSDto

@{
    ViewData["Title"] = "Crear CDI_PRODUCT_FLAVOURS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="P_SNAME" class="form-label"></label>
                <input asp-for="P_SNAME" class="form-control" />
                <span asp-validation-for="P_SNAME" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="P_CGVERSION" class="form-label"></label>
                <input asp-for="P_CGVERSION" class="form-control" />
                <span asp-validation-for="P_CGVERSION" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SEQ" class="form-label"></label>
                <input asp-for="SEQ" class="form-control" type="number" />
                <span asp-validation-for="SEQ" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DESCRIPTION" class="form-label"></label>
                <input asp-for="DESCRIPTION" class="form-control" />
                <span asp-validation-for="DESCRIPTION" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
