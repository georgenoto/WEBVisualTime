@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_MATRIX_RH.TAB_MATRIX_RHDto

@{
    ViewData["Title"] = "Eliminar TAB_MATRIX_RH";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPE_MOVE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPE_MOVE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NORIGIN)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NORIGIN)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYP_PROFITWORKER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYP_PROFITWORKER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTRANSAC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTRANSAC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NTYPE_MOVE" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
