@model WEBVisualTime.Servicios.Insudb.DTOs.QC_PARAM.QC_PARAMDto

@{
    ViewData["Title"] = "Eliminar QC_PARAM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBRANCH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBRANCH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NPRODUCT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NPRODUCT)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SPOLITYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SPOLITYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCURRENCY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCURRENCY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEFFECDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEFFECDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SINDQCOBL)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SINDQCOBL)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NROUTY_QC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NROUTY_QC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SROUT_QC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SROUT_QC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NROUTY_QCCAP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NROUTY_QCCAP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SROUT_QCCAP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SROUT_QCCAP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NMINAGEQC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NMINAGEQC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NCAPMINCC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NCAPMINCC)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DNULLDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DNULLDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SSTATREG)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SSTATREG)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NBRANCH" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
