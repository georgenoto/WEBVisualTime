@model WEBVisualTime.Servicios.Insudb.DTOs.QC_PARAM.UpdateQC_PARAMDto

@{
    ViewData["Title"] = "Editar QC_PARAM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="SPOLITYPE" />
            <input type="hidden" asp-for="NCURRENCY" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="SINDQCOBL" class="form-label"></label>
                <input asp-for="SINDQCOBL" class="form-control" />
                <span asp-validation-for="SINDQCOBL" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NROUTY_QC" class="form-label"></label>
                <select asp-for="NROUTY_QC" class="form-select" asp-items="@(ViewData["NROUTY_QC"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NROUTY_QC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SROUT_QC" class="form-label"></label>
                <select asp-for="SROUT_QC" class="form-select cascade-select" data-cascade-parent="NROUTY_QC" data-cascade-parameter="NROUTINETYPE" data-cascade-url="@Url.Action("GetByNROUTINETYPE", "TAB_ROUTINE")" data-current-value="@Model.SROUT_QC">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SROUT_QC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NROUTY_QCCAP" class="form-label"></label>
                <select asp-for="NROUTY_QCCAP" class="form-select" asp-items="@(ViewData["NROUTY_QCCAP"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NROUTY_QCCAP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SROUT_QCCAP" class="form-label"></label>
                <select asp-for="SROUT_QCCAP" class="form-select cascade-select" data-cascade-parent="NROUTY_QC" data-cascade-parameter="NROUTINETYPE" data-cascade-url="@Url.Action("GetByNROUTINETYPE", "TAB_ROUTINE")" data-current-value="@Model.SROUT_QCCAP">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="SROUT_QCCAP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMINAGEQC" class="form-label"></label>
                <input asp-for="NMINAGEQC" class="form-control" type="number" />
                <span asp-validation-for="NMINAGEQC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NCAPMINCC" class="form-label"></label>
                <input asp-for="NCAPMINCC" class="form-control" type="number" step="any" />
                <span asp-validation-for="NCAPMINCC" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREG" class="form-label"></label>
                <input asp-for="SSTATREG" class="form-control" />
                <span asp-validation-for="SSTATREG" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <select asp-for="NUSERCODE" class="form-select" asp-items="@(ViewData["NUSERCODE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
