@model WEBVisualTime.Servicios.Insudb.DTOs.PAY_ORD_CONCEPTS.PAY_ORD_CONCEPTSDto

@{
    ViewData["Title"] = "Detalles de PAY_ORD_CONCEPTS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NCOMPANY</dt>
            <dd class="col-sm-9">@Model.NCOMPANY</dd>
            <dt class="col-sm-3">TABLE293</dt>
            <dd class="col-sm-9">@Model.TABLE293SDESCRIPT</dd>
            <dt class="col-sm-3">SSTATREGT</dt>
            <dd class="col-sm-9">@Model.SSTATREGT</dd>
            <dt class="col-sm-3">DCOMPDATE</dt>
            <dd class="col-sm-9">@Model.DCOMPDATE</dd>
            <dt class="col-sm-3">NUSERCODE</dt>
            <dd class="col-sm-9">@Model.NUSERCODE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NCOMPANY" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
