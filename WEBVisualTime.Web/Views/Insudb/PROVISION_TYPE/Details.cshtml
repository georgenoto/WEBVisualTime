}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">NIDPROVISIONTYPE</dt>
            <dd class="col-sm-9">@Model.NIDPROVISIONTYPE</dd>
            <dt class="col-sm-3">SNAME</dt>
            <dd class="col-sm-9">@Model.SNAME</dd>
            <dt class="col-sm-3">SENABLE</dt>
            <dd class="col-sm-9">@Model.SENABLE</dd>
            <dt class="col-sm-3">SMANEJAUF</dt>
            <dd class="col-sm-9">@Model.SMANEJAUF</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NIDPROVISIONTYPE" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
