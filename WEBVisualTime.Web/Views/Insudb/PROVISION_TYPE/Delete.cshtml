@model WEBVisualTime.Servicios.Insudb.DTOs.PROVISION_TYPE.PROVISION_TYPEDto

@{
    ViewData["Title"] = "Eliminar PROVISION_TYPE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIDPROVISIONTYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIDPROVISIONTYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SNAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SNAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SENABLE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SENABLE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SMANEJAUF)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SMANEJAUF)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NIDPROVISIONTYPE" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
