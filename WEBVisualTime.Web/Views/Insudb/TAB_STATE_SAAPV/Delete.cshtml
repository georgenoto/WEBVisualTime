@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_STATE_SAAPV.TAB_STATE_SAAPVDto

@{
    ViewData["Title"] = "Eliminar TAB_STATE_SAAPV";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPE_SAAPV)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPE_SAAPV)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPE_STATE_ORIGI)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPE_STATE_ORIGI)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NTYPE_STATE_END)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NTYPE_STATE_END)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("TAB_STATE_SAAPV", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
