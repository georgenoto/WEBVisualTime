            <dd class="col-sm-9">@Model.INTERMEDIASCOL_AGREE</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
            <dd class="col-sm-9">@Model.DEFFECDATE</dd>
            <dt class="col-sm-3">TABLE163</dt>
