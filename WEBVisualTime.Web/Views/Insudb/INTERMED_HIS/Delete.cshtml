@model WEBVisualTime.Servicios.Insudb.DTOs.INTERMED_HIS.INTERMED_HISDto

@{
    ViewData["Title"] = "Eliminar INTERMED_HIS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINTERMED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINTERMED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DEFFECDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DEFFECDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NNULLCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NNULLCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINTERTYP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINTERTYP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NOFFICE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NOFFICE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSUPERVIS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSUPERVIS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NINT_STATUS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NINT_STATUS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NRECEPTYP)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NRECEPTYP)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDESCRIPT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDESCRIPT)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("INTERMED_HIS", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
