@model WEBVisualTime.Servicios.Insudb.DTOs.INTERMED_HIS.CreateINTERMED_HISDto

@{
    ViewData["Title"] = "Crear INTERMED_HIS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="NNULLCODE" class="form-label"></label>
                <select asp-for="NNULLCODE" class="form-select" asp-items="@(ViewData["NNULLCODE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NNULLCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINTERTYP" class="form-label"></label>
                <select asp-for="NINTERTYP" class="form-select" asp-items="@(ViewData["NINTERTYP"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NINTERTYP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NOFFICE" class="form-label"></label>
                <select asp-for="NOFFICE" class="form-select" asp-items="@(ViewData["NOFFICE"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NOFFICE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NSUPERVIS" class="form-label"></label>
                <input asp-for="NSUPERVIS" class="form-control" type="number" />
                <span asp-validation-for="NSUPERVIS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NINT_STATUS" class="form-label"></label>
                <select asp-for="NINT_STATUS" class="form-select" asp-items="@(ViewData["NINT_STATUS"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NINT_STATUS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRECEPTYP" class="form-label"></label>
                <input asp-for="NRECEPTYP" class="form-control" type="number" />
                <span asp-validation-for="NRECEPTYP" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
