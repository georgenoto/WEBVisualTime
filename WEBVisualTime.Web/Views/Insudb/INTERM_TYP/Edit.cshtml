@model WEBVisualTime.Servicios.Insudb.DTOs.INTERM_TYP.UpdateINTERM_TYPDto

@{
    ViewData["Title"] = "Editar INTERM_TYP";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NINTERTYP" />
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SDESCRIPT" class="form-label"></label>
                <input asp-for="SDESCRIPT" class="form-control" />
                <span asp-validation-for="SDESCRIPT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SPARTICIN" class="form-label"></label>
                <input asp-for="SPARTICIN" class="form-control" />
                <span asp-validation-for="SPARTICIN" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSHORT_DES" class="form-label"></label>
                <input asp-for="SSHORT_DES" class="form-control" />
                <span asp-validation-for="SSHORT_DES" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSTATREGT" class="form-label"></label>
                <input asp-for="SSTATREGT" class="form-control" />
                <span asp-validation-for="SSTATREGT" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NTYP_ACCO" class="form-label"></label>
                <select asp-for="NTYP_ACCO" class="form-select" asp-items="@(ViewData["NTYP_ACCO"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NTYP_ACCO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SIND_FECU" class="form-label"></label>
                <input asp-for="SIND_FECU" class="form-control" />
                <span asp-validation-for="SIND_FECU" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SGEN_CERTIF" class="form-label"></label>
                <input asp-for="SGEN_CERTIF" class="form-control" />
                <span asp-validation-for="SGEN_CERTIF" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRECEPTYP" class="form-label"></label>
                <select asp-for="NRECEPTYP" class="form-select" asp-items="@(ViewData["NRECEPTYP"] as SelectList)">
                    <option value="">-- Seleccione --</option>
                </select>
                <span asp-validation-for="NRECEPTYP" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
