            <dt class="col-sm-3">NRECEPTYP</dt>
            <dd class="col-sm-9">@Model.NRECEPTYP</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.NINTERTYP" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
