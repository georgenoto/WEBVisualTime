            </div>
            <div class="mb-3">
                <label asp-for="SROURESER" class="form-label"></label>
                <input asp-for="SROURESER" class="form-control" />
                <span asp-validation-for="SROURESER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NPERCRESER" class="form-label"></label>
                <input asp-for="NPERCRESER" class="form-control" type="number" step="any" />
                <span asp-validation-for="NPERCRESER" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NRESEAMO" class="form-label"></label>
                <input asp-for="NRESEAMO" class="form-control" type="number" step="any" />
                <span asp-validation-for="NRESEAMO" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NMAXPERCENT" class="form-label"></label>
                <input asp-for="NMAXPERCENT" class="form-control" type="number" step="any" />
