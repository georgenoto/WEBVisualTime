}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" name="id" value="@ViewData["RecordId"]" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="NMODULEC" />
            <input type="hidden" asp-for="NCOVER" />
            <input type="hidden" asp-for="NTYPE_RESERVE" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
