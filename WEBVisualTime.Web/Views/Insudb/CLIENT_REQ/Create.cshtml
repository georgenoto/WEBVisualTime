@model WEBVisualTime.Servicios.Insudb.DTOs.CLIENT_REQ.CreateCLIENT_REQDto

@{
    ViewData["Title"] = "Crear CLIENT_REQ";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="SBIRTHDAI" class="form-label"></label>
                <input asp-for="SBIRTHDAI" class="form-control" />
                <span asp-validation-for="SBIRTHDAI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCIVISTAI" class="form-label"></label>
                <input asp-for="SCIVISTAI" class="form-control" />
                <span asp-validation-for="SCIVISTAI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SREQUIRED" class="form-label"></label>
                <input asp-for="SREQUIRED" class="form-control" />
                <span asp-validation-for="SREQUIRED" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SOCCUPATI" class="form-label"></label>
                <input asp-for="SOCCUPATI" class="form-control" />
                <span asp-validation-for="SOCCUPATI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SSEXINSUI" class="form-label"></label>
                <input asp-for="SSEXINSUI" class="form-control" />
                <span asp-validation-for="SSEXINSUI" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="STAX_SITUA" class="form-label"></label>
                <input asp-for="STAX_SITUA" class="form-control" />
                <span asp-validation-for="STAX_SITUA" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SADDRESS" class="form-label"></label>
                <input asp-for="SADDRESS" class="form-control" />
                <span asp-validation-for="SADDRESS" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="SCREDITLINE" class="form-label"></label>
                <input asp-for="SCREDITLINE" class="form-control" />
                <span asp-validation-for="SCREDITLINE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
