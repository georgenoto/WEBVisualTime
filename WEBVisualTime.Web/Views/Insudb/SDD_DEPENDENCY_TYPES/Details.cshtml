@model WEBVisualTime.Servicios.Insudb.DTOs.SDD_DEPENDENCY_TYPES.SDD_DEPENDENCY_TYPESDto

@{
    ViewData["Title"] = "Detalles de SDD_DEPENDENCY_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">IRID</dt>
            <dd class="col-sm-9">@Model.IRID</dd>
            <dt class="col-sm-3">IVID</dt>
            <dd class="col-sm-9">@Model.IVID</dd>
            <dt class="col-sm-3">TYPE</dt>
            <dd class="col-sm-9">@Model.TYPE</dd>
            <dt class="col-sm-3">SYSTEM_FLAG</dt>
            <dd class="col-sm-9">@Model.SYSTEM_FLAG</dd>
            <dt class="col-sm-3">TRANSITIVE</dt>
            <dd class="col-sm-9">@Model.TRANSITIVE</dd>
            <dt class="col-sm-3">NUMBER_OF_TIMES_MODIFIED</dt>
            <dd class="col-sm-9">@Model.NUMBER_OF_TIMES_MODIFIED</dd>
            <dt class="col-sm-3">DATE_CREATED</dt>
            <dd class="col-sm-9">@Model.DATE_CREATED</dd>
            <dt class="col-sm-3">CREATED_BY</dt>
            <dd class="col-sm-9">@Model.CREATED_BY</dd>
            <dt class="col-sm-3">DATE_CHANGED</dt>
            <dd class="col-sm-9">@Model.DATE_CHANGED</dd>
            <dt class="col-sm-3">CHANGED_BY</dt>
            <dd class="col-sm-9">@Model.CHANGED_BY</dd>
            <dt class="col-sm-3">SUBTYPE</dt>
            <dd class="col-sm-9">@Model.SUBTYPE</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.IRID" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
