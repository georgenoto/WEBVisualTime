@model WEBVisualTime.Servicios.Insudb.DTOs.SDD_DEPENDENCY_TYPES.SDD_DEPENDENCY_TYPESDto

@{
    ViewData["Title"] = "Eliminar SDD_DEPENDENCY_TYPES";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IRID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IRID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IVID)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.IVID)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.TYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SYSTEM_FLAG)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SYSTEM_FLAG)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.TRANSITIVE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.TRANSITIVE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUMBER_OF_TIMES_MODIFIED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUMBER_OF_TIMES_MODIFIED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DATE_CREATED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DATE_CREATED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CREATED_BY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CREATED_BY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DATE_CHANGED)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DATE_CHANGED)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CHANGED_BY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CHANGED_BY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SUBTYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SUBTYPE)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.IRID" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
