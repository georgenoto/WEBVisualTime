@model WEBVisualTime.Servicios.Insudb.DTOs.TAR_HEALT_PREM.UpdateTAR_HEALT_PREMDto

@{
    ViewData["Title"] = "Editar TAR_HEALT_PREM";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="NBRANCH" />
            <input type="hidden" asp-for="NPRODUCT" />
            <input type="hidden" asp-for="DEFFECDATE" />
            <input type="hidden" asp-for="NROLE" />
            <input type="hidden" asp-for="NMODULEC" />
            <input type="hidden" asp-for="NCOVER" />
            <input type="hidden" asp-for="NGEOGRAPHAREA" />
            <input type="hidden" asp-for="NATTENSYSTEM" />
            <input type="hidden" asp-for="NOFFICE" />
            <input type="hidden" asp-for="NCAPITAL_INIT" />
            <input type="hidden" asp-for="NCAPITAL_END" />
            <input type="hidden" asp-for="NPOLICY_YEAR_INIT" />
            <input type="hidden" asp-for="NPOLICY_YEAR_END" />
            <input type="hidden" asp-for="NCURRENCY" />
            <input type="hidden" asp-for="NAGE_INIT" />
            <input type="hidden" asp-for="NAGE_END" />
            <div class="mb-3">
                <label asp-for="NAMOUNTF" class="form-label"></label>
                <input asp-for="NAMOUNTF" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAMOUNTF" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NAMOUNTM" class="form-label"></label>
                <input asp-for="NAMOUNTM" class="form-control" type="number" step="any" />
                <span asp-validation-for="NAMOUNTM" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DNULLDATE" class="form-label"></label>
                <input asp-for="DNULLDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DNULLDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCOMPDATE" class="form-label"></label>
                <input asp-for="DCOMPDATE" class="form-control" type="datetime-local" />
                <span asp-validation-for="DCOMPDATE" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NUSERCODE" class="form-label"></label>
                <input asp-for="NUSERCODE" class="form-control" type="number" />
                <span asp-validation-for="NUSERCODE" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>initCascadeSelects();</script>
}
