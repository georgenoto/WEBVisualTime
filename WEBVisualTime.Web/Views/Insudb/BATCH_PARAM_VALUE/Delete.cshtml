@model WEBVisualTime.Servicios.Insudb.DTOs.BATCH_PARAM_VALUE.BATCH_PARAM_VALUEDto

@{
    ViewData["Title"] = "Eliminar BATCH_PARAM_VALUE";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NAREA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NAREA)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NSEQ)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NSEQ)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NBATCH)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NBATCH)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SVALUE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SVALUE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NDATATYPE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NDATATYPE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SDESCRIPT)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SDESCRIPT)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@(WEBVisualTime.Entidades.Common.RecordKeys.Encode("BATCH_PARAM_VALUE", Model))" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
