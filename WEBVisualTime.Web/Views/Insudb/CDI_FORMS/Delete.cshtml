@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_FORMS.CDI_FORMSDto

@{
    ViewData["Title"] = "Eliminar CDI_FORMS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FRM_FNAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FRM_FNAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FRM_SEQ)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FRM_SEQ)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FRM_DISP_NAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FRM_DISP_NAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FRM_DESC)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FRM_DESC)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.FRM_FNAME" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
