@model WEBVisualTime.Servicios.Insudb.DTOs.CDI_FORMS.CDI_FORMSDto

@{
    ViewData["Title"] = "Detalles de CDI_FORMS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">FRM_FNAME</dt>
            <dd class="col-sm-9">@Model.FRM_FNAME</dd>
            <dt class="col-sm-3">FRM_SEQ</dt>
            <dd class="col-sm-9">@Model.FRM_SEQ</dd>
            <dt class="col-sm-3">FRM_DISP_NAME</dt>
            <dd class="col-sm-9">@Model.FRM_DISP_NAME</dd>
            <dt class="col-sm-3">FRM_DESC</dt>
            <dd class="col-sm-9">@Model.FRM_DESC</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.FRM_FNAME" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
