            <dd class="col-sm-9">@Model.NCODE</dd>
            <dt class="col-sm-3">TABLE5602</dt>
            <dd class="col-sm-9">@Model.TABLE5602SDESCRIPT</dd>
            <dt class="col-sm-3">TABLE5570</dt>
            <dd class="col-sm-9">@Model.TABLE5570SDESCRIPT</dd>
            <dt class="col-sm-3">DEFFECDATE</dt>
