@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_AUXILIAR.TAB_AUXILIARDto

@{
    ViewData["Title"] = "Detalles de TAB_AUXILIAR";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">CARACTER</dt>
            <dd class="col-sm-9">@Model.CARACTER</dd>
            <dt class="col-sm-3">NUMERO</dt>
            <dd class="col-sm-9">@Model.NUMERO</dd>
            <dt class="col-sm-3">FECHA</dt>
            <dd class="col-sm-9">@Model.FECHA</dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.CARACTER" class="btn btn-warning"><i class="bi bi-pencil"></i> Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
