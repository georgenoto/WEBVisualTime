@model WEBVisualTime.Servicios.Insudb.DTOs.TAB_AUXILIAR.TAB_AUXILIARDto

@{
    ViewData["Title"] = "Eliminar TAB_AUXILIAR";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CARACTER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.CARACTER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUMERO)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUMERO)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FECHA)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.FECHA)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.CARACTER" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
