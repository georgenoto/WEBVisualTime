@model WEBVisualTime.Servicios.Insudb.DTOs.FOLDERS.FOLDERSDto

@{
    ViewData["Title"] = "Eliminar FOLDERS";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="alert alert-danger">
    <i class="bi bi-exclamation-triangle"></i> ¿Está seguro de que desea eliminar este registro?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NFOLDER)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NFOLDER)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SFOLDERNAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SFOLDERNAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SROOTNAME)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SROOTNAME)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NIMAGE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NIMAGE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DCOMPDATE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DCOMPDATE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NUSERCODE)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NUSERCODE)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SCLASS)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SCLASS)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SFOLDERKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SFOLDERKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.NFOLDERKEY)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.NFOLDERKEY)</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SORIGI)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.SORIGI)</dd>
        </dl>
    </div>
</div>
<div class="mt-3 d-flex gap-2">
    <form asp-action="Delete" method="post">
        <input type="hidden" name="id" value="@Model.NFOLDER" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
    </form>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
