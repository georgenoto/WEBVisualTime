@using WEBVisualTime.Web.Models
@model object
@{
    var crud = (CrudDefinition)ViewData["Crud"]!;
    var editing = string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Edit", StringComparison.OrdinalIgnoreCase);
    ViewData["Title"] = (editing ? "Editar " : "Crear ") + crud.Name;
}
<h1 class="mb-4">@ViewData["Title"]</h1>
<div class="card"><div class="card-body">
    <form asp-action="@(editing ? "Edit" : "Create")" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        @await Html.PartialAsync("~/Views/Shared/Catalog/_Fields.cshtml", Model)
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div></div>
@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
