@using WEBVisualTime.Web.Models
@model System.Collections.IEnumerable
@{
    var crud = (CrudDefinition)ViewData["Crud"]!;
    var rows = Model.Cast<object>().ToList();
    ViewData["Title"] = crud.Name;
}
<h1 class="mb-4">@crud.Name</h1>
@if (crud.ReadOnlyReason is null)
{
    <p><a asp-action="Create" class="btn btn-primary">Crear Nuevo</a></p>
}
else
{
    <div class="alert alert-warning" role="alert">@crud.ReadOnlyReason</div>
}
<div class="data-table-wrapper" data-page-size="20">
    <div class="d-flex justify-content-between mb-2">
        <select class="form-select w-auto page-size-select" aria-label="Registros por página">
            <option>10</option><option selected>20</option><option>50</option><option>100</option>
        </select>
        <span class="data-table-info"></span>
        <input class="form-control w-auto data-table-search" placeholder="Buscar en tabla..." aria-label="Buscar" />
    </div>
    <div class="table-responsive"><table class="table table-striped table-hover data-table">
        <thead><tr>@foreach (var column in crud.Columns) { <th>@column</th> }<th class="@(crud.ReadOnlyReason is null ? "" : "d-none")">Acciones</th></tr></thead>
        <tbody>
        @foreach (var row in rows)
        {
            <tr>
                @foreach (var column in crud.Columns) { <td>@crud.Value(row, column)</td> }
                @if (crud.ReadOnlyReason is null)
                {
                <td class="text-nowrap">
                    <a asp-action="Edit" asp-route-id="@crud.Value(row, crud.Key)" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@crud.Value(row, crud.Key)" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@crud.Value(row, crud.Key)" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
                }
                else
                {
                    @* Keep the action-column slot expected by the shared browser search. *@
                    <td class="d-none" aria-hidden="true"></td>
                }
            </tr>
        }
        @if (rows.Count == 0)
        {
            <tr><td colspan="@(crud.Columns.Length + 1)" class="text-center">No hay registros disponibles.</td></tr>
        }
        </tbody>
    </table></div>
    <nav aria-label="Paginación"><ul class="pagination data-table-pagination"></ul></nav>
</div>
@section Scripts { <script>initDataTables();</script> }
