@using WEBVisualTime.Web.Models
@model object
@{
    var crud = (CrudDefinition)ViewData["Crud"]!;
    ViewData["Title"] = "Detalles " + crud.Name;
}
<h1>@ViewData["Title"]</h1>
<dl class="row">
    @foreach (var column in crud.Columns)
    {
        <dt class="col-sm-3">@column</dt><dd class="col-sm-9">@crud.Value(Model, column)</dd>
    }
</dl>
<a asp-action="Edit" asp-route-id="@crud.Value(Model, crud.Key)" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
